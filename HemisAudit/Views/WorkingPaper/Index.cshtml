                <tr><td style="text-align:center">11</td><td>dbo_CRED</td><td>Course Credit data from the VALPAC system.</td><td></td></tr>
                <tr><td style="text-align:center">12</td><td>dbo_STUD</td><td>Student data from the VALPAC system.</td><td></td></tr>
                <tr><td style="text-align:center">13</td><td>dbo_CREG</td><td>Course Registration data from the VALPAC system.</td><td></td></tr>

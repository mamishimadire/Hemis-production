@{
    ViewData["Title"] = "Working Paper";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var downloadUrl = Url.Action("Download", "WorkingPaper") ?? "/WorkingPaper/Download";
}

@section Styles {
<style>
.wp-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 0 48px 0;
}

.wp-topbar {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-bottom: 24px;
}

.wp-title-block h1 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text, #111);
    margin: 0 0 4px 0;
}

.wp-note {
    background: #f0eaf8;
    border-left: 4px solid #5C2D91;
    border-radius: 4px;
    padding: 10px 16px;
    font-size: .84rem;
    color: #3b1a6e;
    margin-bottom: 20px;
}

.wp-dl-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: #5C2D91;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: .875rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
}

.wp-dl-btn:hover {
    background: #4a2278;
}

.wp-section {
    margin-bottom: 28px;
}

.wp-section-head {
    background: #5C2D91;
    color: #fff;
    font-weight: 700;
    font-size: .9rem;
    padding: 7px 14px;
    border-radius: 4px 4px 0 0;
}

.wp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .84rem;
    border: 1px solid #ddd;
    border-top: none;
}

.wp-table th {
    background: #f0eaf8;
    font-weight: 600;
    padding: 7px 12px;
    text-align: left;
    border-bottom: 2px solid #5C2D91;
    border-right: 1px solid #e0d4f0;
    white-space: nowrap;
}

.wp-table td {
    padding: 7px 12px;
    border-bottom: 1px solid #eee;
    border-right: 1px solid #eee;
    vertical-align: top;
}

.wp-table tr:nth-child(even) td {
    background: #fafafa;
}

.wp-table tr:hover td {
    background: #f5f0fc;
}

.wp-kv-table td:first-child {
    font-weight: 600;
    width: 200px;
    color: #444;
}

.wp-kv-table td:last-child {
    color: #555;
}

.rule-num {
    font-weight: 700;
    color: #5C2D91;
    text-align: center;
    width: 40px;
}

.rule-cat {
    font-style: italic;
    color: #666;
    white-space: nowrap;
    width: 160px;
}

.rule-note {
    color: #1a6e35;
    font-weight: 600;
}

.rule-note.fatal {
    color: #b91c1c;
}

.rule-script a {
    color: #5C2D91;
    text-decoration: none;
    font-size: .8rem;
}

.rule-text {
    white-space: pre-line;
    font-size: .82rem;
    line-height: 1.55;
}

.step-num {
    font-weight: 700;
    color: #5C2D91;
    text-align: right;
    width: 36px;
    padding-right: 8px;
}

.steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid #ddd;
    border-top: none;
}

.steps-list li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 7px 14px;
    border-bottom: 1px solid #eee;
    font-size: .84rem;
}

.steps-list li:nth-child(even) {
    background: #fafafa;
}

.steps-list li:hover {
    background: #f5f0fc;
}

.steps-list .step-body {
    flex: 1;
    color: #333;
}

.steps-list .step-body strong {
    color: #5C2D91;
}

@@media (prefers-color-scheme: dark) {
    .wp-note { background: #2a1a4a; border-color: #9b5cf6; color: #d4b8ff; }
    .wp-section-head { background: #4a1f7a; }
    .wp-table th { background: #2a1a4a; border-bottom-color: #9b5cf6; border-right-color: #3a2060; }
    .wp-table td { border-bottom-color: #2a2a2a; border-right-color: #2a2a2a; }
    .wp-table tr:nth-child(even) td { background: #1e1e2e; }
    .wp-table tr:hover td { background: #2a1a4a; }
    .wp-kv-table td:first-child { color: #ccc; }
    .wp-kv-table td:last-child { color: #bbb; }
    .wp-dl-btn { background: #7c3aed; }
    .wp-dl-btn:hover { background: #6d28d9; }
    .steps-list { border-color: #2a2a2a; }
    .steps-list li { border-bottom-color: #2a2a2a; }
    .steps-list li:nth-child(even) { background: #1e1e2e; }
    .steps-list li:hover { background: #2a1a4a; }
}

:root[data-theme="dark"] .wp-note { background: #2a1a4a; border-color: #9b5cf6; color: #d4b8ff; }
:root[data-theme="light"] .wp-note { background: #f0eaf8; border-color: #5C2D91; color: #3b1a6e; }
</style>
}

<div class="wp-page">

    <div class="wp-topbar">
        <div class="wp-title-block">
            <h1>TUT HEMIS Working Paper</h1>
            <div style="font-size:.82rem;color:#888;">HEMIS audit guide — staff and student data analysis</div>
        </div>
        <a href="@downloadUrl" class="wp-dl-btn" data-track-download data-download-label="Downloading Working Paper" data-download-name="TUT_HEMIS_Working_Paper.xlsx">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3v13M7 12l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4 19h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Download Excel
        </a>
    </div>

    <div class="wp-note">
        Note that use this WP as a guide as it it can be amended at anytime &mdash; this was developed as a guide only.
    </div>


@using HemisAudit.Models
@{
    ViewData["Title"] = "Rule 11 - QUAL vs CESM vs PQM Validation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var clients = ViewBag.Clients as List<Client> ?? new List<Client>();
    var selectedClientId = (int)(ViewBag.ClientId ?? 0);
    var currentSystemRole = ViewBag.CurrentSystemRole as string ?? "";
    var isResultsOnlyRole =
        string.Equals(currentSystemRole, "Manager", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentSystemRole, "Director", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentSystemRole, "Trainee", StringComparison.OrdinalIgnoreCase);
    var moduleNavigation = ViewBag.ModuleNavigation as HemisAudit.ViewModels.ModuleSequenceNavigationViewModel;
}

@if (isResultsOnlyRole)
{
    <style>
        #app > .accordion-stack > .accordion-item:nth-child(-n+3),
        #app > .action-bar {
            display: none !important;
        }
    </style>
}

<div id="app" class="rule-page-shell">
    @if (moduleNavigation != null)
    {
        @await Html.PartialAsync("_ModuleSequenceNav", moduleNavigation)
    }

    <div class="engagement-selector">
        <label>Engagement</label>
        <select id="clientIdSelect" onchange="handleClientChange(this.value)">
            <option value="0">Select engagement (results saved here)</option>
            @foreach (var c in clients)
            {
                <option value="@c.Id" selected="@(c.Id == selectedClientId ? "selected" : null)">@c.Name - @c.FiscalYear</option>
            }
        </select>
        <small id="workspaceSavedHint">Saved runs reload the last analyst configuration for this engagement.</small>
    </div>

    <div class="rule-header">
        <div class="rule-header__icon">R11</div>
        <div>
            <h1 class="rule-header__title">HEMIS RULE 11: QUAL vs CESM vs PQM Validation</h1>
            <p class="rule-header__sub">Three-table join | Qualification name + HEQF type matching | 100% population test</p>
        </div>
        <div class="rule-header__badge" id="statusBadge" style="display:none"></div>
    </div>

    <div class="accordion-stack">

        <!-- 1. Engagement Dataset -->
        <div class="accordion-item" id="acc-connection">
            <button class="accordion-toggle" onclick="toggleAccordion('connection')">
                <span class="acc-icon">DB</span>
                <span>Engagement Dataset</span>
                <span class="acc-chevron">v</span>
            </button>
            <div class="accordion-body" id="body-connection">
                <div class="alert alert--info" id="datasetStatusAlert">
                    Select an engagement above to load its uploaded tables.
                </div>
                <div class="action-bar" style="justify-content:flex-start;margin:12px 0 0">
                    <a class="btn btn-secondary" id="datasetsLink" href="#">Manage Datasets</a>
                    <button class="btn btn-primary" id="connectBtn" onclick="loadTables()">Refresh Tables</button>
                </div>
                <div class="status-output" id="connectionStatus"></div>
            </div>
        </div>

        <!-- 2. Table Configuration -->
        <div class="accordion-item" id="acc-tables">
            <button class="accordion-toggle" onclick="toggleAccordion('tables')">
                <span class="acc-icon">TB</span>
                <span>Table Configuration</span>
                <span class="acc-chevron">v</span>
            </button>
            <div class="accordion-body" id="body-tables" style="display:none">
                <div class="info-box info-box--red">
                    <strong>Rule 11 Requirement:</strong> Rule 11 joins <code>dbo_QUAL</code> and <code>dbo_CESM</code> on qualification code (<code>_001</code>), then validates
                    each qualification against the PQM register. Both the qualification name
                    (<code>QUAL._003</code> vs PQM <code>Authorised_Qualification_Name</code>) AND the HEQF qualification type
                    (<code>QUAL._005</code> vs PQM <code>HEQF_Qual_Type</code>) must match on the same PQM row to PASS.
                    Only QUAL rows with the configured approval status are evaluated. The HEQF type list below labels rows as Postgraduate or Undergraduate.
                    <code>CESM._006</code> (CESM code) is captured for reference.
                </div>
                <div class="form-grid">
                    <div class="field-group">
                        <label>QUAL Table <span class="auto-tag" id="qualAutoTag" style="display:none">auto-detected</span></label>
                        <select id="qualTableSelect" onchange="onTableChange('qual')">
                            <option value="">Select table (e.g. dbo_QUAL)</option>
                        </select>
                    </div>
                    <div class="field-group">
                        <label>CESM Table <span class="auto-tag" id="cesmAutoTag" style="display:none">auto-detected</span></label>
                        <select id="cesmTableSelect" onchange="onTableChange('cesm')">
                            <option value="">Select table (e.g. dbo_CESM)</option>
                        </select>
                    </div>
                    <div class="field-group">
                        <label>PQM Table <span class="auto-tag" id="pqmAutoTag" style="display:none">auto-detected</span></label>
                        <select id="pqmTableSelect" onchange="onTableChange('pqm')">
                            <option value="">Select PQM register table</option>
                        </select>
                    </div>
                </div>
                <div class="status-output" id="tableStatus"></div>
            </div>
        </div>

        <!-- 3. Column Mapping -->
        <div class="accordion-item" id="acc-columns">
            <button class="accordion-toggle" onclick="toggleAccordion('columns')">
                <span class="acc-icon">CL</span>
                <span>Column Mapping</span>
                <span class="acc-chevron">v</span>
            </button>
            <div class="accordion-body" id="body-columns" style="display:none">
                <div class="info-box info-box--dark">
                    <strong>Matching Logic:</strong>
                    QUAL <code>[_003]</code> (case-insensitive, whitespace-normalised) matches PQM <code>Authorised_Qualification_Name</code>,
                    <strong>AND</strong> QUAL <code>[_005]</code> matches PQM <code>HEQF_Qual_Type</code> — both on the <em>same</em> PQM row.
                    <code>CESM._006</code> is captured for display. EL Ã‚Â§5.1.2: Inspect E005 Qualification Type and agree correct type has been allocated per PQM.
                    The approval filter applies to the full QUAL population. The type codes below are used to classify rows as Postgraduate or Undergraduate.
                </div>
                <div class="form-grid">
                    <div class="field-group">
                        <label>QUAL — Qualification Code (_001) <span class="auto-tag" id="qualIdAutoTag" style="display:none">auto-selected</span></label>
                        <select id="qualIdColSelect"><option value="">Select column (_001)</option></select>
                    </div>
                    <div class="field-group">
                        <label>QUAL — Qualification Name (_003) <span class="auto-tag" id="qualNameAutoTag" style="display:none">auto-selected</span></label>
                        <select id="qualNameColSelect"><option value="">Select column (_003)</option></select>
                    </div>
                    <div class="field-group">
                        <label>QUAL — Approval Status (_004) <span class="auto-tag" id="qualApprovalAutoTag" style="display:none">auto-selected</span></label>
                        <select id="qualApprovalColSelect"><option value="">Select column (_004)</option></select>
                    </div>
                    <div class="field-group">
                        <label>QUAL — HEQF Type Column (_005) <span class="auto-tag" id="qualHeqfTypeAutoTag" style="display:none">auto-selected</span></label>
                        <select id="qualHeqfTypeColSelect"><option value="">Select column (_005)</option></select>
                    </div>
                    <div class="field-group">
                        <label>CESM — Qualification Code (_001) <span class="auto-tag" id="cesmIdAutoTag" style="display:none">auto-selected</span></label>
                        <select id="cesmIdColSelect"><option value="">Select column (_001)</option></select>
                    </div>
                    <div class="field-group">
                        <label>CESM — CESM Code Column (_006) <span class="auto-tag" id="cesmCodeAutoTag" style="display:none">auto-selected</span></label>
                        <select id="cesmCodeColSelect"><option value="">Select column (_006)</option></select>
                    </div>
                    <div class="field-group">
                        <label>PQM — Authorised Qualification Name <span class="auto-tag" id="pqmNameAutoTag" style="display:none">auto-selected</span></label>
                        <select id="pqmNameColSelect"><option value="">Select column</option></select>
                    </div>
                    <div class="field-group">
                        <label>PQM — HEQF_Qual_Type Column <span class="auto-tag" id="pqmHeqfTypeAutoTag" style="display:none">auto-selected</span></label>
                        <select id="pqmHeqfTypeColSelect"><option value="">Select column</option></select>
                    </div>
                    <div class="field-group">
                        <label>PQM — Code Column (CESM_Code) <span class="auto-tag" id="pqmCodeAutoTag" style="display:none">auto-selected</span></label>
                        <select id="pqmCodeColSelect"><option value="">Select column (CESM_Code)</option></select>
                    </div>
                </div>
                <div style="margin-top:20px;border-top:1px solid #e0e0e0;padding-top:16px">
                    <div style="font-weight:700;font-size:13px;margin-bottom:8px;color:#1a237e">QC &nbsp; QUAL Column Mapping &mdash; Additional Controls</div>
                    <div class="info-box info-box--warn" style="margin-bottom:12px">
                        Map the QUAL table columns used in controls C3&ndash;C6. Defaults match the standard HEMIS QUAL structure.
                    </div>
                    <div class="form-grid">
                        <div class="field-group">
                            <label>MIN TIME TOTAL COLUMN <small>(DEFAULT: _053, COMPARED TO PQM TOTAL2)</small> <span class="auto-tag" id="qualMtAutoTag" style="display:none">auto-selected</span></label>
                            <select id="qualMtColSelect"><option value="_053">_053</option></select>
                        </div>
                        <div class="field-group">
                            <label>MIN TIME WIL COLUMN <small>(DEFAULT: _054, COMPARED TO PQM WIL_EL2)</small> <span class="auto-tag" id="qualWilAutoTag" style="display:none">auto-selected</span></label>
                            <select id="qualWilColSelect"><option value="_054">_054</option></select>
                        </div>
                        <div class="field-group">
                            <label>HEQF/HEQSF INDICATOR COLUMN <small>(DEFAULT: _084, EXPECTED Y OR N)</small> <span class="auto-tag" id="qualHeqfAutoTag" style="display:none">auto-selected</span></label>
                            <select id="qualHeqfColSelect"><option value="_084">_084</option></select>
                        </div>
                        <div class="field-group">
                            <label>TOTAL SUBSIDY COLUMN <small>(DEFAULT: _090, COMPARED TO PQM TOTAL2)</small> <span class="auto-tag" id="qualSubAutoTag" style="display:none">auto-selected</span></label>
                            <select id="qualSubColSelect"><option value="_090">_090</option></select>
                        </div>
                    </div>
                </div>

                <div style="margin-top:20px;border-top:1px solid #e0e0e0;padding-top:16px">
                    <div style="font-weight:700;font-size:13px;margin-bottom:8px;color:#1a237e">PC &nbsp; PQM Column Mapping &mdash; Additional Controls</div>
                    <div class="info-box info-box--dark" style="margin-bottom:12px">
                        Map the PQM register columns used in controls C3&ndash;C6. Default field pairs:
                        <code>QUAL._053 = PQM.Total2</code>, <code>QUAL._054 = PQM.WIL_EL2</code>,
                        <code>QUAL._084 = derived from PQM.CHE_HEQC_Accreditation_Approval_Ref_Nr</code>, <code>QUAL._090 = PQM.Total2</code>.
                    </div>
                    <div class="form-grid">
                        <div class="field-group">
                            <label>CESM CODE 2 COLUMN <small>(E.G. CESM_CODE1)</small> <span class="auto-tag" id="pqmCode1AutoTag" style="display:none">auto-selected</span></label>
                            <select id="pqmCesmCode1ColSelect"><option value="CESM_CODE1">CESM_CODE1</option></select>
                        </div>
                        <div class="field-group">
                            <label>MIN TIME TOTAL COLUMN <small>(COMPARED TO QUAL _053, E.G. TOTAL2)</small> <span class="auto-tag" id="pqmMtAutoTag" style="display:none">auto-selected</span></label>
                            <select id="pqmMtColSelect"><option value="Total2">Total2</option></select>
                        </div>
                        <div class="field-group">
                            <label>WIL COLUMN <small>(COMPARED TO QUAL _054, E.G. WIL_EL2)</small> <span class="auto-tag" id="pqmWilAutoTag" style="display:none">auto-selected</span></label>
                            <select id="pqmWilColSelect"><option value="WIL_EL2">WIL_EL2</option></select>
                        </div>
                        <div class="field-group">
                            <label>ACCREDITATION REFERENCE COLUMN <small>(USED TO DETERMINE EXPECTED HEQF INDICATOR)</small> <span class="auto-tag" id="pqmAccAutoTag" style="display:none">auto-selected</span></label>
                            <select id="pqmAccColSelect"><option value="CHE_HEQC_Accreditation_Approval_Ref_Nr">CHE_HEQC_Accreditation_Approval_Ref_Nr</option></select>
                        </div>
                        <div class="field-group">
                            <label>TOTAL SUBSIDY COLUMN <small>(COMPARED TO QUAL _090, E.G. TOTAL2)</small> <span class="auto-tag" id="pqmSubAutoTag" style="display:none">auto-selected</span></label>
                            <select id="pqmSubColSelect"><option value="Total2">Total2</option></select>
                        </div>
                    </div>
                </div>

                <div class="info-box info-box--blue" style="margin-top:16px">
                    <strong>Population Classification:</strong> Rule 11 validates all QUAL rows where the approval status matches the configured value. The HEQF type list below marks rows as Postgraduate; all other approved rows are labelled Undergraduate. Update these values here if the source values change.
                </div>
                    <strong>Population Classification:</strong> Rule 11 validates all QUAL rows where the approval status matches the configured value. The HEQF type list below marks rows as Postgraduate; all other approved rows are labelled Undergraduate. Update these values here if the source values change.
                </div>
                <div class="form-grid" style="margin-top:12px">
                    <div class="field-group">
                        <label>QUAL — Approval Filter Value</label>
                        <input type="text" id="qualApprovalFilterValueInput"
                               value="A"
                               placeholder="e.g. A"
                               style="text-transform:uppercase;width:120px;font-family:monospace;font-size:15px;font-weight:bold"
                               maxlength="10"
                               oninput="this.value=this.value.toUpperCase();state.qualApprovalFilterValue=this.value.trim() || 'A';markWorkspaceDirty();" />
                        <small style="display:block;margin-top:4px;color:#555">
                            Only QUAL rows where <code id="qualApprovalFilterPreview">_004</code> = <strong id="qualApprovalFilterValuePreview">A</strong> are validated; <code>_005</code> is used to label rows as Postgraduate or Undergraduate.
                        </small>
                    </div>

                    <div style="margin-top:20px;border-top:1px solid #e0e0e0;padding-top:16px;grid-column:1 / -1">
                        <div style="font-weight:700;font-size:13px;margin-bottom:8px;color:#1a237e">PG &nbsp; Population Split</div>
                        <div class="info-box info-box--blue" style="margin-bottom:12px">
                            <strong>M Prefix Population Split:</strong> When checked, qualification codes matching <code>M_____</code> (e.g. <code>M12345</code>) are tagged as <strong>Postgraduate</strong>. They remain included in the validation population.<br>
                            <strong>Postgraduate Type Codes:</strong> Comma-separated <code>_005</code> values that classify a qualification as postgraduate. Any approved row not matching these rules is labelled <strong>Undergraduate</strong>.
                        </div>
                        <label class="checkbox-label" style="margin-bottom:12px">
                            <input type="checkbox" id="useMPrefixSplitCheck" onchange="state.useMPrefixPopulationSplit=this.checked;markWorkspaceDirty();" />
                            Treat qualification codes matching <code>M_____</code> as postgraduate
                        </label>
                    </div>

                    <div class="field-group" style="grid-column:1 / -1">
                        <label for="qualTypeCodesTextInput">QUAL — Postgraduate Type Codes</label>
                        <textarea id="qualTypeCodesTextInput" rows="3"
                                  style="width:100%;font-family:monospace;font-size:13px"
                                  oninput="state.qualTypeCodesText=this.value.trim() || '07, 27, 28, 49, 72, 73, 08, 30, 50, 74, 75';markWorkspaceDirty();">07, 27, 28, 49, 72, 73, 08, 30, 50, 74, 75</textarea>
                        <small style="display:block;margin-top:4px;color:#555">
                            Rows whose <code>_005</code> value appears here are labelled Postgraduate; all other approved rows are labelled Undergraduate.
                        </small>
                    </div>

                    <div style="margin-top:20px;border-top:1px solid #e0e0e0;padding-top:16px;grid-column:1 / -1">
                        <div style="font-weight:700;font-size:13px;margin-bottom:8px;color:#1a237e">HQ &nbsp; HEQF/HEQSF Indicator Codes (5.1.5)</div>
                        <div class="info-box info-box--blue" style="margin-bottom:12px">
                            <strong>Control 5.1.5:</strong> If <code>CHE_HEQC_Accreditation_Approval_Ref_Nr</code> contains any of these codes, QUAL column <code>_084</code> is expected to be <strong>Y</strong>; otherwise <strong>N</strong>. Enter codes as comma-separated values. You can update this list when new codes are issued.
                        </div>
                        <div class="field-group">
                            <label>HEQF/HEQSF INDICATOR CODES <small>(COMMA-SEPARATED, CASE-INSENSITIVE SUBSTRING MATCH)</small></label>
                            <input type="text" id="heqfIndicatorCodesInput" value="H/,HEQF,HEQSF"
                                   placeholder="e.g. H/,HEQF,HEQSF"
                                   oninput="state.heqfIndicatorCodesCsv=this.value.trim()||'H/,HEQF,HEQSF';markWorkspaceDirty();" />
                            <small style="display:block;margin-top:4px;color:#555">Example: if the accreditation ref is <code>H/H16/E084CAN01</code>, it contains "H/" &rarr; expected _084 = Y</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Download Formats -->
        <div class="accordion-item" id="acc-downloads">
            <button class="accordion-toggle" onclick="toggleAccordion('downloads')">
                <span class="acc-icon">DL</span>
                <span>Download Formats</span>
                <span class="acc-chevron">v</span>
            </button>
            <div class="accordion-body" id="body-downloads" style="display:none">
                <div class="checkbox-row">
                    <label class="checkbox-label"><input type="checkbox" id="chkExcel" checked /> Excel (Validation Results, Exceptions, Summary)</label>
                    <label class="checkbox-label"><input type="checkbox" id="chkCsv" checked /> CSV (Full results)</label>
                    <label class="checkbox-label"><input type="checkbox" id="chkExceptionsCsv" checked /> CSV (Exceptions only)</label>
                    <label class="checkbox-label"><input type="checkbox" id="chkSql" checked /> SQL Script</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Workspace Signoff Card -->
    <div class="workspace-signoff-card">
        <div class="workspace-signoff-card__header">
            <div>
                <div class="workspace-signoff-card__title">Saved Workspace</div>
                <div class="workspace-signoff-card__subtitle">The last saved Rule 11 connection, configuration, results, and signoffs reload here automatically.</div>
            </div>
            <div id="workspaceRunState" class="badge badge--neutral badge--sm">No saved run loaded</div>
        </div>
        <div id="workspaceInfo" class="alert alert--info">
            Select an engagement to load the last saved Rule 11 workspace.
        </div>
        <div class="workspace-signoff-grid">
            <div class="field-group">
                <label id="workspaceSignoffLabel">Signoff Comment</label>
                <textarea id="signoffComment" placeholder="Add the final review note that confirms this validation is complete."></textarea>
            </div>
        </div>
        <div class="workspace-signoff-actions">
            <button class="btn btn-success" id="saveWorkspaceBtn" onclick="saveWorkspace()">Save Workspace</button>
            <button class="btn btn-primary" id="signOffBtn" onclick="signOffWorkspace()">Sign Off</button>
            <button class="btn btn-warning" id="removeWorkspaceSignoffBtn" onclick="removeWorkspaceSignoff()" style="display:none">Remove Signoff</button>
        </div>
    </div>

    <!-- Action Bar -->
    <div class="action-bar">
        <button class="btn btn-info" onclick="verifyTables()">Verify Tables</button>
        <button class="btn btn-success" id="runValidationBtn" onclick="runValidation()">Run Validation</button>
        <button class="btn btn-primary" id="generateSqlBtn" onclick="generateSql()">Generate SQL</button>
<button class="btn btn-primary" id="generateRScriptBtn" onclick="generateRScript()">Generate R Script</button>
        <button class="btn btn-warning" id="downloadAllBtn" onclick="downloadAll()" disabled>Download All</button>
    </div>

    <!-- Results Panel -->
    <div class="results-panel">
        <div class="results-tabs">
            <button class="tab-btn active" type="button" data-tab="validation" onclick="switchTab('validation')">Validation Results</button>
            <button class="tab-btn" type="button" data-tab="exceptions" onclick="switchTab('exceptions')">Exceptions List</button>
            <button class="tab-btn" type="button" data-tab="charts" onclick="switchTab('charts')">Charts</button>
            <button class="tab-btn" type="button" data-tab="sql" onclick="switchTab('sql')">SQL Code</button>
<button class="tab-btn" type="button" data-tab="rscript" onclick="switchTab('rscript')">R Code</button>
            <button class="tab-btn" type="button" data-tab="downloads" onclick="switchTab('downloads')">Downloads</button>
        </div>

        <div class="tab-pane active" id="tab-validation" data-tab-panel="validation">
            <div id="validationContent" class="empty-state"><p>Run validation to see results here.</p></div>
        </div>
        <div class="tab-pane" id="tab-exceptions" data-tab-panel="exceptions">
            <div id="exceptionsContent" class="empty-state"><p>No exceptions data yet. Run validation first.</p></div>
        </div>
        <div class="tab-pane" id="tab-charts" data-tab-panel="charts">
            <div id="chartsContent" class="empty-state"><p>Charts will appear after running validation.</p></div>
        </div>
        <div class="tab-pane" id="tab-sql" data-tab-panel="sql">
            <div id="sqlContent" class="empty-state"><p>Click "Generate SQL" or run validation to generate the SQL script.</p></div>
        </div>
        <div class="tab-pane" id="tab-rscript" data-tab-panel="rscript">
            <div id="rContent" class="empty-state"><p>Click "Generate R Script" to generate the R script.</p></div>
        </div>
        <div class="tab-pane" id="tab-downloads" data-tab-panel="downloads">
            <div id="downloadsContent" class="empty-state"><p>Run validation first, then use "Download All" or individual download buttons.</p></div>
        </div>
    </div>

    <div id="spinner" class="spinner-overlay" style="display:none">
        <div class="spinner-box">
            <div class="spinner-ring"></div>
            <p id="spinnerMsg">Processing...</p>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
const currentSystemRole = '@(ViewBag.CurrentSystemRole ?? "")';
const uiPreviewRowLimit = 10;
const defaultQualApprovalFilterValue = 'A';
const defaultQualTypeCodesText = '07, 27, 28, 49, 72, 73, 08, 30, 50, 74, 75';
const state = {
    qualTable: '', cesmTable: '', pqmTable: '',
    qualIdCol: '', qualNameCol: '', qualApprovalCol: '', qualHeqfTypeCol: '',
    cesmIdCol: '', cesmCodeCol: '',
    qualApprovalFilterValue: defaultQualApprovalFilterValue,
    qualTypeCodesText: defaultQualTypeCodesText,
    pqmNameCol: '', pqmHeqfTypeCol: '', pqmCodeCol: '',
    pqmCesmCode1Col: 'CESM_CODE1',
    pqmMinTimeTotalCol: 'Total2',
    pqmWilCol: 'WIL_EL2',
    pqmAccreditationCol: 'CHE_HEQC_Accreditation_Approval_Ref_Nr',
    pqmTotalSubsidyCol: 'Total2',
    qualMinTimeTotalCol: '_053',
    qualMinTimeWilCol: '_054',
    qualHeqfCol: '_084',
    qualTotalSubsidyCol: '_090',
    heqfIndicatorCodesCsv: 'H/,HEQF,HEQSF',
    useMPrefixPopulationSplit: false,
    clientId: parseInt(document.getElementById('clientIdSelect')?.value || '0') || 0,
    currentRunId: null, validationResult: null,
    validationView: { filter: 'ALL', page: 1, pageSize: uiPreviewRowLimit },
    currentUserEngagementRole: '', currentStatus: '',
    currentUserHasSignedOff: false, isWorkspaceSaved: false,
    hasDataAnalystSignoff: false, resultsVisible: false,
    editWarningAccepted: false, isBeginningWorkspaceEdit: false,
    isHydrating: false, isDirty: false, chartInstances: {}
};

function getPopulationType(qualHeqfType, populationType) {
    if (populationType) return populationType;
    const postgraduateTypes = new Set(
        (state.qualTypeCodesText || '')
            .split(/[,\r\n;]+/)
            .map(v => v.trim().toUpperCase())
            .filter(Boolean)
    );
    return postgraduateTypes.has(String(qualHeqfType || '').trim().toUpperCase()) ? 'Postgraduate' : 'Undergraduate';
}

function toggleAccordion(name) {
    const body = document.getElementById(`body-${name}`);
    const chevron = document.querySelector(`#acc-${name} .acc-chevron`);
    const open = body.style.display !== 'none';
    body.style.display = open ? 'none' : 'block';
    if (chevron) chevron.textContent = open ? '^' : 'v';
}

function switchTab(name) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    document.querySelector(`[onclick="switchTab('${name}')"]`).classList.add('active');
    document.getElementById(`tab-${name}`).classList.add('active');
    if (name === 'charts' && state.validationResult) {
        const cc = document.getElementById('chartsContent');
        if (cc && cc.classList.contains('empty-state')) renderCharts(state.validationResult);
    }
}

function showSpinner(msg = 'Processing...') {
    document.getElementById('spinnerMsg').textContent = msg;
    document.getElementById('spinner').style.display = 'flex';
}
function hideSpinner() { document.getElementById('spinner').style.display = 'none'; }

function setStatus(elId, msg, type = 'info') {
    const el = document.getElementById(elId);
    if (el) el.innerHTML = `<div class="alert alert--${type}">${msg}</div>`;
}

function setWorkspaceInfo(msg, type = 'info') {
    const el = document.getElementById('workspaceInfo');
    if (!el) return;
    el.className = `alert alert--${type}`;
    el.innerHTML = msg;
    window.showWorkspaceActionToast?.(msg, type);
}

function setWorkspaceRunState(text, type = 'neutral') {
    const el = document.getElementById('workspaceRunState');
    if (el) { el.className = `badge badge--${type} badge--sm`; el.textContent = text; }
}

function isArchivedWorkspace() {
    return String(state.currentStatus || '').toLowerCase() === 'archived';
}

function updateHeaderBadge(status) {
    const badge = document.getElementById('statusBadge');
    if (!badge) return;
    if (!status) { badge.style.display = 'none'; badge.textContent = ''; return; }
    badge.style.display = 'inline-block';
    badge.className = 'rule-header__badge badge--neutral';
    badge.textContent = 'Sample Selected';
}

async function post(url, data) {
    return await window.fetchJsonWithProgress(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });
}
async function getJson(url) {
    return await window.fetchJsonWithProgress(url, { method: 'GET' });
}
async function downloadPost(url, data, filename) {
    await window.downloadFileWithProgress({
        url, method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
        defaultFileName: filename,
        label: 'Downloading result'
    });
}

async function markWorkspaceDirty() {
    if (state.isHydrating) return;
    if (currentSystemRole === 'Admin') return;
    if (isArchivedWorkspace()) return;

    if (state.clientId && state.currentRunId && !state.editWarningAccepted) {
        if (state.isBeginningWorkspaceEdit) {
            state.isDirty = true;
            renderWorkspaceState();
            return;
        }

        const confirmEdit = window.confirm(
            'Are you sure you want to edit this saved workspace? Existing signoffs will be removed and the run will need to be reviewed again.'
        );
        if (!confirmEdit) { await loadWorkspaceState(); return; }

        state.isBeginningWorkspaceEdit = true;
        state.editWarningAccepted = true;
        showSpinner('Clearing signoffs for the edited workspace...');

        try {
            const result = await post('/Rule11/BeginWorkspaceEdit', buildRequest());
            if (!result.success) {
                state.editWarningAccepted = false;
                setWorkspaceInfo(`Error: ${escapeHtml(result.error || 'Failed to begin editing.')}`, 'error');
                await loadWorkspaceState();
                return;
            }
            state.currentUserHasSignedOff = false;
            state.isWorkspaceSaved = false;
            state.hasDataAnalystSignoff = false;
            if (result.workspace) {
                state.currentRunId = result.workspace.runId || state.currentRunId;
                state.currentUserEngagementRole = result.workspace.currentUserEngagementRole || state.currentUserEngagementRole;
                state.currentStatus = result.workspace.currentStatus || state.currentStatus;
                state.resultsVisible = !!result.workspace.resultsVisible;
                document.getElementById('signoffComment').value = result.workspace.currentUserSignoffComment || '';
                if (result.workspace.summary)
                    applyValidationResult(result.workspace.summary, { switchToValidation: false, fromWorkspace: true });
            }
            setWorkspaceInfo(result.message || 'Editing has begun. Existing signoffs were removed.', 'warning');
        } catch (error) {
            state.editWarningAccepted = false;
            setWorkspaceInfo(`Error: ${escapeHtml(error?.message || 'Failed to begin editing.')}`, 'error');
            await loadWorkspaceState();
        } finally {
            state.isBeginningWorkspaceEdit = false;
            hideSpinner();
        }
    }

    state.isDirty = true;
    renderWorkspaceState();
}

function resetWorkspaceState(clearClient = false) {
    state.qualTable = ''; state.cesmTable = ''; state.pqmTable = '';
    state.qualIdCol = ''; state.qualNameCol = ''; state.qualApprovalCol = ''; state.qualHeqfTypeCol = '';
    state.cesmIdCol = ''; state.cesmCodeCol = '';
    state.qualApprovalFilterValue = defaultQualApprovalFilterValue;
    state.qualTypeCodesText = defaultQualTypeCodesText;
    state.pqmNameCol = ''; state.pqmHeqfTypeCol = ''; state.pqmCodeCol = '';
    state.pqmCesmCode1Col = 'CESM_CODE1';
    state.pqmMinTimeTotalCol = 'Total2';
    state.pqmWilCol = 'WIL_EL2';
    state.pqmAccreditationCol = 'CHE_HEQC_Accreditation_Approval_Ref_Nr';
    state.pqmTotalSubsidyCol = 'Total2';
    state.qualMinTimeTotalCol = '_053';
    state.qualMinTimeWilCol = '_054';
    state.qualHeqfCol = '_084';
    state.qualTotalSubsidyCol = '_090';
    state.heqfIndicatorCodesCsv = 'H/,HEQF,HEQSF';
    state.useMPrefixPopulationSplit = false;
    state.currentRunId = null; state.validationResult = null;
    state.validationView = { filter: 'ALL', page: 1, pageSize: uiPreviewRowLimit };
    state.currentUserEngagementRole = ''; state.currentStatus = '';
    state.currentUserHasSignedOff = false; state.isWorkspaceSaved = false;
    state.hasDataAnalystSignoff = false; state.resultsVisible = false;
    state.editWarningAccepted = false; state.isDirty = false;
    if (clearClient) state.clientId = 0;

    ['qualTableSelect','cesmTableSelect','pqmTableSelect'].forEach(id => {
        const el = document.getElementById(id); if (el) el.innerHTML = '<option value="">Select table</option>';
    });
    ['qualIdColSelect','qualNameColSelect','qualApprovalColSelect','qualHeqfTypeColSelect',
     'cesmIdColSelect','cesmCodeColSelect',
     'pqmNameColSelect','pqmHeqfTypeColSelect','pqmCodeColSelect'].forEach(id => {
        const el = document.getElementById(id); if (el) el.innerHTML = '<option value="">Select column</option>';
    });
    document.getElementById('qualApprovalFilterValueInput').value = defaultQualApprovalFilterValue;
    document.getElementById('qualTypeCodesTextInput').value = defaultQualTypeCodesText;
    document.getElementById('qualApprovalFilterValuePreview').textContent = defaultQualApprovalFilterValue;
    document.getElementById('qualApprovalFilterPreview').textContent = '_004';
    document.getElementById('signoffComment').value = '';
    document.getElementById('downloadAllBtn').disabled = true;
    ['qualAutoTag','cesmAutoTag','pqmAutoTag',
     'qualIdAutoTag','qualNameAutoTag','qualApprovalAutoTag','qualHeqfTypeAutoTag',
     'cesmIdAutoTag','cesmCodeAutoTag',
     'pqmNameAutoTag','pqmHeqfTypeAutoTag','pqmCodeAutoTag',
     'pqmCode1AutoTag','pqmMtAutoTag','pqmWilAutoTag','pqmAccAutoTag','pqmSubAutoTag',
     'qualMtAutoTag','qualWilAutoTag','qualHeqfAutoTag','qualSubAutoTag'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = 'none';
    });
    const useMPrefixCheck = document.getElementById('useMPrefixSplitCheck');
    if (useMPrefixCheck) useMPrefixCheck.checked = false;
    const heqfCodesInput = document.getElementById('heqfIndicatorCodesInput');
    if (heqfCodesInput) heqfCodesInput.value = 'H/,HEQF,HEQSF';
    ['pqmCesmCode1ColSelect','pqmMtColSelect','pqmWilColSelect','pqmAccColSelect','pqmSubColSelect',
     'qualMtColSelect','qualWilColSelect','qualHeqfColSelect','qualSubColSelect'].forEach(id => {
        const el = document.getElementById(id); if (el) el.innerHTML = '<option value=">Select column</option>';
    });
    document.getElementById('connectionStatus').innerHTML = '';
    document.getElementById('tableStatus').innerHTML = '';
    ['validationContent','exceptionsContent','chartsContent','sqlContent','downloadsContent'].forEach((id, i) => {
        const msgs = ['Run validation to see results here.',
            'No exceptions data yet. Run validation first.',
            'Charts will appear after running validation.',
            'Click "Generate SQL" or run validation to generate the SQL script.',
            'Run validation first, then use "Download All" or individual download buttons.'];
        const el = document.getElementById(id);
        el.className = 'empty-state';
        el.innerHTML = `<p>${msgs[i]}</p>`;
    });
    Object.values(state.chartInstances).forEach(c => c.destroy());
    state.chartInstances = {};
    updateHeaderBadge('');
    renderWorkspaceState();
}

function renderWorkspaceState() {
    const role = state.currentUserEngagementRole || currentSystemRole;
    const archived = isArchivedWorkspace();
    const canEditWorkspace = currentSystemRole === 'DataAnalyst' && !archived;
    const canSignWorkspace =
        !archived && state.currentRunId &&
        (currentSystemRole === 'DataAnalyst' ||
         (state.resultsVisible && (role === 'Manager' || role === 'Director')));
    const canActivateSignoff = !!canSignWorkspace && !!state.isWorkspaceSaved;
    const canRemoveWorkspaceSignoff = !archived && canSignWorkspace && state.currentUserHasSignedOff;
    const showDisabledArchivedSignoff = archived && !!state.currentRunId;
    const runValidationBtn = document.getElementById('runValidationBtn');
    const generateSqlBtn = document.getElementById('generateSqlBtn');
    const generateRScriptBtn = document.getElementById('generateRScriptBtn');
    const saveWorkspaceBtn = document.getElementById('saveWorkspaceBtn');
    const signOffBtn = document.getElementById('signOffBtn');
    const removeWorkspaceSignoffBtn = document.getElementById('removeWorkspaceSignoffBtn');
    const signoffComment = document.getElementById('signoffComment');
    const signoffLabel = document.getElementById('workspaceSignoffLabel');
    const signedOffLock = !!state.currentUserHasSignedOff;
    const signoffButtonText = state.currentUserHasSignedOff
        ? `Signed Off as ${role || 'Reviewer'}`
        : `Sign Off as ${role || 'Reviewer'}`;

    window.ruleWorkspaceUi.setReadonlyShell('app', !canEditWorkspace || signedOffLock);
    window.ruleWorkspaceUi.setFormSectionReadonly('.accordion-stack', !canEditWorkspace || signedOffLock);
    window.ruleWorkspaceUi.applyStates([
        { target: runValidationBtn, show: canEditWorkspace, disabled: !canEditWorkspace || signedOffLock },
        { target: generateSqlBtn,   show: canEditWorkspace, disabled: !canEditWorkspace || signedOffLock },
        { target: generateRScriptBtn,   show: canEditWorkspace, disabled: !canEditWorkspace || signedOffLock },
        { target: saveWorkspaceBtn, show: canEditWorkspace, disabled: !canEditWorkspace || !state.currentRunId || signedOffLock },
        { target: signoffComment,   disabled: archived || !canActivateSignoff || signedOffLock }
    ]);
    window.ruleWorkspaceUi.setButtonGroupReadonly(['.workspace-signoff-actions', '.action-bar'], signedOffLock, {
        allow: ['#downloadAllBtn', '#removeWorkspaceSignoffBtn']
    });

    if (showDisabledArchivedSignoff) {
        window.ruleWorkspaceUi.applyStates([
            { target: signOffBtn, show: true, disabled: true, text: signoffButtonText, title: 'Archived engagements are read-only. Signoff is disabled.' },
            { target: removeWorkspaceSignoffBtn, show: !!state.currentUserHasSignedOff, disabled: true, title: 'Archived engagements are read-only. Signoff removal is disabled.' }
        ]);
    } else {
        window.ruleWorkspaceUi.applyStates([
            { target: signOffBtn, show: canSignWorkspace, disabled: !canActivateSignoff || state.isDirty || signedOffLock, text: signoffButtonText, title: '' },
            { target: removeWorkspaceSignoffBtn, show: canRemoveWorkspaceSignoff, disabled: !canRemoveWorkspaceSignoff, title: '' }
        ]);
    }

    if (signoffLabel)
        signoffLabel.textContent = role === 'DataAnalyst' ? 'Analyst Signoff Comment' : 'Review Signoff Comment';

    applyWorkspaceAccessMode(canEditWorkspace);

    if (!state.clientId) {
        setWorkspaceRunState('No engagement selected', 'neutral');
        setWorkspaceInfo('Select an engagement to load the last saved Rule 11 workspace.', 'info');
        return;
    }
    if (!state.currentRunId) {
        setWorkspaceRunState('No saved run loaded', 'neutral');
        setWorkspaceInfo(
            canEditWorkspace
                ? 'No saved Rule 11 workspace exists for this engagement yet. Connect, configure, run validation, then save and sign off.'
                : 'No saved Rule 11 workspace exists for this engagement yet. This module is read-only for your role.', 'info');
        return;
    }
    if (archived) {
        setWorkspaceRunState(`Run #${state.currentRunId} archived`, 'warning');
        setWorkspaceInfo('This engagement is archived. The saved workspace and results remain visible, but configuration, validation, saving, and signoff are disabled.', 'warning');
        return;
    }
    if (state.isDirty) {
        setWorkspaceRunState(`Run #${state.currentRunId} loaded`, 'warning');
        setWorkspaceInfo(
            canEditWorkspace
                ? `Saved run <strong>#${state.currentRunId}</strong> is loaded, but the current screen has unsaved changes. Save the workspace or run validation again before signing off.`
                : `Saved run <strong>#${state.currentRunId}</strong> is loaded, but your role cannot edit this workspace.`, 'warning');
        return;
    }
    if (state.currentUserHasSignedOff) {
        setWorkspaceRunState(`Run #${state.currentRunId} signed off`, 'success');
        setWorkspaceInfo(`Saved run <strong>#${state.currentRunId}</strong> is loaded with its last configuration and results. Your analyst signoff is already on this run.`, 'success');
        return;
    }
    if (state.hasDataAnalystSignoff) {
        setWorkspaceRunState(`Run #${state.currentRunId} analyst-signed`, 'success');
        setWorkspaceInfo(`Saved run <strong>#${state.currentRunId}</strong> is loaded. Other assigned users can review this analyst-signed run.`, 'success');
        return;
    }
    setWorkspaceRunState(`Run #${state.currentRunId} saved`, 'info');
    setWorkspaceInfo(
        canEditWorkspace
            ? `Saved run <strong>#${state.currentRunId}</strong> is loaded. The analyst signoff is still outstanding.`
            : `Saved run <strong>#${state.currentRunId}</strong> is loaded and is awaiting analyst signoff.`, 'info');
}

function applyWorkspaceAccessMode(canEditWorkspace) {
    ['body-connection','body-tables','body-columns'].forEach(id => {
        const body = document.getElementById(id);
        if (!body) return;
        body.style.opacity = canEditWorkspace ? '' : '0.45';
        body.style.filter = canEditWorkspace ? '' : 'grayscale(0.15)';
        body.querySelectorAll('input, select, textarea, button').forEach(el => {
            el.disabled = !canEditWorkspace;
        });
    });
}

async function handleClientChange(value) {
    state.clientId = parseInt(value || '0') || 0;
    resetWorkspaceState();
    const link = document.getElementById('datasetsLink');
    if (link) link.href = state.clientId ? `/EngagementDatasets/Index?clientId=${state.clientId}` : '#';
    if (!state.clientId) return;
    await loadWorkspaceState();
}

async function loadWorkspaceState() {
    if (!state.clientId) { renderWorkspaceState(); return; }
    showSpinner('Loading saved workspace...');
    try {
        const result = await getJson(`/Rule11/GetWorkspaceState?clientId=${state.clientId}`);
        if (!result.success) { setWorkspaceInfo(`Error: ${escapeHtml(result.error || 'Failed to load saved workspace.')}`, 'error'); return; }
        if (!result.hasWorkspace || !result.workspace) { renderWorkspaceState(); await loadTables({ silent: true }); return; }
        await hydrateWorkspace(result.workspace);
    } finally { hideSpinner(); }
}

async function hydrateWorkspace(workspace) {
    state.isHydrating = true;
    let reconnectWarning = '';
    try {
        state.currentRunId = workspace.runId || null;
        state.currentUserEngagementRole = workspace.currentUserEngagementRole || '';
        state.currentStatus = workspace.currentStatus || '';
        state.currentUserHasSignedOff = !!workspace.currentUserHasSignedOff;
        state.isWorkspaceSaved = !!workspace.isWorkspaceSaved;
        state.hasDataAnalystSignoff = !!workspace.hasDataAnalystSignoff;
        state.resultsVisible = !!workspace.resultsVisible;
        state.editWarningAccepted = false;

        document.getElementById('signoffComment').value = workspace.currentUserSignoffComment || '';
        state.qualApprovalFilterValue = (workspace.qualApprovalFilterValue || defaultQualApprovalFilterValue).toUpperCase();
        state.qualTypeCodesText = workspace.qualTypeCodesText || defaultQualTypeCodesText;
        document.getElementById('qualApprovalFilterValueInput').value = state.qualApprovalFilterValue;
        document.getElementById('qualTypeCodesTextInput').value = state.qualTypeCodesText;
        state.pqmCesmCode1Col      = workspace.pqmCesmCode1Col     || 'CESM_CODE1';
        state.pqmMinTimeTotalCol   = workspace.pqmMinTimeTotalCol  || 'Total2';
        state.pqmWilCol            = workspace.pqmWilCol           || 'WIL_EL2';
        state.pqmAccreditationCol  = workspace.pqmAccreditationCol || 'CHE_HEQC_Accreditation_Approval_Ref_Nr';
        state.pqmTotalSubsidyCol   = workspace.pqmTotalSubsidyCol  || 'Total2';
        state.qualMinTimeTotalCol  = workspace.qualMinTimeTotalCol || '_053';
        state.qualMinTimeWilCol    = workspace.qualMinTimeWilCol   || '_054';
        state.qualHeqfCol          = workspace.qualHeqfCol         || '_084';
        state.qualTotalSubsidyCol  = workspace.qualTotalSubsidyCol || '_090';
        state.heqfIndicatorCodesCsv = workspace.heqfIndicatorCodesCsv || 'H/,HEQF,HEQSF';
        state.useMPrefixPopulationSplit = !!workspace.useMPrefixPopulationSplit;
        const useMPrefixCheck = document.getElementById('useMPrefixSplitCheck');
        if (useMPrefixCheck) useMPrefixCheck.checked = state.useMPrefixPopulationSplit;
        const heqfCodesInput = document.getElementById('heqfIndicatorCodesInput');
        if (heqfCodesInput) heqfCodesInput.value = state.heqfIndicatorCodesCsv;
        document.getElementById('qualApprovalFilterValuePreview').textContent = state.qualApprovalFilterValue;
        document.getElementById('qualApprovalFilterPreview').textContent = workspace.qualApprovalCol || '_004';

        if (workspace.summary && state.resultsVisible) {
            applyValidationResult(workspace.summary, { switchToValidation: false, fromWorkspace: true });
        } else {
            updateHeaderBadge(workspace.summary?.status || workspace.currentStatus || '');
        }

        try {
            if (state.clientId) {
                await loadTables({
                    preferredQualTable:      workspace.qualTable || '',
                    preferredCesmTable:      workspace.cesmTable || '',
                    preferredPqmTable:       workspace.pqmTable || '',
                    preferredQualIdCol:      workspace.qualIdCol || '',
                    preferredQualNameCol:    workspace.qualNameCol || '',
                    preferredQualApprovalCol: workspace.qualApprovalCol || '',
                    preferredQualHeqfTypeCol: workspace.qualHeqfTypeCol || '',
                    preferredCesmIdCol:      workspace.cesmIdCol || '',
                    preferredCesmCodeCol:    workspace.cesmCodeCol || '',
                    preferredPqmNameCol:     workspace.pqmNameCol || '',
                    preferredPqmHeqfTypeCol: workspace.pqmHeqfTypeCol || '',
                    preferredPqmCodeCol:     workspace.pqmCodeCol || '',
                    preferredPqmCesmCode1Col: workspace.pqmCesmCode1Col || '',
                    preferredPqmMtCol:   workspace.pqmMinTimeTotalCol || '',
                    preferredPqmWilCol:  workspace.pqmWilCol || '',
                    preferredPqmAccCol:  workspace.pqmAccreditationCol || '',
                    preferredPqmSubCol:  workspace.pqmTotalSubsidyCol || '',
                    preferredQualMtCol:  workspace.qualMinTimeTotalCol || '',
                    preferredQualWilCol: workspace.qualMinTimeWilCol || '',
                    preferredQualHeqfCol:workspace.qualHeqfCol || '',
                    preferredQualSubCol: workspace.qualTotalSubsidyCol || '',
                    silent: true
                });
            }
        } catch (error) {
            reconnectWarning = state.resultsVisible
                ? 'Saved workspace results are still loaded, but the engagement tables could not be reloaded.'
                : 'The saved workspace was found, but the engagement tables could not be reloaded.';
            setStatus('connectionStatus', `Warning: ${escapeHtml(error?.message || 'Failed to load engagement tables.')}`, 'warning');
        }
    } finally {
        state.isHydrating = false;
        state.isDirty = false;
        renderWorkspaceState();
        if (reconnectWarning) setWorkspaceInfo(reconnectWarning, 'warning');
    }
}

async function loadTables(options = {}) {
    if (!state.clientId) { setStatus('connectionStatus', 'Select an engagement to load its uploaded tables.', 'info'); return null; }
    if (!options.silent) showSpinner('Loading engagement tables...');

    const result = await post('/Rule11/GetTables', { clientId: state.clientId });
    if (!options.silent) hideSpinner();
    if (!result.success) { setStatus('connectionStatus', `Error: ${result.error}`, 'error'); return null; }

    setStatus('connectionStatus', `Loaded ${result.tables.length} uploaded table(s) for this engagement.`, 'success');

    ['qualTableSelect','cesmTableSelect','pqmTableSelect'].forEach(id => {
        const sel = document.getElementById(id);
        sel.innerHTML = '<option value="">Select table</option>';
        result.tables.forEach(t => sel.appendChild(new Option(t, t)));
    });

    const selQual = options.preferredQualTable || result.autoQualTable || '';
    const selCesm = options.preferredCesmTable || result.autoCesmTable || '';
    const selPqm  = options.preferredPqmTable  || result.autoPqmTable  || '';

    setAutoTag('qualAutoTag', selQual, result.autoQualTable);
    setAutoTag('cesmAutoTag', selCesm, result.autoCesmTable);
    setAutoTag('pqmAutoTag',  selPqm,  result.autoPqmTable);

    if (selQual && result.tables.includes(selQual)) { document.getElementById('qualTableSelect').value = selQual; state.qualTable = selQual; }
    if (selCesm && result.tables.includes(selCesm)) { document.getElementById('cesmTableSelect').value = selCesm; state.cesmTable = selCesm; }
    if (selPqm  && result.tables.includes(selPqm))  { document.getElementById('pqmTableSelect').value  = selPqm;  state.pqmTable  = selPqm; }

    document.getElementById('body-tables').style.display = 'block';
    document.querySelector('#acc-tables .acc-chevron').textContent = '^';

    if (selQual) await loadColumnsForTable('qual', {
        preferredIdCol: options.preferredQualIdCol, preferredNameCol: options.preferredQualNameCol,
        preferredApprovalCol: options.preferredQualApprovalCol, preferredHeqfTypeCol: options.preferredQualHeqfTypeCol,
        preferredMtCol: options.preferredQualMtCol, preferredWilCol: options.preferredQualWilCol,
        preferredHeqfCol: options.preferredQualHeqfCol, preferredSubCol: options.preferredQualSubCol, silent: true });
    if (selCesm) await loadColumnsForTable('cesm', {
        preferredIdCol: options.preferredCesmIdCol, preferredCodeCol: options.preferredCesmCodeCol, silent: true });
    if (selPqm)  await loadColumnsForTable('pqm',  {
        preferredNameCol: options.preferredPqmNameCol, preferredHeqfTypeCol: options.preferredPqmHeqfTypeCol, preferredCodeCol: options.preferredPqmCodeCol,
        preferredCesmCode1Col: options.preferredPqmCesmCode1Col, preferredMtCol: options.preferredPqmMtCol,
        preferredWilCol: options.preferredPqmWilCol, preferredAccCol: options.preferredPqmAccCol,
        preferredSubCol: options.preferredPqmSubCol, silent: true });

    return result;
}

function setAutoTag(tagId, selected, autoValue) {
    const el = document.getElementById(tagId);
    if (el) el.style.display = selected && selected === autoValue ? 'inline' : 'none';
}

async function onTableChange(which) {
    await markWorkspaceDirty();
    if (which === 'qual') {
        state.qualTable = document.getElementById('qualTableSelect').value;
        if (state.qualTable) await loadColumnsForTable('qual', {});
    } else if (which === 'cesm') {
        state.cesmTable = document.getElementById('cesmTableSelect').value;
        if (state.cesmTable) await loadColumnsForTable('cesm', {});
    } else if (which === 'pqm') {
        state.pqmTable = document.getElementById('pqmTableSelect').value;
        if (state.pqmTable) await loadColumnsForTable('pqm', {});
    }
}

async function loadColumnsForTable(which, options = {}) {
    const tableName = which === 'qual' ? state.qualTable
                    : which === 'cesm' ? state.cesmTable
                    : state.pqmTable;
    if (!tableName) return;

    const columnRoles = which === 'qual'
        ? [{ key: 'qual_id',        sel: 'qualIdColSelect',       autoTag: 'qualIdAutoTag',        preferred: options.preferredIdCol       || '' },
           { key: 'qual_name',      sel: 'qualNameColSelect',     autoTag: 'qualNameAutoTag',      preferred: options.preferredNameCol     || '' },
           { key: 'qual_approval',  sel: 'qualApprovalColSelect', autoTag: 'qualApprovalAutoTag',  preferred: options.preferredApprovalCol  || '' },
           { key: 'qual_heqf_type', sel: 'qualHeqfTypeColSelect', autoTag: 'qualHeqfTypeAutoTag',  preferred: options.preferredHeqfTypeCol  || '' },
           { key: 'qual_min_time_total', sel: 'qualMtColSelect',   autoTag: 'qualMtAutoTag',   preferred: options.preferredMtCol   || '' },
           { key: 'qual_min_time_wil',   sel: 'qualWilColSelect',  autoTag: 'qualWilAutoTag',  preferred: options.preferredWilCol  || '' },
           { key: 'qual_heqf',           sel: 'qualHeqfColSelect', autoTag: 'qualHeqfAutoTag', preferred: options.preferredHeqfCol || '' },
           { key: 'qual_total_subsidy',  sel: 'qualSubColSelect',  autoTag: 'qualSubAutoTag',  preferred: options.preferredSubCol  || '' }]
        : which === 'cesm'
        ? [{ key: 'cesm_id',        sel: 'cesmIdColSelect',       autoTag: 'cesmIdAutoTag',        preferred: options.preferredIdCol   || '' },
           { key: 'cesm_code',      sel: 'cesmCodeColSelect',     autoTag: 'cesmCodeAutoTag',      preferred: options.preferredCodeCol || '' }]
        : [{ key: 'pqm_name',       sel: 'pqmNameColSelect',      autoTag: 'pqmNameAutoTag',       preferred: options.preferredNameCol      || '' },
           { key: 'pqm_heqf_type',  sel: 'pqmHeqfTypeColSelect',  autoTag: 'pqmHeqfTypeAutoTag',   preferred: options.preferredHeqfTypeCol  || '' },
           { key: 'pqm_code',       sel: 'pqmCodeColSelect',      autoTag: 'pqmCodeAutoTag',       preferred: options.preferredCodeCol      || '' },
           { key: 'pqm_cesm_code1', sel: 'pqmCesmCode1ColSelect',  autoTag: 'pqmCode1AutoTag',      preferred: options.preferredCesmCode1Col || '' },
           { key: 'pqm_min_time_total', sel: 'pqmMtColSelect',     autoTag: 'pqmMtAutoTag',         preferred: options.preferredMtCol        || '' },
           { key: 'pqm_wil',        sel: 'pqmWilColSelect',       autoTag: 'pqmWilAutoTag',        preferred: options.preferredWilCol       || '' },
           { key: 'pqm_accreditation', sel: 'pqmAccColSelect',    autoTag: 'pqmAccAutoTag',        preferred: options.preferredAccCol       || '' },
           { key: 'pqm_total_subsidy', sel: 'pqmSubColSelect',    autoTag: 'pqmSubAutoTag',        preferred: options.preferredSubCol       || '' }];

    for (const roleInfo of columnRoles) {
        const result = await post('/Rule11/GetColumns', {
            clientId: state.clientId,
            tableName, tableRole: roleInfo.key
        });
        if (!result.success) continue;

        const columns = result.columns || result.Columns || [];
        const autoSelected = result.autoSelected || result.AutoSelected || '';
        const sel = document.getElementById(roleInfo.sel);
        sel.innerHTML = '<option value="">Select column</option>';
        columns.forEach(c => sel.appendChild(new Option(c, c)));

        const preferredCol = roleInfo.preferred ? columns.find(c => c.toLowerCase() === roleInfo.preferred.toLowerCase()) : null;
        const selectedCol = preferredCol || autoSelected || '';
        setAutoTag(roleInfo.autoTag, selectedCol, autoSelected);
        if (selectedCol) sel.value = selectedCol;

        if (roleInfo.key === 'qual_id')        state.qualIdCol        = sel.value;
        if (roleInfo.key === 'qual_name')       state.qualNameCol      = sel.value;
        if (roleInfo.key === 'qual_approval')   state.qualApprovalCol  = sel.value;
        if (roleInfo.key === 'qual_heqf_type')  state.qualHeqfTypeCol  = sel.value;
        if (roleInfo.key === 'cesm_id')         state.cesmIdCol        = sel.value;
        if (roleInfo.key === 'cesm_code')       state.cesmCodeCol      = sel.value;
        if (roleInfo.key === 'pqm_name')        state.pqmNameCol       = sel.value;
        if (roleInfo.key === 'pqm_heqf_type')   state.pqmHeqfTypeCol   = sel.value;
        if (roleInfo.key === 'pqm_code')        state.pqmCodeCol       = sel.value;
        if (roleInfo.key === 'pqm_cesm_code1')   state.pqmCesmCode1Col    = sel.value;
        if (roleInfo.key === 'pqm_min_time_total') state.pqmMinTimeTotalCol = sel.value;
        if (roleInfo.key === 'pqm_wil')          state.pqmWilCol          = sel.value;
        if (roleInfo.key === 'pqm_accreditation') state.pqmAccreditationCol = sel.value;
        if (roleInfo.key === 'pqm_total_subsidy') state.pqmTotalSubsidyCol = sel.value;
        if (roleInfo.key === 'qual_min_time_total') state.qualMinTimeTotalCol = sel.value;
        if (roleInfo.key === 'qual_min_time_wil')  state.qualMinTimeWilCol  = sel.value;
        if (roleInfo.key === 'qual_heqf')          state.qualHeqfCol        = sel.value;
        if (roleInfo.key === 'qual_total_subsidy') state.qualTotalSubsidyCol = sel.value;
    }

    document.getElementById('body-columns').style.display = 'block';
    document.querySelector('#acc-columns .acc-chevron').textContent = '^';
}


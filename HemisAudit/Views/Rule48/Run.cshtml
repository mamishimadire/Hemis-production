@model HemisAudit.ViewModels.Rule41RunReviewViewModel
@{
    ViewData["Title"] = $"Rule 48 Run {Model.RunId}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdmin = ViewBag.IsAdmin is bool admin && admin;
    var canDownload = ViewBag.CanDownloadSavedRun is bool allowed && allowed;
    var canManageEngagement = ViewBag.CanManageEngagement is bool me && me;
    var canOpenWorkspace = ViewBag.CanOpenWorkspace is bool owb && owb;
    var isArchived = ViewBag.IsArchived is bool arch && arch;
    var moduleNavigation = ViewBag.ModuleNavigation as HemisAudit.ViewModels.ModuleSequenceNavigationViewModel;
    var s = Model.Summary ?? new HemisAudit.ViewModels.Rule41ValidationSummary();
    var reconc = s.Reconc ?? new HemisAudit.ViewModels.Rule41ReconciliationSummary();
    var pairs = reconc.Pairs ?? new List<HemisAudit.ViewModels.Rule41ColumnPair>();
    var clearRows = reconc.Rows ?? new List<HemisAudit.ViewModels.Rule41ReconcRow>();
    var exceptionRows = reconc.ExceptionRows ?? new List<HemisAudit.ViewModels.Rule41ReconcRow>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert--success" style="margin-bottom:16px">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert--error" style="margin-bottom:16px">@TempData["Error"]</div>
}

@if (moduleNavigation != null)
{
    @await Html.PartialAsync("_ModuleSequenceNav", moduleNavigation)
}

<style>
    .viz-grid { display:grid; gap:16px; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); }
    .viz-card { background:#fff; border:1px solid #e5e7eb; border-radius:18px; padding:20px; box-shadow:0 18px 40px rgba(15,23,42,.06); }
    .code-panel { background:#0f172a; border-radius:18px; color:#e2e8f0; overflow:auto; padding:18px; }
    .code-panel pre { margin:0; white-space:pre-wrap; word-break:break-word; }
</style>

<div class="page-header">
    <div>
        <h1>HEMIS RULE 48: CRED vs H16CRED Agreement</h1>
        <p>
            @Model.EngagementName
            <span style="padding:0 8px">|</span>
            @Model.MaconomyNumber
            <span style="padding:0 8px">|</span>
            Run #@Model.RunId
            <span style="padding:0 8px">|</span>
            @s.Timestamp
        </p>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
        @if (canOpenWorkspace)
        {
            <a href="/Rule48?clientId=@Model.ClientId" class="btn btn-primary">Open Workspace</a>
        }
        @if (canManageEngagement)
        {
            <a href="/Clients/Details/@Model.ClientId" class="btn btn-secondary">Manage Engagement</a>
        }
    </div>
</div>

@if (!Model.IsCurrentRun)
{
    <div class="alert alert--warning" style="margin-bottom:16px">
        This is a historical run. A newer run exists for this engagement.
        <a href="/Rule48?clientId=@Model.ClientId">Open current workspace</a>
    </div>
}

@if (isArchived)
{
    <div class="alert alert--warning" style="margin-bottom:16px">
        This engagement is archived. Results are read-only; signoff and removal are disabled.
    </div>
}

<!-- Status Summary -->
<div class="results-card" style="margin-bottom:24px">
    <div class="viz-grid">
        <div class="viz-card">
            <div style="font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;margin-bottom:6px">Total</div>
            <div style="font-size:28px;font-weight:800">@s.TotalCount.ToString("N0")</div>
        </div>
        <div class="viz-card" style="border-left:4px solid #22C55E">
            <div style="font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;margin-bottom:6px">Agree</div>
            <div style="font-size:28px;font-weight:800;color:#166534">@s.AgreeCount.ToString("N0")</div>
        </div>
        <div class="viz-card" style="border-left:4px solid #EF4444">
            <div style="font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;margin-bottom:6px">Disagree</div>
            <div style="font-size:28px;font-weight:800;color:#C62828">@s.DisagreeCount.ToString("N0")</div>
        </div>
        <div class="viz-card" style="border-left:4px solid #EF4444">
            <div style="font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;margin-bottom:6px">Missing</div>
            <div style="font-size:28px;font-weight:800;color:#C62828">@s.MissingCount.ToString("N0")</div>
        </div>
        <div class="viz-card" style="border-left:4px solid @(s.Status == "PASS" ? "#22C55E" : "#EF4444")">
            <div style="font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;margin-bottom:6px">Status</div>
            <div style="font-size:28px;font-weight:800;color:@(s.Status == "PASS" ? "#166534" : "#C62828")">@s.Status</div>
            <div style="font-size:11px;color:#64748b">Rate: @s.ExceptionRate.ToString("F2")%</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(s.Warning))
{
    <div class="alert alert--warning" style="margin-bottom:16px">@s.Warning</div>
}

<!-- Tabs -->
<div class="results-panel">
    <div class="results-tabs">
        <button class="tab-btn active" onclick="switchTab('exceptions')">DISAGREE / MISSING (@((reconc.DisagreeCount + reconc.MissingCount).ToString("N0")))</button>
        <button class="tab-btn" onclick="switchTab('agree')">AGREE (@reconc.AgreeCount.ToString("N0"))</button>
        <button class="tab-btn" onclick="switchTab('config')">Configuration</button>
        <button class="tab-btn" onclick="switchTab('signoffs')">Signoffs</button>
        <button class="tab-btn" onclick="switchTab('sql')">SQL Code</button>
        @if (canDownload)
        {
            <button class="tab-btn" onclick="switchTab('downloads')">Downloads</button>
        }
    </div>

    <!-- DISAGREE / MISSING rows -->
    <div class="tab-pane active" id="tab-exceptions">
        <h3 style="margin-bottom:1rem">DISAGREE / MISSING Rows</h3>
        @if (!exceptionRows.Any())
        {
            <div class="alert alert--success">No exceptions — all students agree between CRED and H16CRED.</div>
        }
        else
        {
            <div class="results-table-shell">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student No</th>
                                @foreach (var p in pairs)
                                {
                                    <th>CRED @p.StudCol</th>
                                    <th>H16CRED @p.H16Col</th>
                                    <th>Match</th>
                                }
                                <th>Result</th>
                                <th>Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in exceptionRows)
                            {
                                <tr>
                                    <td>@row.RowNumber</td>
                                    <td><strong>@row.StudentRef</strong></td>
                                    @foreach (var p in pairs)
                                    {
                                        var fv = row.Fields != null && row.Fields.TryGetValue(p.Label, out var f) ? f : new HemisAudit.ViewModels.Rule41FieldValue();
                                        <td>@fv.StudValue</td>
                                        <td>@fv.H16Value</td>
                                        <td>
                                            @if (fv.Match == "AGREE")
                                            {
                                                <span class="badge badge--pass">✓</span>
                                            }
                                            else if (fv.Match == "DISAGREE")
                                            {
                                                <span class="badge badge--fail">✗</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge--neutral">?</span>
                                            }
                                        </td>
                                    }
                                    <td>
                                        @if (row.OverallResult == "DISAGREE")
                                        {
                                            <span class="badge badge--fail">DISAGREE</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge--neutral">MISSING</span>
                                        }
                                    </td>
                                    <td>@row.DisagreeDetail</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (exceptionRows.Count < reconc.DisagreeCount + reconc.MissingCount)
                {
                    <div class="table-footer">Showing @exceptionRows.Count of @((reconc.DisagreeCount + reconc.MissingCount).ToString("N0")) exception rows. Download the Excel or CSV for the full list.</div>
                }
            </div>
        }
    </div>

    <!-- AGREE rows -->
    <div class="tab-pane" id="tab-agree">
        <h3 style="margin-bottom:1rem">AGREE Rows</h3>
        @if (!clearRows.Any())
        {
            <div class="alert alert--warning">No AGREE rows available in this saved run.</div>
        }
        else
        {
            <div class="results-table-shell">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student No</th>
                                @foreach (var p in pairs)
                                {
                                    <th>CRED @p.StudCol</th>
                                    <th>H16CRED @p.H16Col</th>
                                    <th>Match</th>
                                }
                                <th>Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in clearRows)
                            {
                                <tr>
                                    <td>@row.RowNumber</td>
                                    <td><strong>@row.StudentRef</strong></td>
                                    @foreach (var p in pairs)
                                    {
                                        var fv = row.Fields != null && row.Fields.TryGetValue(p.Label, out var f) ? f : new HemisAudit.ViewModels.Rule41FieldValue();
                                        <td>@fv.StudValue</td>
                                        <td>@fv.H16Value</td>
                                        <td><span class="badge badge--pass">✓</span></td>
                                    }
                                    <td><span class="badge badge--pass">AGREE</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (clearRows.Count < reconc.AgreeCount)
                {
                    <div class="table-footer">Showing @clearRows.Count of @reconc.AgreeCount.ToString("N0") AGREE rows. Download the Excel or CSV for the full list.</div>
                }
            </div>
        }
    </div>

    <!-- Configuration -->
    <div class="tab-pane" id="tab-config">
        <h3 style="margin-bottom:1rem">Run Configuration</h3>
        <table class="data-table">
            <tbody>
                <tr><td style="font-weight:600">CRED Table</td><td>@s.StudTable</td></tr>
                <tr><td style="font-weight:600">H16CRED Table</td><td>@s.H16Table</td></tr>
                <tr><td style="font-weight:600">CRED Join Key</td><td>@s.StudKey</td></tr>
                <tr><td style="font-weight:600">H16CRED Join Key</td><td>@s.H16Key</td></tr>
                @if (!string.IsNullOrWhiteSpace(reconc.StudSecondaryKey)) { <tr><td style="font-weight:600">CRED Secondary Key</td><td>@reconc.StudSecondaryKey</td></tr> }
                @if (!string.IsNullOrWhiteSpace(reconc.H16SecondaryKey)) { <tr><td style="font-weight:600">H16CRED Secondary Key</td><td>@reconc.H16SecondaryKey</td></tr> }
                <tr>
                    <td style="font-weight:600">Compared Columns</td>
                    <td>
                        @string.Join(", ", pairs.Select(p => $"{p.Label} ({p.StudCol} ↔ {p.H16Col})"))
                    </td>
                </tr>
                <tr><td style="font-weight:600">Run Date</td><td>@s.Timestamp</td></tr>
                <tr><td style="font-weight:600">Run ID</td><td>#@Model.RunId</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Signoffs -->
    <div class="tab-pane" id="tab-signoffs">
        <h3 style="margin-bottom:1rem">Signoffs</h3>
        @if (!Model.Signoffs.Any())
        {
            <div class="alert alert--info">No signoffs recorded for this run yet.</div>
        }
        else
        {
            <div class="results-table-shell">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead><tr><th>Role</th><th>Reviewer</th><th>Comment</th><th>Signed Off At</th><th>Your Record</th></tr></thead>
                        <tbody>
                            @foreach (var so in Model.Signoffs)
                            {
                                <tr class="@(so.IsCurrentUser ? "row-highlight" : "")">
                                    <td><span class="badge badge--neutral badge--sm">@so.SignoffRole</span></td>
                                    <td>@so.ReviewerName <small style="color:#64748b">@so.ReviewerEmail</small></td>
                                    <td>@so.Comment</td>
                                    <td>@so.SignedOffAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(so.IsCurrentUser ? "✔" : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (Model.IsCurrentRun && !isArchived && Model.CanCurrentUserSignOff)
        {
            <div class="alert alert--info" style="margin-top:1rem">
                Signoff for this run is managed from the <a href="/Rule48?clientId=@Model.ClientId">Rule 48 workspace</a>.
            </div>
        }
    </div>

    <!-- SQL Code -->
    <div class="tab-pane" id="tab-sql">
        <h3 style="margin-bottom:1rem">Generated SQL</h3>
        <div class="code-panel">
            <pre>@Model.GeneratedSql</pre>
        </div>
    </div>

    <!-- Downloads -->
    @if (canDownload)
    {
        <div class="tab-pane" id="tab-downloads">
            <h3 style="margin-bottom:1rem">Download Run #@Model.RunId</h3>
            <div class="download-buttons download-buttons--wide">
                <a href="/Rule48/DownloadExcel?runId=@Model.RunId" class="btn btn-success">Excel</a>
                <a href="/Rule48/DownloadCsv?runId=@Model.RunId" class="btn btn-info">Full CSV</a>
                <a href="/Rule48/DownloadExceptionsCsv?runId=@Model.RunId" class="btn btn-info">Exceptions CSV</a>
                <a href="/Rule48/DownloadSql?runId=@Model.RunId" class="btn btn-primary">SQL Script</a>
            </div>
        </div>
    }
</div>

<script>
function switchTab(name) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    const btn = document.querySelector(`.tab-btn[onclick="switchTab('${name}')"]`);
    if (btn) btn.classList.add('active');
    const panel = document.getElementById(`tab-${name}`);
    if (panel) panel.classList.add('active');
}
</script>

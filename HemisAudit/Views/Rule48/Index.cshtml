@using HemisAudit.Models
@{
    ViewData["Title"] = "Rule 48 – Student ASCII Agreement";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var clients = ViewBag.Clients as List<Client> ?? new();
    var selectedClientId = ViewBag.ClientId is int cid ? cid : 0;
    var currentSystemRole = ViewBag.CurrentSystemRole as string ?? "";
    var isResultsOnlyRole =
        string.Equals(currentSystemRole, "Manager",  StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentSystemRole, "Director", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentSystemRole, "Trainee",  StringComparison.OrdinalIgnoreCase);
    var moduleNavigation = ViewBag.ModuleNavigation as HemisAudit.ViewModels.ModuleSequenceNavigationViewModel;
}

<style>
.r48-pair-row { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:6px; background:#f9f9f9; padding:6px 8px; border-radius:6px; border:1px solid #e8e8e8; }
.r48-pair-row select,.r48-pair-row input[type=text] { font-size:.82rem; border:1px solid #ccc; border-radius:4px; padding:3px 7px; min-width:100px; max-width:170px; }
.r48-pair-del { background:#C0392B; color:#fff; border:none; border-radius:4px; padding:2px 8px; cursor:pointer; font-size:.8rem; flex-shrink:0; }
.r48-tbl { border-collapse:collapse; width:100%; font-size:.81rem; }
.r48-tbl th { background:#1565A6; color:#fff; padding:5px 7px; text-align:center; border:1px solid #bbb; white-space:nowrap; }
.r48-tbl td { padding:4px 6px; border:1px solid #ddd; text-align:center; vertical-align:middle; }
.r48-tbl tr.agree    { background:#F1F8E9; }
.r48-tbl tr.disagree { background:#FFEBEE; }
.r48-tbl tr.missing  { background:#FFF3E0; }
.r48-tbl td.oc { background:#DDEEFF; }
.r48-agree { display:inline-block; padding:2px 7px; border-radius:4px; font-size:.75rem; font-weight:700; background:#E8F5E9; color:#1E8449; }
.r48-exc   { display:inline-block; padding:2px 7px; border-radius:4px; font-size:.75rem; font-weight:700; background:#FFEBEE; color:#C0392B; }
.r48-miss  { display:inline-block; padding:2px 7px; border-radius:4px; font-size:.75rem; font-weight:700; background:#FFF3E0; color:#E67E22; }
.workspace-signoff-actions { display:flex; gap:10px; flex-wrap:wrap; padding-top:4px; }
</style>

<div id="app" class="rule-page-shell">
    @if (moduleNavigation != null)
    {
        @await Html.PartialAsync("_ModuleSequenceNav", moduleNavigation)
    }

    <div class="engagement-selector">
        <label for="r48ClientId">Engagement</label>
        <select id="r48ClientId" onchange="r48OnClientChange(this.value)">
            <option value="">Select engagement</option>
            @foreach (var client in clients)
            {
                <option value="@client.Id" selected="@(client.Id == selectedClientId ? "selected" : null)">
                    @client.Name (@client.FiscalYear)
                </option>
            }
        </select>
    </div>

    <div class="rule-header">
        <div class="rule-header__icon">R48</div>
        <div>
            <h1 class="rule-header__title">HEMIS RULE 48: CRED vs H16CRED Agreement</h1>
            <p class="rule-header__sub">
                Full outer reconciliation of <code>CRED</code> vs <code>H16CRED</code> (audit system).
                Join key: <code>_001</code> (CRED) &harr; <code>_001</code> (H16CRED).
            </p>
        </div>
        <div class="rule-header__badge" id="r48StatusBadge" style="display:none"></div>
    </div>

    @if (!isResultsOnlyRole)
    {
    <div class="accordion-stack">
        <div class="accordion-item">
            <button class="accordion-toggle" type="button" onclick="toggleAccordion('r48-conn')">
                <span class="acc-icon">DB</span><span>Engagement Dataset</span><span class="acc-chevron">v</span>
            </button>
            <div class="accordion-body" id="body-r48-conn">
                <div class="alert alert--info" id="r48DatasetStatusAlert">
                    Select an engagement above to load its uploaded tables.
                </div>
                <div class="action-bar" style="justify-content:flex-start;margin:12px 0 0">
                    <a class="btn btn-secondary" id="r48DatasetsLink" href="#">Manage Datasets</a>
                    <button type="button" class="btn btn-primary" onclick="r48LoadTables()">Refresh Tables</button>
                </div>
                <div id="r48ConnOut" class="status-output"></div>
            </div>
        </div>

        <div class="accordion-item">
            <button class="accordion-toggle" type="button" onclick="toggleAccordion('r48-tables')">
                <span class="acc-icon">TB</span><span>Table Configuration &amp; Join Keys</span><span class="acc-chevron">v</span>
            </button>
            <div class="accordion-body" id="body-r48-tables" style="display:none">
                <div class="info-box info-box--red" style="margin-bottom:12px">
                    Tables auto-detected on connect. CRED and H16CRED both use <code>_001</code> as the credential code join key.
                </div>
                <div class="form-grid">
                    <div class="field-group">
                        <label>CRED Table (HEMIS ASCII)</label>
                        <select id="r48StudTable" onchange="r48LoadCols('stud',this.value)"></select>
                    </div>
                    <div class="field-group">
                        <label>H16CRED Table</label>
                        <select id="r48AuditTable" onchange="r48LoadCols('audit',this.value)"></select>
                    </div>
                    <div class="field-group">
                        <label>STUD join key</label>
                        <select id="r48StudKey"></select>
                    </div>
                    <div class="field-group">
                        <label>H16CRED join key</label>
                        <select id="r48AuditKey"></select>
                    </div>
                    <div class="field-group">
                        <label>CRED secondary join key <small>(optional &mdash; set this when the primary key repeats, e.g. one row per qualification)</small></label>
                        <select id="r48StudKey2"><option value="">None</option></select>
                    </div>
                    <div class="field-group">
                        <label>H16CRED secondary join key <small>(optional)</small></label>
                        <select id="r48AuditKey2"><option value="">None</option></select>
                    </div>
                </div>
                <div id="r48TableOut" class="status-output"></div>
            </div>
        </div>

        <div class="accordion-item">
            <button class="accordion-toggle" type="button" onclick="toggleAccordion('r48-colmap')">
                <span class="acc-icon">CM</span><span>Column Mapping</span><span class="acc-chevron">v</span>
            </button>
            <div class="accordion-body" id="body-r48-colmap" style="display:none">
                <div class="alert alert--info" style="margin-bottom:12px">
                    Map STUD columns to Audit columns for field-by-field comparison. Defaults match the standard HEMIS layout.
                    Connect and select a database to auto-populate.
                </div>
                <div id="r48ColPairs"></div>
                <button type="button" class="btn btn-secondary" style="margin-top:8px;font-size:.82rem" onclick="r48AddPair()">&#65291; Add pair</button>
            </div>
        </div>
    </div>
    }

    <div class="workspace-signoff-card">
        <div class="workspace-signoff-card__header">
            <div>
                <div class="workspace-signoff-card__title">Saved Workspace</div>
                <div class="workspace-signoff-card__subtitle">The last saved Rule 48 configuration, results, and signoffs reload here automatically.</div>
            </div>
            <div id="r48RunState" class="badge badge--neutral badge--sm">No saved run loaded</div>
        </div>
        <div id="workspaceInfo" class="alert alert--info">Select an engagement to load the saved Rule 48 workspace.</div>
        <div class="workspace-signoff-grid">
            <div>
                <div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Current Run</div>
                <div id="r48RunLabel">No saved run yet</div>
            </div>
            <div>
                <div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Status</div>
                <div id="r48StatusLabel">-</div>
            </div>
            <div>
                <div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Last Edited</div>
                <div id="r48EditedLabel">-</div>
            </div>
            <div>
                <div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Your Role</div>
                <div id="r48RoleLabel">@(string.IsNullOrWhiteSpace(currentSystemRole) ? "-" : currentSystemRole)</div>
            </div>
            <div class="field-group" style="grid-column:1/-1">
                <label for="r48SignoffComment">Signoff Comment</label>
                <textarea id="r48SignoffComment" rows="2" placeholder="Add the final review note confirming this validation is complete."></textarea>
            </div>
        </div>
        <div class="workspace-signoff-actions">
            @if (!isResultsOnlyRole)
            {
                <button class="btn btn-success" id="r48SaveBtn" onclick="r48SaveWorkspace()">Save Workspace</button>
            }
            <button class="btn btn-primary" id="r48SignoffBtn" onclick="r48SignOff()">Sign Off</button>
            <button class="btn btn-warning" id="r48RemoveSignoffBtn" onclick="r48RemoveSignoff()" style="display:none">Remove Signoff</button>
        </div>
    </div>

    <div class="action-bar">
        @if (!isResultsOnlyRole)
        {
            <button class="btn btn-info"    onclick="r48Verify()">Verify Tables</button>
            <button class="btn btn-success" onclick="r48Run()">&#9654; Run Rule 48</button>
            <button class="btn btn-primary" onclick="r48Sql()">Generate SQL</button>
        }
        <button class="btn btn-warning" id="r48DlAllBtn" onclick="r48DlAll()" disabled>Download All</button>
    </div>

    <div class="results-panel">
        <div class="results-tabs">
            <button class="tab-btn active" type="button" data-tab="r48-analysis"  onclick="r48Tab('r48-analysis')">Analysis</button>
            <button class="tab-btn"        type="button" data-tab="r48-flagged"   onclick="r48Tab('r48-flagged')">FLAGGED</button>
            <button class="tab-btn"        type="button" data-tab="r48-clear"     onclick="r48Tab('r48-clear')">CLEAR</button>
            <button class="tab-btn"        type="button" data-tab="r48-sql"       onclick="r48Tab('r48-sql')">SQL Code</button>
            <button class="tab-btn"        type="button" data-tab="r48-downloads" onclick="r48Tab('r48-downloads')">Downloads</button>
        </div>
        <div class="tab-pane active" data-tab-panel="r48-analysis">
            <div id="r48AnalysisPane"><div class="empty-state"><p>Run Rule 48 validation to see results here.</p></div></div>
        </div>
        <div class="tab-pane" data-tab-panel="r48-flagged">
            <div id="r48FlaggedPane"><div class="empty-state"><p>No flagged rows yet — run validation first.</p></div></div>
        </div>
        <div class="tab-pane" data-tab-panel="r48-clear">
            <div id="r48ClearPane"><div class="empty-state"><p>No clear rows yet — run validation first.</p></div></div>
        </div>
        <div class="tab-pane" data-tab-panel="r48-sql">
            <textarea id="r48SqlText" rows="20" readonly style="width:100%;font-family:monospace;font-size:12px"></textarea>
        </div>
        <div class="tab-pane" data-tab-panel="r48-downloads">
            <div class="alert alert--info" style="margin-bottom:12px">Download the full Rule 48 result set after running validation.</div>
            <div class="action-bar" style="justify-content:flex-start;margin:0">
                <button type="button" class="btn btn-info"      id="r48DlExcel">Excel</button>
                <button type="button" class="btn btn-info"      id="r48DlCsv">CSV (All)</button>
                <button type="button" class="btn btn-secondary" id="r48DlExcCsv">CSV (Exceptions)</button>
                <button type="button" class="btn btn-secondary" id="r48DlSql">SQL</button>
            </div>
        </div>
    </div>

    <div id="r48Spinner" class="spinner-overlay" style="display:none">
        <div class="spinner-box">
            <div class="spinner-ring"></div>
            <p id="r48SpinMsg">Processing...</p>
        </div>
    </div>
</div>

<form id="r48AntiForgery" method="post" style="display:none">@Html.AntiForgeryToken()</form>

<script>
window.toggleAccordion = window.toggleAccordion || function(s) {
    var b = document.getElementById('body-' + s);
    if (b) b.style.display = b.style.display === 'none' ? '' : 'none';
};

window.r48Tab = function(tab) {
    document.querySelectorAll('#app .results-panel .tab-btn').forEach(function(b) { b.classList.toggle('active', b.dataset.tab === tab); });
    document.querySelectorAll('#app .results-panel .tab-pane').forEach(function(p) { p.classList.toggle('active', p.dataset.tabPanel === tab); });
};

(function () {
    var API = '/Rule48';
    var ROLE = '@currentSystemRole';
    var IS_RESULTS_ONLY = @(isResultsOnlyRole.ToString().ToLowerInvariant());
    var TOKEN = (document.querySelector('#r48AntiForgery input[name="__RequestVerificationToken"]') || {}).value || '';

    var DEF_PAIRS = [
        { studCol: '_001', h16Col: '_001', label: 'Credential Code' },
        { studCol: '_030', h16Col: '_030', label: 'Course Code' },
        { studCol: '_036', h16Col: '_036', label: '_036' },
        { studCol: '_065', h16Col: '_065', label: '_065' }
    ];

    var st = {
        clientId: @(selectedClientId > 0 ? selectedClientId : 0),
        runId: null, summary: null,
        studCols: [], auditCols: [],
        pairs: [],
        isWorkspaceSaved: false, currentUserHasSignedOff: false, resultsVisible: false,
        currentUserEngagementRole: ''
    };

    function g(id)             { return document.getElementById(id); }
    function gv(id)            { var e = g(id); return e ? e.value : ''; }
    function esc(v)            { return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function fmt(n)            { return Number(n || 0).toLocaleString(); }
    function show(id, v)       { var e = g(id); if (e) e.style.display = v ? '' : 'none'; }
    function setHtml(id, html) { var e = g(id); if (e) e.innerHTML = html; }
    function spin(msg)         { var e = g('r48SpinMsg'); if (e) e.textContent = msg || 'Processing...'; show('r48Spinner', true); }
    function unspin()          { show('r48Spinner', false); }
    function setWs(msg, type)  { var e = g('workspaceInfo'); if (e) { e.className = 'alert alert--' + (type || 'info'); e.textContent = msg; } }
    function setStatus(id, msg, type) { var e = g(id); if (e) { e.className = 'alert alert--' + (type || 'info'); e.textContent = msg; } }

    function fillSel(id, items, selected) {
        var sel = typeof id === 'string' ? g(id) : id; if (!sel) return;
        sel.innerHTML = '';
        (items || []).forEach(function(item) {
            var o = document.createElement('option');
            o.value = o.textContent = item;
            if (selected && selected === item) o.selected = true;
            sel.appendChild(o);
        });
    }

    function post(url, body) {
        return fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
            body: JSON.stringify(body)
        }).then(function(r) { return r.json(); });
    }

    function setStatusBadge(status) {
        var b = g('r48StatusBadge'); if (!b) return;
        if (!status) { b.style.display = 'none'; return; }
        b.style.display = ''; b.textContent = status;
        b.className = 'rule-header__badge ' + (String(status).toUpperCase() === 'PASS' ? 'badge--pass' : 'badge--fail');
    }

    /* ── Pair Management ── */
    function renderPairs() {
        var box = g('r48ColPairs'); if (!box) return;
        box.innerHTML = '';
        if (!st.pairs || !st.pairs.length) st.pairs = DEF_PAIRS.slice();
        st.pairs.forEach(function(p, i) {
            var row = document.createElement('div'); row.className = 'r48-pair-row';
            row.innerHTML = '<span style="color:#888;font-size:.8rem">#' + (i + 1) + '</span>' +
                '<input type="text" placeholder="STUD col" value="' + esc(p.studCol) + '" oninput="r48PairSet(' + i + ',\'studCol\',this.value)">' +
                '<span style="color:#999">&harr;</span>' +
                '<input type="text" placeholder="Audit col" value="' + esc(p.h16Col) + '" oninput="r48PairSet(' + i + ',\'h16Col\',this.value)">' +
                '<input type="text" placeholder="Label" value="' + esc(p.label) + '" oninput="r48PairSet(' + i + ',\'label\',this.value)" style="max-width:130px">' +
                '<button class="r48-pair-del" onclick="r48RemovePair(' + i + ')">&#x2715;</button>';
            box.appendChild(row);
        });
    }

    window.r48PairSet = function(i, key, val) { if (st.pairs[i]) st.pairs[i][key] = val; };
    window.r48RemovePair = function(i) { st.pairs.splice(i, 1); renderPairs(); };
    window.r48AddPair = function() { st.pairs.push({ studCol: '', h16Col: '', label: '' }); renderPairs(); };

    /* -- Table Loading (this engagement's uploaded datasets) -- */
    window.r48LoadTables = function(options) {
        options = options || {};
        if (!st.clientId) return Promise.resolve(null);
        spin('Loading tables...');
        return post(API + '/GetTables', { clientId: st.clientId })
        .then(function(d) {
            unspin();
            if (!d.success) {
                setStatus('r48TableOut', d.error || 'Failed to load tables.', 'error');
                var alertEl = g('r48DatasetStatusAlert');
                if (alertEl) { alertEl.className = 'alert alert--error'; alertEl.textContent = d.error || 'Failed to load tables.'; }
                return null;
            }
            var tables = d.tables || [];
            fillSel('r48StudTable',  tables, options.preferredStudTable  || d.autoStudTable  || 'CRED');
            fillSel('r48AuditTable', tables, options.preferredAuditTable || d.autoH16Table || 'H16CRED');
            show('body-r48-tables', true); show('body-r48-colmap', true);
            if (!options.silent) setStatus('r48TableOut', 'Loaded ' + tables.length + ' tables. STUD and Audit auto-detected.', 'success');
            var alertEl2 = g('r48DatasetStatusAlert');
            if (alertEl2) { alertEl2.className = 'alert alert--success'; alertEl2.textContent = 'Loaded ' + tables.length + " table(s) from this engagement's dataset."; }
            if (!options.preservePairs) st.pairs = DEF_PAIRS.slice();
            return Promise.all([
                r48LoadColsInner('stud',  gv('r48StudTable'), options.preferredStudKey, options.preferredStudKey2),
                r48LoadColsInner('audit', gv('r48AuditTable'), options.preferredAuditKey, options.preferredAuditKey2)
            ]);
        }).then(function() { renderPairs(); return true; })
        .catch(function(e) { unspin(); setStatus('r48TableOut', e.message, 'error'); return null; });
    };

    function fillSecondaryKeySel(id, cols, preferred) {
        var sel = g(id); if (!sel) return;
        sel.innerHTML = '<option value="">None</option>';
        (cols || []).forEach(function(c) {
            var o = document.createElement('option');
            o.value = o.textContent = c;
            if (preferred && preferred === c) o.selected = true;
            sel.appendChild(o);
        });
    }

    function r48LoadColsInner(role, tableName, preferredKey, preferredKey2) {
        if (!tableName || !st.clientId) return Promise.resolve();
        return post(API + '/GetColumns', { clientId: st.clientId, tableName: tableName })
        .then(function(d) {
            if (!d.success) return;
            var cols = d.columns || [];
            if (role === 'stud')  { st.studCols  = cols; fillSel('r48StudKey',  cols, preferredKey || d.autoKey || '_007'); fillSecondaryKeySel('r48StudKey2', cols, preferredKey2); }
            if (role === 'audit') { st.auditCols = cols; fillSel('r48AuditKey', cols, preferredKey || d.autoKey || '_001'); fillSecondaryKeySel('r48AuditKey2', cols, preferredKey2); }
        });
    }

    window.r48LoadCols = function(role, tbl) { r48LoadColsInner(role, tbl); };

    window.r48Verify = function() {
        spin('Verifying tables...');
        post(API + '/VerifyTables', {
            clientId: st.clientId,
            studTable: gv('r48StudTable'), h16Table: gv('r48AuditTable'),
            studKey: gv('r48StudKey') || '_007', h16Key: gv('r48AuditKey') || '_001'
        }).then(function(d) {
            unspin();
            if (!d.success) { setStatus('r48TableOut', d.error || 'Verification failed.', 'error'); return; }
            setStatus('r48TableOut', 'CRED: ' + fmt(d.studCount) + ' rows | H16CRED: ' + fmt(d.h16Count) + ' rows', 'success');
        }).catch(function(e) { unspin(); setStatus('r48TableOut', e.message, 'error'); });
    };

    function buildReq() {
        return {
            clientId: st.clientId, runId: st.runId,
            studTable:  gv('r48StudTable')  || 'CRED',
            h16Table: gv('r48AuditTable') || 'H16CRED',
            studKey:    gv('r48StudKey')    || '_007',
            h16Key:   gv('r48AuditKey')   || '_001',
            studSecondaryKey: gv('r48StudKey2')  || null,
            h16SecondaryKey:  gv('r48AuditKey2') || null,
            pairs: st.pairs.filter(function(p) { return p.studCol && p.h16Col; })
        };
    }

    window.r48Run = function() {
        if (!st.clientId) { setWs('Select an engagement before running.', 'warning'); return; }
        spin('Running Rule 48 validation...');
        post(API + '/RunValidation', buildReq())
        .then(function(d) {
            unspin();
            if (!d.success) { setWs(d.error || 'Validation failed.', 'error'); return; }
            st.runId = d.savedRunId || st.runId;
            st.currentUserHasSignedOff = false; st.isWorkspaceSaved = false; st.resultsVisible = true;
            applySummary(d, false);
            setWs('Rule 48 complete. Total: ' + fmt(d.totalCount) + ' | Agree: ' + fmt(d.agreeCount) + ' | Exceptions: ' + fmt((d.disagreeCount || 0) + (d.missingCount || 0)) + '. Overall: ' + d.status, d.status === 'PASS' ? 'success' : 'warning');
            var dlBtn = g('r48DlAllBtn'); if (dlBtn) dlBtn.disabled = false;
        }).catch(function(e) { unspin(); setWs(e.message, 'error'); });
    };

    window.r48Sql = function() {
        spin('Generating SQL...');
        post(API + '/GenerateSql', buildReq()).then(function(d) {
            unspin();
            if (!d.success) { alert('Error: ' + (d.error || 'Failed.')); return; }
            var t = g('r48SqlText'); if (t) t.value = d.sql || '';
            r48Tab('r48-sql');
        }).catch(function(e) { unspin(); alert(e.message); });
    };

    function r48DownloadSaved(url, filename) {
        return window.downloadFileWithProgress({ url, method: 'GET', defaultFileName: filename, label: 'Downloading result' });
    }
    window.r48DlAll = function() { if (st.runId) r48DownloadSaved(API + '/DownloadExcel?runId=' + st.runId, 'Rule48_Run_' + st.runId + '.xlsx'); };

    /* ── Workspace ── */
    window.r48SaveWorkspace = function() {
        spin('Saving workspace...');
        post(API + '/SaveWorkspace', buildReq()).then(function(d) {
            unspin();
            if (!d.success) { setWs(d.error || 'Save failed.', 'error'); return; }
            if (d.workspace) applyWsMeta(d.workspace);
            setWs(d.message || 'Workspace saved.', d.signoffsCleared ? 'warning' : 'success');
        }).catch(function(e) { unspin(); setWs(e.message, 'error'); });
    };

    window.r48SignOff = function() {
        spin('Saving signoff...');
        post(API + '/SignOffWorkspace', { clientId: st.clientId, runId: st.runId, comment: gv('r48SignoffComment') })
        .then(function(d) {
            unspin();
            if (!d.success) { setWs(d.error || 'Signoff failed.', 'error'); return; }
            st.currentUserHasSignedOff = true;
            if (d.workspace) applyWsMeta(d.workspace);
            setWs(d.message || 'Signoff saved.', 'success'); updateButtons();
        }).catch(function(e) { unspin(); setWs(e.message, 'error'); });
    };

    window.r48RemoveSignoff = function() {
        spin('Removing signoff...');
        post(API + '/RemoveWorkspaceSignoff', { clientId: st.clientId, runId: st.runId, comment: '' })
        .then(function(d) {
            unspin();
            if (!d.success) { setWs(d.error || 'Failed.', 'error'); return; }
            st.currentUserHasSignedOff = false;
            if (d.workspace) applyWsMeta(d.workspace);
            setWs(d.message || 'Signoff removed.', 'warning'); updateButtons();
        }).catch(function(e) { unspin(); setWs(e.message, 'error'); });
    };

    function applyWsMeta(ws) {
        st.isWorkspaceSaved = !!ws.isWorkspaceSaved;
        st.currentUserHasSignedOff = !!ws.currentUserHasSignedOff;
        if (ws.currentUserEngagementRole) st.currentUserEngagementRole = ws.currentUserEngagementRole;
        var b   = g('r48RunState');    if (b)   b.textContent   = ws.runId ? 'Run #' + ws.runId : 'No saved run loaded';
        var rl  = g('r48RunLabel');    if (rl)  rl.textContent  = ws.runId ? 'Rule 48 Run #' + ws.runId : 'No saved run yet';
        var sl  = g('r48StatusLabel'); if (sl)  sl.textContent  = ws.currentStatus || ws.status || '-';
        var el  = g('r48EditedLabel'); if (el)  el.textContent  = ws.lastEditedAt ? new Date(ws.lastEditedAt).toLocaleString() : '-';
        var rl2 = g('r48RoleLabel');   if (rl2) rl2.textContent = ws.currentUserEngagementRole || ROLE || '-';
        var sc  = g('r48SignoffComment'); if (sc && ws.currentUserSignoffComment) sc.value = ws.currentUserSignoffComment;
        updateButtons();
    }

    function updateButtons() {
        var engRole = (st.currentUserEngagementRole || ROLE || '').toLowerCase();
        var nSys    = (ROLE || '').toLowerCase();
        var canEdit = !IS_RESULTS_ONLY && (nSys === 'dataanalyst' || engRole === 'dataanalyst');
        var canSign = !!st.runId && !!st.isWorkspaceSaved &&
            (engRole === 'dataanalyst' || (st.resultsVisible && (engRole === 'manager' || engRole === 'director')));
        var signed  = st.currentUserHasSignedOff;
        var sw = g('r48SaveBtn');   if (sw) sw.disabled = signed || !canEdit || !st.runId;
        var so = g('r48SignoffBtn');if (so) { so.disabled = signed || !canSign; so.textContent = signed ? 'Signed Off' : 'Sign Off'; }
        show('r48RemoveSignoffBtn', signed);
        window.ruleWorkspaceUi?.setReadonlyShell('app', signed);
        window.ruleWorkspaceUi?.setFormSectionReadonly('.accordion-stack', signed);
        window.ruleWorkspaceUi?.setButtonGroupReadonly(['.workspace-signoff-actions', '.action-bar'], signed, {
            allow: ['#r48RemoveSignoffBtn', '#r48DlAllBtn', '#r48DlExcel', '#r48DlCsv', '#r48DlExcCsv', '#r48DlSql']
        });
    }

    window.r48OnClientChange = function(val) {
        st.clientId = parseInt(val) || 0;
        if (!st.clientId) { setWs('Select an engagement to load the saved Rule 48 workspace.', 'info'); return; }
        loadWorkspace();
    };

    function loadWorkspace() {
        if (!st.clientId) return;
        setWs('Loading saved workspace...', 'info');
        (window.fetchJsonWithProgress || function(url, opts) { return fetch(url, opts).then(function(r) { return r.json(); }); })(API + '/GetWorkspaceState?clientId=' + st.clientId, { method: 'GET' })
        .then(function(d) {
            if (!d.success) { setWs(d.error || 'Failed to load workspace.', 'error'); return; }
            applyWorkspace(d.workspace, d.resultsVisible);
        }).catch(function(e) { setWs(e.message, 'error'); });
    }

    function applyWorkspace(ws, resultsVisible) {
        var datasetsLink = g('r48DatasetsLink');
        if (datasetsLink) datasetsLink.href = st.clientId ? '/EngagementDatasets?clientId=' + st.clientId : '#';

        if (!ws) {
            st.runId = null; st.summary = null; st.isWorkspaceSaved = false;
            st.currentUserHasSignedOff = false; st.resultsVisible = false; st.currentUserEngagementRole = '';
            setWs('No saved Rule 48 workspace for this engagement yet.', 'info');
            var b   = g('r48RunState');    if (b)   b.textContent   = 'No saved run loaded';
            var rl  = g('r48RunLabel');    if (rl)  rl.textContent  = 'No saved run yet';
            var sl  = g('r48StatusLabel'); if (sl)  sl.textContent  = '-';
            var el  = g('r48EditedLabel'); if (el)  el.textContent  = '-';
            st.pairs = DEF_PAIRS.slice(); renderPairs();
            applySummary(null, false); updateButtons();
            if (!IS_RESULTS_ONLY) r48LoadTables().catch(function() {});
            return;
        }
        st.runId = ws.runId || null;
        st.isWorkspaceSaved = !!ws.isWorkspaceSaved;
        st.currentUserHasSignedOff = !!ws.currentUserHasSignedOff;
        st.resultsVisible = !!resultsVisible;
        st.currentUserEngagementRole = ws.currentUserEngagementRole || '';

        applyWsMeta(ws);
        var sc = g('r48SignoffComment'); if (sc && ws.currentUserSignoffComment) sc.value = ws.currentUserSignoffComment;

        st.pairs = (ws.summary && ws.summary.reconc && ws.summary.reconc.pairs && ws.summary.reconc.pairs.length) ? ws.summary.reconc.pairs.slice() : DEF_PAIRS.slice();

        if (!IS_RESULTS_ONLY) {
            r48LoadTables({
                preferredStudTable: ws.studTable || '',
                preferredAuditTable: ws.h16Table || '',
                preferredStudKey: ws.studKey || '',
                preferredAuditKey: ws.h16Key || '',
                preferredStudKey2: ws.studSecondaryKey || '',
                preferredAuditKey2: ws.h16SecondaryKey || '',
                preservePairs: true,
                silent: true
            }).catch(function() {});
        }

        if (!resultsVisible) { setWs('Saved Rule 48 results are not available for your role.', 'info'); applySummary(null, false); updateButtons(); return; }
        setWs(ws.summary ? 'Saved Rule 48 workspace loaded.' : 'Rule 48 workspace loaded. Run validation to generate results.', 'success');
        if (ws.summary) applySummary(ws.summary, true);
        else { applySummary(null, false); updateButtons(); }
        var dlBtn = g('r48DlAllBtn'); if (dlBtn) dlBtn.disabled = !ws.runId;
    }

    /* ── Rendering ── */
    function applySummary(summary, fromWs) {
        st.summary = summary;
        if (summary && !fromWs) st.runId = summary.savedRunId || st.runId;
        setStatusBadge(summary ? summary.status : '');
        renderAnalysis(summary);
        renderReconc(summary ? summary.reconc : null);
        if (summary && st.runId) {
            var dlE = g('r48DlExcel');  if (dlE) dlE.onclick = function() { r48DownloadSaved(API + '/DownloadExcel?runId=' + st.runId, 'Rule48_Run_' + st.runId + '.xlsx'); };
            var dlC = g('r48DlCsv');    if (dlC) dlC.onclick = function() { r48DownloadSaved(API + '/DownloadCsv?runId=' + st.runId, 'Rule48_Run_' + st.runId + '.csv'); };
            var dlX = g('r48DlExcCsv');if (dlX) dlX.onclick = function() { r48DownloadSaved(API + '/DownloadExceptionsCsv?runId=' + st.runId, 'Rule48_Run_' + st.runId + '_Exceptions.csv'); };
            var dlS = g('r48DlSql');    if (dlS) dlS.onclick = function() { r48DownloadSaved(API + '/DownloadSql?runId=' + st.runId, 'Rule48_Run_' + st.runId + '.sql'); };
        }
        updateButtons();
    }

    function renderAnalysis(s) {
        var pane = g('r48AnalysisPane'); if (!pane) return;
        if (!s) { pane.innerHTML = '<div class="empty-state"><p>Run Rule 48 validation to see results here.</p></div>'; return; }
        var sc = String(s.status || '').toUpperCase() === 'PASS' ? 'badge--pass' : 'badge--fail';
        pane.innerHTML =
            '<div class="stats-grid" style="margin-bottom:20px">' +
            statCard('Total', fmt(s.totalCount || 0), '') +
            statCard('Agree', fmt(s.agreeCount || 0), 'pass') +
            statCard('Disagree', fmt(s.disagreeCount || 0), s.disagreeCount > 0 ? 'fail' : '') +
            statCard('Missing', fmt(s.missingCount || 0), s.missingCount > 0 ? 'fail' : '') +
            statCard('Exception Rate', Number(s.exceptionRate || 0).toFixed(2) + '%', s.exceptionRate > 0 ? 'fail' : 'pass') +
            statCard('Overall', '<span class="badge ' + sc + '">' + esc(s.status) + '</span>', '') +
            '</div>' +
            '<div class="card" style="padding:16px"><div class="form-grid">' +
            '<div><div class="stat-label">CRED Table</div><div>' + esc(s.studTable || '') + '</div></div>' +
            '<div><div class="stat-label">H16CRED Table</div><div>' + esc(s.h16Table || '') + '</div></div>' +
            '<div><div class="stat-label">Timestamp</div><div>' + esc(s.timestamp || '') + '</div></div>' +
            '</div></div>';
    }

    function statCard(label, value, mod) {
        var cls = mod === 'pass' ? ' stat-card--pass' : mod === 'fail' ? ' stat-card--fail' : '';
        return '<div class="stat-card' + cls + '"><div class="stat-card__label">' + label + '</div><div class="stat-card__value">' + value + '</div></div>';
    }

    function renderReconc(reconc) {
        if (!reconc) {
            setHtml('r48FlaggedPane', '<div class="empty-state"><p>Run validation first.</p></div>');
            setHtml('r48ClearPane',   '<div class="empty-state"><p>Run validation first.</p></div>');
            return;
        }
        var pairs   = reconc.pairs || [];
        var excRows = reconc.exceptionRows || [];
        var agrRows = reconc.rows || [];

        setHtml('r48FlaggedPane',
            '<div class="card" style="padding:12px;margin-bottom:10px;border-left:4px solid #C0392B">' +
            '<strong>FLAGGED</strong>: ' + fmt(reconc.disagreeCount || 0) + ' DISAGREE + ' + fmt(reconc.missingCount || 0) + ' MISSING rows.' +
            '</div>' + buildTable(excRows, pairs, 'No exceptions — all students agree.'));

        setHtml('r48ClearPane',
            '<div class="card" style="padding:12px;margin-bottom:10px;border-left:4px solid #1E8449">' +
            '<strong>CLEAR</strong>: ' + fmt(reconc.agreeCount || 0) + ' students agree' +
            (agrRows.length < (reconc.agreeCount || 0) ? ' (sample of ' + fmt(agrRows.length) + ' shown)' : '') + '.' +
            '</div>' + buildTable(agrRows, pairs, 'No clear rows in this run.'));
    }

    function buildTable(rows, pairs, emptyMsg) {
        if (!rows || !rows.length) return '<div class="empty-state"><p>' + emptyMsg + '</p></div>';
        var hdrs = pairs.map(function(p) {
            return '<th style="background:#1565A6">CRED ' + esc(p.studCol || p.StudCol || '') + '</th>' +
                   '<th style="background:#0D6E2E">H16CRED ' + esc(p.h16Col || p.H16Col || '') + '</th>' +
                   '<th>Match</th>';
        }).join('');
        var body = rows.map(function(r) {
            var ov = r.overallResult || r.OverallResult || '';
            var cls = ov === 'AGREE' ? 'agree' : ov === 'DISAGREE' ? 'disagree' : 'missing';
            var badge = ov === 'AGREE' ? '<span class="r48-agree">&#10003; AGREE</span>' : ov === 'DISAGREE' ? '<span class="r48-exc">&#x2717; DISAGREE</span>' : '<span class="r48-miss">? MISSING</span>';
            var cells = pairs.map(function(p) {
                var lbl = p.label || p.Label || p.studCol || '';
                var fMap = r.fields || {};
                var f = fMap[lbl] || fMap[lbl.charAt(0).toLowerCase() + lbl.slice(1)];
                if (!f) {
                    var lbl_lc = lbl.toLowerCase();
                    var fKeys = Object.keys(fMap);
                    for (var ki = 0; ki < fKeys.length; ki++) {
                        if (fKeys[ki].toLowerCase() === lbl_lc) { f = fMap[fKeys[ki]]; break; }
                    }
                }
                f = f || {};
                var sv = f.studValue != null ? f.studValue : (f.StudValue != null ? f.StudValue : '—');
                var av = f.h16Value != null ? f.h16Value : (f.H16Value != null ? f.H16Value : '—');
                var matchVal = f.match || f.Match || 'MISSING';
                var mi = matchVal === 'AGREE' ? '<span style="color:#1E8449">&#10003;</span>' : matchVal === 'DISAGREE' ? '<span style="color:#C0392B">&#x2717;</span>' : '<span style="color:#E67E22">?</span>';
                return '<td>' + esc(sv) + '</td><td class="oc">' + esc(av) + '</td><td>' + mi + '</td>';
            }).join('');
            return '<tr class="' + cls + '"><td style="font-size:.73rem;color:#777">' + (r.rowNumber || r.RowNumber || '') + '</td><td style="font-weight:600;font-family:monospace">' + esc(r.studentRef || r.StudentRef || r.staffRef || '') + '</td>' + cells + '<td>' + badge + '</td><td style="font-size:.71rem;text-align:left;max-width:230px">' + esc(r.disagreeDetail || r.DisagreeDetail || '') + '</td></tr>';
        }).join('');
        return '<div style="overflow-x:auto"><table class="r48-tbl"><thead><tr><th>#</th><th>Student No</th>' + hdrs + '<th>Result</th><th>Detail</th></tr></thead><tbody>' + body + '</tbody></table></div>';
    }

    /* ── Init ── */
    st.pairs = DEF_PAIRS.slice();
    renderPairs();
    applySummary(null, false);
    updateButtons();
    if (st.clientId) loadWorkspace();
        const __ruleRApiBase = typeof apiBasePath !== 'undefined'
        ? apiBasePath
        : (typeof apiBase !== 'undefined'
            ? apiBase
            : (typeof API !== 'undefined'
                ? API
                : ((window.location.pathname.match(/^\/Rule\d+/i) || [null])[0])));
    const __ruleRRequestBuilder = typeof getRequest === 'function' ? getRequest : (typeof buildRequest === 'function' ? buildRequest : (typeof buildReq === 'function' ? buildReq : null));
    const __ruleRPost = typeof postJson === 'function' ? postJson : (typeof post === 'function' ? post : null);
    if (__ruleRApiBase && __ruleRRequestBuilder && __ruleRPost && window.ruleRScriptUi) {
        window.ruleRScriptUi.install({
            apiBase: __ruleRApiBase,
            requestBuilder: __ruleRRequestBuilder,
            postJson: __ruleRPost,
            showSpinner: typeof showSpinner === 'function' ? showSpinner : (typeof spin === 'function' ? spin : null),
            hideSpinner: typeof hideSpinner === 'function' ? hideSpinner : (typeof unspin === 'function' ? unspin : null)
        });
    }
})();
</script>

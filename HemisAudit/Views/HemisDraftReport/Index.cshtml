@{
    ViewData["Title"] = "HEMIS Draft Report";
}

<div class="wp-page">
    <div class="wp-hero">
        <div class="wp-hero-inner">
            <div class="wp-hero-label">Draft Report</div>
            <h1 class="wp-hero-title">TUT AUP — HEMIS</h1>
            <p class="wp-hero-sub">
                Agreed-upon Procedures Report on the Higher Education Management Information System (HEMIS)<br />
                for the period ending xx December xxxx
            </p>
        </div>
    </div>

    <div class="wp-body">
        <div class="wp-note-banner">
            Please note that this Draft Report should be used as a guide only and may be amended at any time,
            as it was developed for guidance purposes.
        </div>

        <div class="wp-section">
            <div class="wp-section-head">About this Report</div>
            <table class="wp-kv-table">
                <tr><td>Addressed to</td><td>The Council, ........ University</td></tr>
                <tr><td>Issued by</td><td>Auditor Firm Name</td></tr>
                <tr><td>Signatory</td><td>Full Name— Director, Registered Auditor</td></tr>
                <tr><td>Date</td><td>xx July xxxx</td></tr>
                <tr><td>Standard</td><td>ISRS 4400 (Revised), Agreed-Upon Procedures Engagements</td></tr>
                <tr><td>Engagement letter</td><td>xx July xxxx</td></tr>
                <tr><td>Sections covered</td><td>Section 3 (SQLVALPAC files) · Section 4 (Initial checks) · Section 5 (Qualification file) · Section 6 (Course file) · Section 7 (Credit value file) · Section 8 (Student file) · Section 9 (Course Registration file) · Section 11 (Staff Profile) · Section 12 (Data change requests) · Section 13 (Attachments)</td></tr>
                <tr><td>Exception noted</td><td>Exception will be captured.</td></tr>
            </table>
        </div>

        <div class="wp-section">
            <div class="wp-section-head">Download</div>
            <p style="color:#111;margin-bottom:16px;">
                Download the full Word document to view all procedures and findings with complete letterhead, management comments, and signature block.
            </p>
            <a href="/HemisDraftReport/Download"
               class="btn btn-primary"
               style="display:inline-flex;align-items:center;gap:8px;text-decoration:none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <polyline points="7 10 12 15 17 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <line x1="12" y1="15" x2="12" y2="3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                Download Word Document (.docx)
            </a>
        </div>
    </div>
</div>

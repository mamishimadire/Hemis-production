@model HemisAudit.ViewModels.Rule46RunReviewViewModel
@{
    ViewData["Title"] = $"Rule 46 Run {Model.RunId}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdmin = ViewBag.IsAdmin is bool admin && admin;
    var canDownload = ViewBag.CanDownloadSavedRun is bool allowed && allowed;
    var canManageEngagement = ViewBag.CanManageEngagement is bool me && me;
    var canOpenWorkspace = ViewBag.CanOpenWorkspace is bool owb && owb;
    var isArchived = ViewBag.IsArchived is bool arch && arch;
    var moduleNavigation = ViewBag.ModuleNavigation as HemisAudit.ViewModels.ModuleSequenceNavigationViewModel;
    var s = Model.Summary!;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert--success" style="margin-bottom:16px">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert--error" style="margin-bottom:16px">@TempData["Error"]</div>
}

@if (moduleNavigation != null)
{
    @await Html.PartialAsync("_ModuleSequenceNav", moduleNavigation)
}

<style>
    .viz-grid { display:grid; gap:16px; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); }
    .viz-card { background:#fff; border:1px solid #e5e7eb; border-radius:18px; padding:20px; box-shadow:0 18px 40px rgba(15,23,42,.06); }
    .code-panel { background:#0f172a; border-radius:18px; color:#e2e8f0; overflow:auto; padding:18px; }
    .code-panel pre { margin:0; white-space:pre-wrap; word-break:break-word; }
    .r46-tbl { border-collapse: collapse; width: 100%; font-size: .82rem; }
    .r46-tbl th { background: #1565A6; color: #fff; padding: 5px 8px; border: 1px solid #bbb; white-space: nowrap; text-align: center; }
    .r46-tbl td { padding: 4px 7px; border: 1px solid #ddd; vertical-align: middle; }
    .r46-tbl tr.pass-row { background: #F1F8E9; }
    .r46-tbl tr.fail-row { background: #FFEBEE; }
    .r46-pass { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: .74rem; font-weight: 700; background: #E8F5E9; color: #1E8449; }
    .r46-fail { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: .74rem; font-weight: 700; background: #FFEBEE; color: #C0392B; }
</style>

<div class="page-header">
    <div>
        <h1>Rule 46 — Foundation Student Chain Validation</h1>
        <p>
            @Model.EngagementName
            <span style="padding:0 8px">|</span>
            @Model.MaconomyNumber
            <span style="padding:0 8px">|</span>
            Run #@Model.RunId
            <span style="padding:0 8px">|</span>
            @s.Timestamp
        </p>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
        @if (canOpenWorkspace)
        {
            <a href="/Rule46?clientId=@Model.ClientId" class="btn btn-primary">Open Workspace</a>
        }
        @if (canManageEngagement)
        {
            <a href="/Clients/Details/@Model.ClientId" class="btn btn-secondary">Manage Engagement</a>
        }
    </div>
</div>

@if (!Model.IsCurrentRun)
{
    <div class="alert alert--warning" style="margin-bottom:16px">
        This is a historical run. A newer run exists for this engagement.
        <a href="/Rule46?clientId=@Model.ClientId">Open current workspace</a>
    </div>
}

@if (isArchived)
{
    <div class="alert alert--warning" style="margin-bottom:16px">
        This engagement is archived. Results are read-only; signoff and removal are disabled.
    </div>
}

<!-- Status Summary -->
<div class="results-card" style="margin-bottom:24px">
    <div class="viz-grid">
        <div class="viz-card">
            <div style="font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;margin-bottom:6px">Total Validated</div>
            <div style="font-size:28px;font-weight:800">@s.TotalValidated.ToString("N0")</div>
        </div>
        <div class="viz-card" style="border-left:4px solid #22C55E">
            <div style="font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;margin-bottom:6px">PASS</div>
            <div style="font-size:28px;font-weight:800;color:#166534">@s.PassCount.ToString("N0")</div>
        </div>
        <div class="viz-card" style="border-left:4px solid #EF4444">
            <div style="font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;margin-bottom:6px">FAIL</div>
            <div style="font-size:28px;font-weight:800;color:#C62828">@s.FailCount.ToString("N0")</div>
        </div>
        <div class="viz-card" style="border-left:4px solid @(s.Status == "PASS" ? "#22C55E" : "#EF4444")">
            <div style="font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;margin-bottom:6px">Status</div>
            <div style="font-size:28px;font-weight:800;color:@(s.Status == "PASS" ? "#166534" : "#C62828")">@s.Status</div>
            <div style="font-size:11px;color:#64748b">Rate: @s.ExceptionRate.ToString("F2")%</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(s.Warning))
{
    <div class="alert alert--info" style="margin-bottom:16px">@s.Warning</div>
}

<!-- Tabs -->
<div class="results-panel">
    <div class="results-tabs">
        <button class="tab-btn active" onclick="switchTab('results')">Results (@s.ValidationRows.Count.ToString("N0"))</button>
        <button class="tab-btn" onclick="switchTab('config')">Configuration</button>
        <button class="tab-btn" onclick="switchTab('signoffs')">Signoffs</button>
        <button class="tab-btn" onclick="switchTab('sql')">SQL Code</button>
        @if (canDownload)
        {
            <button class="tab-btn" onclick="switchTab('downloads')">Downloads</button>
        }
    </div>

    <!-- Results -->
    <div class="tab-pane active" id="tab-results">
        <h3 style="margin-bottom:1rem">Validation Results</h3>
        @if (!s.ValidationRows.Any())
        {
            <div class="alert alert--info">No validation rows are available for this saved run.</div>
        }
        else
        {
            <div class="results-table-shell">
                <div class="table-wrapper" style="overflow-x:auto">
                    <table class="r46-tbl">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>STUD Key</th>
                                <th>STUD _008</th>
                                <th>STUD _007</th>
                                <th>STUD _010</th>
                                <th>STUD _012</th>
                                <th>STUD _026</th>
                                <th>STUD.@s.StudFilterCol</th>
                                <th>QUAL Key</th>
                                <th>QUAL Name</th>
                                <th>PQM Name</th>
                                <th>Result</th>
                                <th>Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in s.ValidationRows)
                            {
                                var isPass = string.Equals(row.ValidationResult, "PASS", StringComparison.OrdinalIgnoreCase);
                                <tr class="@(isPass ? "pass-row" : "fail-row")">
                                    <td>@row.RowNumber</td>
                                    <td><strong>@row.StudId</strong></td>
                                    <td>@row.StudentId</td>
                                    <td>@row.Stud007</td>
                                    <td>@row.Stud010</td>
                                    <td>@row.Stud012</td>
                                    <td>@row.Stud026</td>
                                    <td>@row.StudFilterValue</td>
                                    <td>@row.QualId</td>
                                    <td>@row.QualName</td>
                                    <td>@row.PqmName</td>
                                    <td>
                                        @if (isPass)
                                        {
                                            <span class="r46-pass">&#10003; PASS</span>
                                        }
                                        else
                                        {
                                            <span class="r46-fail">&#10007; FAIL</span>
                                        }
                                    </td>
                                    <td style="font-size:.75rem">@row.ResultDetail</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (s.ValidationRows.Count < s.TotalValidated)
                {
                    <div class="table-footer">Showing @s.ValidationRows.Count of @s.TotalValidated.ToString("N0") validated rows. Download the Excel or CSV for the full population.</div>
                }
            </div>
        }
    </div>

    <!-- Configuration -->
    <div class="tab-pane" id="tab-config">
        <h3 style="margin-bottom:1rem">Run Configuration</h3>
        <table class="data-table">
            <tbody>
                <tr><td style="font-weight:600">STUD Table</td><td>@s.StudTable</td></tr>
                <tr><td style="font-weight:600">STUD Qualification Key</td><td>@s.StudKey</td></tr>
                <tr><td style="font-weight:600">STUD ID Column</td><td>@s.StudIdCol</td></tr>
                <tr><td style="font-weight:600">STUD _007 Column</td><td>@s.Stud007Col</td></tr>
                <tr><td style="font-weight:600">STUD _010 Column</td><td>@s.Stud010Col</td></tr>
                <tr><td style="font-weight:600">STUD _012 Column</td><td>@s.Stud012Col</td></tr>
                <tr><td style="font-weight:600">STUD _026 Column</td><td>@s.Stud026Col</td></tr>
                <tr><td style="font-weight:600">Foundation Filter</td><td>@(s.StudTable + "." + s.StudFilterCol) = '@s.StudFilterValue'</td></tr>
                <tr><td style="font-weight:600">QUAL Table</td><td>@s.QualTable</td></tr>
                <tr><td style="font-weight:600">QUAL Key Column</td><td>@s.QualKey</td></tr>
                <tr><td style="font-weight:600">QUAL Name Column</td><td>@s.QualNameCol</td></tr>
                <tr><td style="font-weight:600">PQM Table</td><td>@s.PqmTable</td></tr>
                <tr><td style="font-weight:600">PQM Qualification Name Column</td><td>@s.PqmNameCol</td></tr>
                <tr><td style="font-weight:600">Run Date</td><td>@s.Timestamp</td></tr>
                <tr><td style="font-weight:600">Run ID</td><td>#@Model.RunId</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Signoffs -->
    <div class="tab-pane" id="tab-signoffs">
        <h3 style="margin-bottom:1rem">Signoffs</h3>
        @if (!Model.Signoffs.Any())
        {
            <div class="alert alert--info">No signoffs recorded for this run yet.</div>
        }
        else
        {
            <div class="results-table-shell">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead><tr><th>Role</th><th>Reviewer</th><th>Comment</th><th>Signed Off At</th><th>Your Record</th></tr></thead>
                        <tbody>
                            @foreach (var so in Model.Signoffs)
                            {
                                <tr class="@(so.IsCurrentUser ? "row-highlight" : "")">
                                    <td><span class="badge badge--neutral badge--sm">@so.SignoffRole</span></td>
                                    <td>@so.ReviewerName <small style="color:#64748b">@so.ReviewerEmail</small></td>
                                    <td>@so.Comment</td>
                                    <td>@so.SignedOffAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(so.IsCurrentUser ? "✔" : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (Model.IsCurrentRun && !isArchived)
        {
            @if (Model.CanCurrentUserSignOff && !Model.CurrentUserHasSignedOff)
            {
                <form method="post" action="/Rule46/AddSignoff" style="margin-top:1.5rem">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="RunId" value="@Model.RunId" />
                    <div class="field-group" style="max-width:600px">
                        <label>Signoff Comment</label>
                        <textarea name="Comment" rows="3" placeholder="Enter your review comment..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary" style="margin-top:0.75rem">Sign Off Run #@Model.RunId</button>
                </form>
            }
            @if (Model.CurrentUserHasSignedOff)
            {
                <form method="post" action="/Rule46/RemoveSignoff" style="margin-top:1rem"
                      onsubmit="return confirm('Are you sure you want to remove your signoff from this run?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="runId" value="@Model.RunId" />
                    <button type="submit" class="btn btn-warning">Remove My Signoff</button>
                </form>
            }
        }
    </div>

    <!-- SQL Code -->
    <div class="tab-pane" id="tab-sql">
        <h3 style="margin-bottom:1rem">Generated SQL</h3>
        <div class="code-panel">
            <pre>@Model.GeneratedSql</pre>
        </div>
    </div>

    <!-- Downloads -->
    @if (canDownload)
    {
        <div class="tab-pane" id="tab-downloads">
            <h3 style="margin-bottom:1rem">Download Run #@Model.RunId</h3>
            <div class="download-buttons download-buttons--wide">
                <a href="/Rule46/DownloadExcel?runId=@Model.RunId" class="btn btn-success">Excel</a>
                <a href="/Rule46/DownloadCsv?runId=@Model.RunId" class="btn btn-info">Full CSV</a>
                <a href="/Rule46/DownloadSql?runId=@Model.RunId" class="btn btn-primary">SQL Script</a>
            </div>
        </div>
    }
</div>

<script>
function switchTab(name) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    const btn = document.querySelector(`.tab-btn[onclick="switchTab('${name}')"]`);
    if (btn) btn.classList.add('active');
    const panel = document.getElementById(`tab-${name}`);
    if (panel) panel.classList.add('active');
}
</script>

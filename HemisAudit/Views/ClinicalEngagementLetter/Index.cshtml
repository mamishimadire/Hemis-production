@{
    ViewData["Title"] = "Clinical Training Engagement Letter";
}

<div class="wp-page">
    <div class="wp-hero">
        <div class="wp-hero-inner">
            <div class="wp-hero-label">Engagement Letter</div>
            <h1 class="wp-hero-title">Clinical Training AUP Engagement Letter</h1>
            <p class="wp-hero-sub">
                Clinical Training Enrolment – Agreed Upon Procedures<br />
                for the period ending xx December xxxx
            </p>
        </div>
    </div>

    <div class="wp-body">
        <div class="wp-note-banner">
            Please note that this Engagement letter should be used as a guide only and may be amended at any time,
            as it was developed for guidance purposes.
        </div>

        <div class="wp-section">
            <div class="wp-section-head">About this Engagement Letter</div>
            <table class="wp-kv-table">
                <tr><td>Addressed to</td><td>The Chief Financial Officer (CFO), Tshwane University of Technology</td></tr>
                <tr><td>Issued by</td><td>SizweNtsalubaGobodo Grant Thornton</td></tr>
                <tr><td>Signatory</td><td>Mamishi CA(SA) RA — Division: Assurance</td></tr>
                <tr><td>Date</td><td>20 May 2026</td></tr>
                <tr><td>Subject</td><td>Clinical Training Enrolment – Agreed Upon Procedures for the period ending 31 December 2025</td></tr>
                <tr><td>Standard</td><td>ISRS 4400 (Revised), Agreed-Upon Procedures Engagements</td></tr>
                <tr><td>Scope</td><td>Procedures 1–9: WIL List · HEMIS headcount data · Screenshots · Student sample · Evidence inspection · Programme confirmation · Accreditation · Prospectus · Master's registration</td></tr>
                <tr><td>Sections</td><td>29 sections including Section 10: Usage of AI Tools, Section 29: Acceptance of terms</td></tr>
            </table>
        </div>

        <div class="wp-section">
            <div class="wp-section-head">Download</div>
            <p style="color:#111;margin-bottom:16px;">
                Download the full Word document to view all engagement terms including scope, fee schedule, AI tools policy, and acceptance block.
            </p>
            <a href="/ClinicalEngagementLetter/Download"
               class="btn btn-primary"
               style="display:inline-flex;align-items:center;gap:8px;text-decoration:none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <polyline points="7 10 12 15 17 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <line x1="12" y1="15" x2="12" y2="3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                Download Word Document (.docx)
            </a>
        </div>
    </div>
</div>

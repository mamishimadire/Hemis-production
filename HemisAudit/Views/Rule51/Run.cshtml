@model HemisAudit.ViewModels.Rule51RunReviewViewModel
@{
    ViewData["Title"] = $"Rule 51 Run {Model.RunId}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canDownload = ViewBag.CanDownloadSavedRun is bool d && d;
    var canOpenWorkspace = ViewBag.CanOpenWorkspace is bool o && o;
    var isArchived = ViewBag.IsArchived is bool a && a;
    var moduleNavigation = ViewBag.ModuleNavigation as HemisAudit.ViewModels.ModuleSequenceNavigationViewModel;
    var mappings = Model.Summary.ColumnMappings?.Any() == true
        ? Model.Summary.ColumnMappings
        : new List<HemisAudit.ViewModels.Rule51ColumnMapping>
        {
            new() { ValpacColumn = Model.Summary.ValpacCol007, ProdColumn = Model.Summary.ProdColStNo, Label = "Student No" },
            new() { ValpacColumn = Model.Summary.ValpacCol008, ProdColumn = Model.Summary.ProdColIdNo, Label = "ID No" },
            new() { ValpacColumn = Model.Summary.ValpacCol001, ProdColumn = Model.Summary.ProdColQual, Label = "Qualification" },
            new() { ValpacColumn = Model.Summary.ValpacColYear, ProdColumn = Model.Summary.ProdColYear, Label = "Year" }
        };
    var previewWidth = Math.Max(900, (mappings.Count * 180 * 2) + 220);
    string ValpacAlias(int index) => $"VALPAC_COL_{index + 1}";
    string ProdAlias(int index) => $"PROD_COL_{index + 1}";
    string MappingLabel(HemisAudit.ViewModels.Rule51ColumnMapping mapping, bool useProdColumn = false)
    {
        var column = useProdColumn ? mapping.ProdColumn : mapping.ValpacColumn;
        return string.IsNullOrWhiteSpace(mapping.Label) || string.Equals(mapping.Label, column, StringComparison.OrdinalIgnoreCase)
            ? column
            : $"{mapping.Label} [{column}]";
    }
}

@if (TempData["Success"] != null)
{
    <div class="alert alert--success" style="margin-bottom:16px">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert--error" style="margin-bottom:16px">@TempData["Error"]</div>
}

@if (moduleNavigation != null)
{
    @await Html.PartialAsync("_ModuleSequenceNav", moduleNavigation)
}

<div class="page-header">
    <div>
        <h1>Rule 51 — Saved Run #@Model.RunId</h1>
        <p>@Model.EngagementName &nbsp;|&nbsp; @Model.MaconomyNumber</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        @if (canOpenWorkspace)
        {
            <a href="/Rule51?clientId=@Model.ClientId" class="btn btn-secondary">Open Workspace</a>
        }
        @if (canDownload)
        {
            <a href="/Rule51/DownloadSavedExcel?runId=@Model.RunId" class="btn btn-info">Download Excel</a>
            <a href="/Rule51/DownloadSavedCsv?runId=@Model.RunId" class="btn btn-info">Full CSV</a>
            <a href="/Rule51/DownloadSavedSql?runId=@Model.RunId" class="btn btn-secondary">Download SQL</a>
        }
    </div>
</div>

<div class="card" style="padding:20px;margin-bottom:20px">
    <h3 class="section-title" style="margin-top:0">Run Summary</h3>
    <div class="form-grid">
        <div><div style="color:var(--text-muted);font-size:12px;text-transform:uppercase;font-weight:700">VALPAC Table</div><div>@Model.Summary.ValpacTable</div></div>
        <div><div style="color:var(--text-muted);font-size:12px;text-transform:uppercase;font-weight:700">PRODUCTION Table</div><div>@Model.Summary.ProdTable</div></div>
        <div><div style="color:var(--text-muted);font-size:12px;text-transform:uppercase;font-weight:700">Column Mapping</div><div style="font-size:12px">@Model.Summary.TableLinkageText</div></div>
        <div><div style="color:var(--text-muted);font-size:12px;text-transform:uppercase;font-weight:700">Timestamp</div><div>@Model.Summary.Timestamp</div></div>
        <div><div style="color:var(--text-muted);font-size:12px;text-transform:uppercase;font-weight:700">Status</div><div><span class="badge @(Model.Summary.Status == "PASS" ? "badge--pass" : "badge--fail")">@Model.Summary.Status</span></div></div>
    </div>
    <div class="stats-grid" style="margin-top:16px">
        <div class="stat-card"><div class="stat-card__label">VALPAC Records</div><div class="stat-card__value">@Model.Summary.ValpacRecordCount.ToString("N0")</div></div>
        <div class="stat-card"><div class="stat-card__label">PRODUCTION Records</div><div class="stat-card__value">@Model.Summary.ProdRecordCount.ToString("N0")</div></div>
        <div class="stat-card"><div class="stat-card__label">Total Tested</div><div class="stat-card__value">@Model.Summary.TotalValidated.ToString("N0")</div></div>
        <div class="stat-card stat-card--pass"><div class="stat-card__label">Found in PRODUCTION</div><div class="stat-card__value">@Model.Summary.PassCount.ToString("N0")</div></div>
        <div class="stat-card stat-card--fail"><div class="stat-card__label">Missing from PRODUCTION</div><div class="stat-card__value">@Model.Summary.FailCount.ToString("N0")</div></div>
    </div>
</div>

@if (Model.Signoffs.Any())
{
    <div class="card" style="padding:20px;margin-bottom:20px">
        <h3 class="section-title" style="margin-top:0">Signoffs</h3>
        <table class="data-table">
            <thead><tr><th>Role</th><th>Reviewer</th><th>Signed Off At</th><th>Comment</th></tr></thead>
            <tbody>
                @foreach (var s in Model.Signoffs)
                {
                    <tr>
                        <td>@s.SignoffRole</td>
                        <td>@s.ReviewerName</td>
                        <td>@s.SignedOffAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@s.Comment</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!isArchived && Model.CanCurrentUserSignOff && !Model.CurrentUserHasSignedOff && Model.IsCurrentRun)
        {
            <form method="post" action="/Rule51/AddSignoff" style="margin-top:16px">
                @Html.AntiForgeryToken()
                <input type="hidden" name="runId" value="@Model.RunId" />
                <div class="field-group">
                    <label>Signoff Comment</label>
                    <textarea name="comment" rows="3" placeholder="Add review notes"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Sign Off</button>
            </form>
        }
        @if (!isArchived && Model.CanCurrentUserRemoveSignoff && Model.IsCurrentRun)
        {
            <form method="post" action="/Rule51/RemoveSignoff" style="margin-top:8px">
                @Html.AntiForgeryToken()
                <input type="hidden" name="runId" value="@Model.RunId" />
                <button type="submit" class="btn btn-warning" onclick="return confirm('Remove your signoff?')">Remove Signoff</button>
            </form>
        }
    </div>
}

<div class="card" style="padding:20px">
    <h3 class="section-title" style="margin-top:0">Result Rows <small style="font-weight:normal;font-size:13px">(browser preview)</small></h3>
    @if (!string.IsNullOrWhiteSpace(Model.Summary.Warning))
    {
        <div class="alert alert--warning" style="margin-bottom:12px">@Model.Summary.Warning</div>
    }
    <div class="table-wrapper" style="overflow-x:auto">
        <table class="data-table" style="min-width:@(previewWidth)px;font-size:12px;font-family:Consolas,monospace">
            <thead>
                <tr>
                    <th rowspan="2">#</th>
                    <th colspan="@mappings.Count">@Model.Summary.ValpacTable</th>
                    <th colspan="@mappings.Count">@Model.Summary.ProdTable</th>
                    <th rowspan="2">Result</th>
                </tr>
                <tr>
                    @foreach (var mapping in mappings)
                    {
                        <th>@MappingLabel(mapping)</th>
                    }
                    @foreach (var mapping in mappings)
                    {
                        <th>@MappingLabel(mapping, useProdColumn: true)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Summary.ReviewRows)
                {
                    var dv = row.DisplayValues;
                    string DV(string k) => dv.TryGetValue(k, out var val) ? (val ?? "") : "";
                    <tr style="background:@(row.ValidationResult == "FAIL" ? "#FFF3F3" : "#F3FFF3")">
                        <td>@row.ValidationNumber</td>
                        @for (var i = 0; i < mappings.Count; i++)
                        {
                            <td>@DV(ValpacAlias(i))</td>
                        }
                        @for (var i = 0; i < mappings.Count; i++)
                        {
                            <td>@DV(ProdAlias(i))</td>
                        }
                        <td>
                            <span class="badge @(row.ValidationResult == "FAIL" ? "badge--fail" : "badge--pass")">@row.ValidationResult</span>
                            <div style="margin-top:4px">@DV("FINAL_RESULT_MESSAGE")</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.GeneratedSql))
{
    <div class="card" style="padding:20px;margin-top:20px">
        <h3 class="section-title" style="margin-top:0">SQL Script</h3>
        <pre style="overflow-x:auto;font-size:12px;background:var(--code-bg,#1e1e1e);color:var(--code-text,#d4d4d4);padding:16px;border-radius:8px">@Model.GeneratedSql</pre>
    </div>
}

@using HemisAudit.Models
@{
    ViewData["Title"] = "Rule 67 - CREG-STUD Pair Validation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var clients = ViewBag.Clients as List<Client> ?? new();
    var selectedClientId = ViewBag.ClientId is int cid ? cid : 0;
    var currentSystemRole = ViewBag.CurrentSystemRole as string ?? "";
    var isResultsOnlyRole =
        string.Equals(currentSystemRole, "Manager", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentSystemRole, "Director", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentSystemRole, "Trainee", StringComparison.OrdinalIgnoreCase);
    var moduleNavigation = ViewBag.ModuleNavigation as HemisAudit.ViewModels.ModuleSequenceNavigationViewModel;
}

<div id="app" class="rule-page-shell">
    @if (moduleNavigation != null)
    {
        @await Html.PartialAsync("_ModuleSequenceNav", moduleNavigation)
    }

    <div class="engagement-selector">
        <label for="clientId">Engagement</label>
        <select id="clientId">
            <option value="">Select engagement</option>
            @foreach (var client in clients)
            {
                <option value="@client.Id" selected="@(client.Id == selectedClientId ? "selected" : null)">
                    @client.Name (@client.FiscalYear)
                </option>
            }
        </select>
    </div>

    <div class="rule-header">
        <div class="rule-header__icon">R67</div>
        <div>
            <h1 class="rule-header__title">HEMIS RULE 67: CREG-STUD Pair Validation</h1>
            <p class="rule-header__sub">
                Rule 67 checks that every distinct <code>CREG._007 + _001</code> (student number + qualification code) pair
                exists in <code>STUD</code>, and that <code>CREG._051</code> matches a configurable filter. A student missing
                from STUD entirely is flagged as a ghost student. Exception code <strong>00708</strong> applies on FAIL.
            </p>
        </div>
        <div class="rule-header__badge" id="statusBadge" style="display:none"></div>
    </div>

    @if (!isResultsOnlyRole)
    {
        <div class="accordion-stack">
            <div class="accordion-item">
                <button class="accordion-toggle" type="button" onclick="toggleAccordion('connection')">
                    <span class="acc-icon">DB</span><span>Engagement Dataset</span><span class="acc-chevron">v</span>
                </button>
                <div class="accordion-body" id="body-connection">
                    <div id="connectionOutput" class="status-output"><div class="alert alert--info">Select an engagement above to load its uploaded tables.</div></div>
                    <div class="action-bar" style="justify-content:flex-start;margin:10px 0 0">
                        <a class="btn btn-secondary" id="datasetsLink" href="#">Manage Datasets</a>
                        <button type="button" class="btn btn-primary" id="refreshTablesBtn">Refresh Tables</button>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <button class="accordion-toggle" type="button" onclick="toggleAccordion('config')">
                    <span class="acc-icon">CF</span><span>Rule Configuration</span><span class="acc-chevron">v</span>
                </button>
                <div class="accordion-body" id="body-config" style="display:none">
                    <div class="info-box info-box--red">
                        <strong>Audit Logic:</strong><br />
                        <span>Population: distinct CREG student+qualification pairs.</span><br />
                        <span>PASS when the pair is found in STUD and E051 matches the filter.</span><br />
                        <span>FAIL when the pair is missing from STUD, or E051 doesn't match (exception 00708).</span><br />
                        <span>Optional: cross-reference FAIL results against a Rule 29 detail table to confirm findings.</span>
                    </div>
                    <div class="form-grid">
                        <div class="field-group">
                            <label for="cregTable">CREG Table</label>
                            <select id="cregTable" onchange="loadCols('creg',this.value)"></select>
                        </div>
                        <div class="field-group">
                            <label for="studTable">STUD Table</label>
                            <select id="studTable" onchange="loadCols('stud',this.value)"></select>
                        </div>
                        <div class="field-group">
                            <label for="detailTable">Rule 29 Detail Table <small>(optional — select none to skip)</small></label>
                            <select id="detailTable" onchange="loadCols('detail',this.value)"><option value="">(none — skip reconciliation)</option></select>
                        </div>
                    </div>
                    <div id="configOutput" class="status-output"></div>
                </div>
            </div>

            <div class="accordion-item">
                <button class="accordion-toggle" type="button" onclick="toggleAccordion('colmap')">
                    <span class="acc-icon">CM</span><span>Column Mapping</span><span class="acc-chevron">v</span>
                </button>
                <div class="accordion-body" id="body-colmap" style="display:none">
                    <div class="alert alert--info" style="margin-bottom:12px">
                        Map your uploaded table's column names to the fields Rule 67 uses. Defaults match the standard HEMIS layout. Select tables above to auto-populate column lists.
                    </div>
                    <div style="font-weight:700;font-size:13px;text-transform:uppercase;color:#555;margin-bottom:8px">CREG Table</div>
                    <div class="form-grid">
                        <div class="field-group">
                            <label>Student Number <small>(default <code>_007</code>)</small></label>
                            <select id="cm_cregStudentNoCol"><option value="_007">_007</option></select>
                        </div>
                        <div class="field-group">
                            <label>Qualification <small>(default <code>_001</code>)</small></label>
                            <select id="cm_cregQualCol"><option value="_001">_001</option></select>
                        </div>
                        <div class="field-group">
                            <label>E051 <small>(default <code>_051</code>)</small></label>
                            <select id="cm_cregE051Col"><option value="_051">_051</option></select>
                        </div>
                        <div class="field-group">
                            <label>
                                E051 Filter Value(s)
                                <span style="font-size:11px;color:#888;font-weight:normal;margin-left:6px">Comma-separated (e.g. E). Leave blank to include all.</span>
                            </label>
                            <input type="text" id="e051FilterValuesInput"
                                   placeholder="e.g. E (leave blank to include all)"
                                   style="text-transform:uppercase;width:260px;font-family:monospace;font-size:15px;font-weight:bold"
                                   oninput="this.value=this.value.toUpperCase();state.e051FilterValues=this.value.trim();updateE051Preview();"
                                   onblur="markWorkspaceDirty();" />
                            <small id="e051PreviewText" style="display:block;margin-top:4px;color:#555">
                                No filter value entered - all E051 values will be included.
                            </small>
                        </div>
                    </div>

                    <div style="font-weight:700;font-size:13px;text-transform:uppercase;color:#555;margin:14px 0 8px">STUD Table</div>
                    <div class="form-grid">
                        <div class="field-group">
                            <label>Student Number <small>(default <code>_007</code>)</small></label>
                            <select id="cm_studStudentNoCol"><option value="_007">_007</option></select>
                        </div>
                        <div class="field-group">
                            <label>Qualification <small>(default <code>_001</code>)</small></label>
                            <select id="cm_studQualCol"><option value="_001">_001</option></select>
                        </div>
                    </div>

                    <div style="font-weight:700;font-size:13px;text-transform:uppercase;color:#555;margin:14px 0 8px">Rule 29 Detail Table <small>(only used when a detail table is selected above)</small></div>
                    <div class="form-grid">
                        <div class="field-group">
                            <label>Error Code Column <small>(default <code>Error</code>)</small></label>
                            <select id="cm_detailErrorCol"><option value="Error">Error</option></select>
                        </div>
                        <div class="field-group">
                            <label>Element Information Column <small>(default <code>Element_Information</code>)</small></label>
                            <select id="cm_detailElementInfoCol"><option value="Element_Information">Element_Information</option></select>
                        </div>
                        <div class="field-group">
                            <label>Error Code(s) <small>(comma-separated, default <code>00708</code>)</small></label>
                            <input type="text" id="detailErrorCodeInput" value="00708" style="width:160px;font-family:monospace" onblur="markWorkspaceDirty();" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="workspace-signoff-card">
        <div class="workspace-signoff-card__header">
            <div>
                <div class="workspace-signoff-card__title">Saved Workspace</div>
                <div class="workspace-signoff-card__subtitle">Latest Rule 67 configuration and results reload automatically for this engagement.</div>
            </div>
            <div id="workspaceRunState" class="badge badge--neutral badge--sm">No saved run loaded</div>
        </div>
        <div id="workspaceInfo" class="alert alert--info">Select an engagement to load the saved Rule 67 workspace.</div>
        <div class="workspace-signoff-grid">
            <div>
                <div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Current Run</div>
                <div id="workspaceRunLabel">No saved run yet</div>
            </div>
            <div>
                <div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Status</div>
                <div id="workspaceStatusLabel">-</div>
            </div>
            <div>
                <div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Last Edited</div>
                <div id="workspaceEditedLabel">-</div>
            </div>
            <div>
                <div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Your Role</div>
                <div id="workspaceRoleLabel">@(string.IsNullOrWhiteSpace(currentSystemRole) ? "-" : currentSystemRole)</div>
            </div>
            <div class="field-group" style="grid-column:1/-1">
                <label for="workspaceSignoffComment">Signoff Comment</label>
                <textarea id="workspaceSignoffComment" rows="3" placeholder="Add review or completion notes"></textarea>
            </div>
        </div>
        <div class="workspace-signoff-actions">
            @if (!isResultsOnlyRole)
            {
                <button type="button" class="btn btn-secondary" id="beginEditBtn">Begin Edit</button>
                <button type="button" class="btn btn-success" id="saveWorkspaceBtn">Save Workspace</button>
            }
            <button type="button" class="btn btn-primary" id="signoffBtn">Save Signoff</button>
            <button type="button" class="btn btn-warning" id="removeSignoffBtn">Remove Signoff</button>
        </div>
    </div>

    @if (!isResultsOnlyRole)
    {
        <div class="action-bar">
            <button type="button" class="btn btn-info" id="verifyBtn">Verify Tables</button>
            <button type="button" class="btn btn-success" id="runBtn">Run Rule 67</button>
            <button type="button" class="btn btn-primary" id="sqlBtn">Generate SQL</button>
            <button type="button" class="btn btn-warning" id="downloadAllBtn" disabled>Download All</button>
        </div>
    }

    <div class="results-panel">
        <div class="results-tabs">
            <button class="tab-btn active" type="button" data-tab="analysis">Analysis</button>
            <button class="tab-btn" type="button" data-tab="flagged">FLAGGED</button>
            <button class="tab-btn" type="button" data-tab="clear">CLEAR</button>
            <button class="tab-btn" type="button" data-tab="reconciliation">Reconciliation</button>
            <button class="tab-btn" type="button" data-tab="sql">SQL</button>
            <button class="tab-btn" type="button" data-tab="downloads">Downloads</button>
        </div>
        <div class="tab-pane active" data-tab-panel="analysis"></div>
        <div class="tab-pane" data-tab-panel="flagged"></div>
        <div class="tab-pane" data-tab-panel="clear"></div>
        <div class="tab-pane" data-tab-panel="reconciliation"></div>
        <div class="tab-pane" data-tab-panel="sql">
            <textarea id="sqlText" rows="20" readonly style="width:100%;font-family:monospace;font-size:12px"></textarea>
        </div>
        <div class="tab-pane" data-tab-panel="downloads">
            <div class="alert alert--info" style="margin-bottom:12px">Download the full validated result set. Excel and CSV include both FLAGGED and CLEAR rows, plus the reconciliation sheets when a detail table is configured.</div>
            <div class="action-bar" style="justify-content:flex-start;margin:0">
                <button type="button" class="btn btn-info" id="downloadExcelBtn">Excel</button>
                <button type="button" class="btn btn-info" id="downloadCsvBtn">Full CSV</button>
                <button type="button" class="btn btn-secondary" id="downloadSqlBtn">SQL</button>
            </div>
        </div>
    </div>

    <div id="spinner" class="spinner-overlay" style="display:none">
        <div class="spinner-box">
            <div class="spinner-ring"></div>
            <p id="spinnerMsg">Processing...</p>
        </div>
    </div>
</div>

<form id="antiForgeryForm" method="post" style="display:none">
    @Html.AntiForgeryToken()
</form>

<script>
window.toggleAccordion = function (section) {
    const body = document.getElementById(`body-${section}`);
    if (body) body.style.display = body.style.display === 'none' ? '' : 'none';
};

(() => {
    const apiBase = '/Rule67';
    const currentSystemRole = '@currentSystemRole';
    const isResultsOnlyRole = @(isResultsOnlyRole.ToString().ToLowerInvariant());
    const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value || '';

    const state = {
        clientId: @(selectedClientId > 0 ? selectedClientId : 0),
        currentRunId: null,
        summary: null,
        sql: '',
        currentStatus: '',
        e051FilterValues: '',
        currentUserEngagementRole: '',
        currentUserHasSignedOff: false,
        isWorkspaceSaved: false,
        hasDataAnalystSignoff: false,
        resultsVisible: false
    };

    const els = {
        clientId: document.getElementById('clientId'),
        datasetsLink: document.getElementById('datasetsLink'),
        cregTable: document.getElementById('cregTable'),
        studTable: document.getElementById('studTable'),
        detailTable: document.getElementById('detailTable'),
        connectionOutput: document.getElementById('connectionOutput'),
        configOutput: document.getElementById('configOutput'),
        analysisPane: document.querySelector('[data-tab-panel="analysis"]'),
        flaggedPane: document.querySelector('[data-tab-panel="flagged"]'),
        clearPane: document.querySelector('[data-tab-panel="clear"]'),
        reconciliationPane: document.querySelector('[data-tab-panel="reconciliation"]'),
        sqlText: document.getElementById('sqlText'),
        downloadAllBtn: document.getElementById('downloadAllBtn'),
        workspaceInfo: document.getElementById('workspaceInfo'),
        workspaceRunState: document.getElementById('workspaceRunState'),
        workspaceRunLabel: document.getElementById('workspaceRunLabel'),
        workspaceStatusLabel: document.getElementById('workspaceStatusLabel'),
        workspaceEditedLabel: document.getElementById('workspaceEditedLabel'),
        workspaceRoleLabel: document.getElementById('workspaceRoleLabel'),
        workspaceSignoffComment: document.getElementById('workspaceSignoffComment'),
        beginEditBtn: document.getElementById('beginEditBtn'),
        saveWorkspaceBtn: document.getElementById('saveWorkspaceBtn'),
        signoffBtn: document.getElementById('signoffBtn'),
        removeSignoffBtn: document.getElementById('removeSignoffBtn'),
        statusBadge: document.getElementById('statusBadge'),
        spinner: document.getElementById('spinner'),
        spinnerMsg: document.getElementById('spinnerMsg'),
        cm_cregStudentNoCol: document.getElementById('cm_cregStudentNoCol'),
        cm_cregQualCol: document.getElementById('cm_cregQualCol'),
        cm_cregE051Col: document.getElementById('cm_cregE051Col'),
        cm_studStudentNoCol: document.getElementById('cm_studStudentNoCol'),
        cm_studQualCol: document.getElementById('cm_studQualCol'),
        cm_detailErrorCol: document.getElementById('cm_detailErrorCol'),
        cm_detailElementInfoCol: document.getElementById('cm_detailElementInfoCol'),
        e051FilterValuesInput: document.getElementById('e051FilterValuesInput'),
        detailErrorCodeInput: document.getElementById('detailErrorCodeInput')
    };

    const tabButtons = Array.from(document.querySelectorAll('.tab-btn'));
    tabButtons.forEach(btn => btn.addEventListener('click', () => setActiveTab(btn.dataset.tab)));

    function setActiveTab(tab) {
        tabButtons.forEach(button => button.classList.toggle('active', button.dataset.tab === tab));
        document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.toggle('active', pane.dataset.tabPanel === tab));
    }

    function esc(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function fmt(value) {
        return Number(value || 0).toLocaleString();
    }

    function markWorkspaceDirty() { /* no-op hook kept for parity with other rule pages */ }

    function updateE051Preview() {
        var textEl = document.getElementById('e051PreviewText');
        if (!textEl) return;
        var v = (state.e051FilterValues || '').trim();
        textEl.innerHTML = v
            ? 'Only CREG records where E051 is in <strong>' + esc(v) + '</strong> will pass this check.'
            : 'No filter value entered - all E051 values will be included.';
    }

    function populateSelect(selectEl, items, selected, allowBlank) {
        if (!selectEl) return;
        selectEl.innerHTML = allowBlank ? '<option value="">(none — skip reconciliation)</option>' : '<option value="">Select table</option>';
        (items || []).forEach(item => {
            const option = document.createElement('option');
            option.value = item;
            option.textContent = item;
            if (selected && selected === item) option.selected = true;
            selectEl.appendChild(option);
        });
        if (selected && !(items || []).includes(selected)) {
            const option = document.createElement('option');
            option.value = selected; option.textContent = selected; option.selected = true;
            selectEl.appendChild(option);
        }
    }

    // Never invent an option for a column that doesn't actually exist in the uploaded table - if
    // neither the backend's fuzzy match nor the hardcoded default is a real column, leave the
    // field visibly blank so the analyst notices and picks the correct one.
    function populateColumnSelect(selectEl, columns, selected, defaultValue) {
        if (!selectEl) return;
        const cols = columns || [];
        const val = (selected && cols.includes(selected)) ? selected
            : ((defaultValue && cols.includes(defaultValue)) ? defaultValue : '');
        selectEl.innerHTML = '<option value="">Select column</option>';
        cols.forEach(c => {
            const option = document.createElement('option');
            option.value = c;
            option.textContent = c;
            if (c === val) option.selected = true;
            selectEl.appendChild(option);
        });
        if (!val) selectEl.value = '';
    }

    function getColumnMapping() {
        return {
            cregStudentNoCol: els.cm_cregStudentNoCol?.value || '',
            cregQualCol: els.cm_cregQualCol?.value || '',
            cregE051Col: els.cm_cregE051Col?.value || '',
            studStudentNoCol: els.cm_studStudentNoCol?.value || '',
            studQualCol: els.cm_studQualCol?.value || '',
            detailErrorCol: els.cm_detailErrorCol?.value || '',
            detailElementInfoCol: els.cm_detailElementInfoCol?.value || ''
        };
    }

    async function postJson(url, payload) {
        return await window.fetchJsonWithProgress(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(payload)
        });
    }

    const colRoleMap = {
        creg: [
            [els.cm_cregStudentNoCol, 'creg_student_no', '_007'],
            [els.cm_cregQualCol,      'creg_qual',        '_001'],
            [els.cm_cregE051Col,      'creg_e051',        '_051']
        ],
        stud: [
            [els.cm_studStudentNoCol, 'stud_student_no', '_007'],
            [els.cm_studQualCol,      'stud_qual',        '_001']
        ],
        detail: [
            [els.cm_detailErrorCol,        'detail_error',       'Error'],
            [els.cm_detailElementInfoCol,  'detail_elementinfo',  'Element_Information']
        ]
    };

    async function loadCols(role, tableName) {
        if (!tableName || !state.clientId) return;
        let loadedAny = false;
        for (const [selEl, tableRole, fallback] of (colRoleMap[role] || [])) {
            if (!selEl) continue;
            try {
                const data = await postJson(`${apiBase}/GetColumns`, { clientId: state.clientId, tableName, tableRole });
                if (!data?.success || !data.columns) continue;
                populateColumnSelect(selEl, data.columns, data.autoSelected, fallback);
                loadedAny = true;
            } catch (e) { /* leave this field's dropdown as-is */ }
        }
        if (loadedAny) els.configOutput.innerHTML = `<div class="alert alert--success">Columns loaded for ${esc(tableName)}.</div>`;
    }
    window.loadCols = function (role, tbl) { loadCols(role, tbl); };

    function getRequest() {
        const mapping = getColumnMapping();
        return {
            clientId: state.clientId,
            runId: state.currentRunId,
            cregTable: els.cregTable?.value || '',
            studTable: els.studTable?.value || '',
            detailTable: els.detailTable?.value || '',
            cregStudentNoCol: mapping.cregStudentNoCol,
            cregQualCol: mapping.cregQualCol,
            cregE051Col: mapping.cregE051Col,
            studStudentNoCol: mapping.studStudentNoCol,
            studQualCol: mapping.studQualCol,
            e051FilterValues: state.e051FilterValues || '',
            detailErrorCol: mapping.detailErrorCol,
            detailElementInfoCol: mapping.detailElementInfoCol,
            detailErrorCode: els.detailErrorCodeInput?.value || '00708'
        };
    }

    function findMissingMappedColumns(request) {
        const required = [
            ['cregStudentNoCol', 'CREG Student Number'], ['cregQualCol', 'CREG Qualification'], ['cregE051Col', 'CREG E051'],
            ['studStudentNoCol', 'STUD Student Number'], ['studQualCol', 'STUD Qualification']
        ];
        if (request.detailTable) required.push(['detailErrorCol', 'Detail Error Column'], ['detailElementInfoCol', 'Detail Element Information Column']);
        return required.filter(([key]) => !request[key]).map(([, label]) => label);
    }

    function setStatusBadge(status) {
        if (!els.statusBadge) return;
        if (!status) {
            els.statusBadge.style.display = 'none';
            return;
        }
        els.statusBadge.style.display = '';
        els.statusBadge.textContent = status;
        els.statusBadge.className = `rule-header__badge ${String(status).toUpperCase() === 'PASS' ? 'badge--pass' : 'badge--fail'}`;
    }

    function setWorkspaceState(message, type) {
        els.workspaceInfo.className = `alert alert--${type}`;
        els.workspaceInfo.textContent = message;
        window.showWorkspaceActionToast?.(message, type);
    }

    function normalizeRole(value) {
        return String(value || '').replace(/[^a-z0-9]+/gi, '').toLowerCase();
    }

    function updateWorkspaceButtons() {
        const role = state.currentUserEngagementRole || currentSystemRole || '';
        const normalizedRole = normalizeRole(role);
        const normalizedSystemRole = normalizeRole(currentSystemRole);
        const canEdit = !isResultsOnlyRole && (normalizedSystemRole === 'dataanalyst' || normalizedRole === 'dataanalyst');
        const canSign = !!state.currentRunId && !!state.isWorkspaceSaved &&
            (normalizedRole === 'dataanalyst' || (state.resultsVisible && (normalizedRole === 'manager' || normalizedRole === 'director')));
        const signed = !!state.currentUserHasSignedOff;

        window.ruleWorkspaceUi?.setReadonlyShell('app', !canEdit || signed);
        window.ruleWorkspaceUi?.setFormSectionReadonly('.accordion-stack', !canEdit || signed);
        window.ruleWorkspaceUi?.applyStates([
            { target: 'refreshTablesBtn', disabled: !canEdit || signed },
            { target: 'verifyBtn', disabled: !canEdit || signed },
            { target: 'runBtn', disabled: !canEdit || signed },
            { target: 'sqlBtn', disabled: !canEdit || signed },
            { target: els.beginEditBtn, disabled: signed || !canEdit || !state.currentRunId },
            { target: els.saveWorkspaceBtn, disabled: signed || !canEdit || !state.currentRunId || !state.summary },
            {
                target: els.signoffBtn,
                disabled: signed || !canSign,
                text: signed ? `Signed Off as ${role || currentSystemRole}` : 'Save Signoff'
            },
            { target: els.removeSignoffBtn, show: signed, display: '', disabled: !signed },
            { target: els.workspaceSignoffComment, disabled: signed || !canSign },
            { target: els.downloadAllBtn, disabled: !state.summary }
        ]);
        window.ruleWorkspaceUi?.setButtonGroupReadonly(['.workspace-signoff-actions', '.action-bar'], signed, {
            allow: ['#downloadExcelBtn', '#downloadCsvBtn', '#downloadSqlBtn', '#removeSignoffBtn']
        });
        applyWorkspaceAccessMode(canEdit);
    }

    function applyWorkspaceAccessMode(canEditWorkspace) {
        ['body-connection', 'body-config', 'body-colmap'].forEach(function(id) {
            var body = document.getElementById(id);
            if (!body) return;
            body.style.opacity = canEditWorkspace ? '' : '0.45';
            body.style.filter = canEditWorkspace ? '' : 'grayscale(0.15)';
            body.querySelectorAll('input, select, textarea, button').forEach(function(el) {
                el.disabled = !canEditWorkspace;
            });
        });
    }

    function rowVal(row, key) {
        return (row.displayValues && row.displayValues[key]) || '';
    }

    function renderReviewRow(row) {
        const result = String(row.validationResult || '').toUpperCase();
        const badgeClass = result === 'PASS' ? 'badge--pass' : 'badge--fail';
        return `<tr>
            <td>${esc(row.validationNumber)}</td>
            <td>${esc(rowVal(row, 'CREG_STUD_NO'))}</td>
            <td>${esc(rowVal(row, 'CREG_QUAL'))}</td>
            <td>${esc(rowVal(row, 'CREG_E051'))}</td>
            <td>${esc(rowVal(row, 'STUD_NO') || '-')}</td>
            <td>${esc(rowVal(row, 'GHOST_STUDENT') || '-')}</td>
            <td style="text-align:center"><span class="badge ${badgeClass}">${esc(row.validationResult)}</span></td>
            <td style="font-size:11px">${esc(row.validationExplanation)}</td>
        </tr>`;
    }

    function reviewTableHtml(rows, emptyMessage) {
        if (!rows || !rows.length) {
            return `<div class="empty-card"><p>${esc(emptyMessage)}</p></div>`;
        }
        return `<div style="overflow-x:auto"><table class="data-table" style="font-size:12px">
            <thead><tr>
                <th>#</th>
                <th>CREG Student No</th>
                <th>CREG Qual</th>
                <th>CREG E051</th>
                <th>STUD No</th>
                <th>Ghost Student</th>
                <th>Result</th>
                <th>Explanation</th>
            </tr></thead>
            <tbody>${rows.map(renderReviewRow).join('')}</tbody>
        </table></div>`;
    }

    function renderAnalysis(summary) {
        if (!summary) {
            els.analysisPane.innerHTML = '<div class="empty-card"><p>No Rule 67 results loaded.</p></div>';
            return;
        }
        const statusClass = String(summary.status).toUpperCase() === 'PASS' ? 'badge--pass' : 'badge--fail';
        els.analysisPane.innerHTML = `
            <div class="stats-grid" style="margin-bottom:20px">
                <div class="stat-card"><div class="stat-card__label">Total Pairs Checked</div><div class="stat-card__value">${fmt(summary.totalValidated)}</div></div>
                <div class="stat-card stat-card--pass"><div class="stat-card__label">PASS</div><div class="stat-card__value">${fmt(summary.passCount)}</div></div>
                <div class="stat-card stat-card--fail"><div class="stat-card__label">FAIL (00708)</div><div class="stat-card__value">${fmt(summary.failCount)}</div></div>
                <div class="stat-card stat-card--fail"><div class="stat-card__label">Not in STUD</div><div class="stat-card__value">${fmt(summary.notInStudCount)}</div></div>
                <div class="stat-card stat-card--fail"><div class="stat-card__label">Invalid E051</div><div class="stat-card__value">${fmt(summary.invalidE051Count)}</div></div>
                <div class="stat-card stat-card--fail"><div class="stat-card__label">Ghost Students</div><div class="stat-card__value">${fmt(summary.ghostStudentCount)}</div></div>
                <div class="stat-card"><div class="stat-card__label">Exception Rate</div><div class="stat-card__value">${esc(String(summary.exceptionRate))}%</div></div>
                <div class="stat-card"><div class="stat-card__label">Status</div><div class="stat-card__value"><span class="badge ${statusClass}">${esc(summary.status)}</span></div></div>
            </div>
            <div class="card" style="padding:20px">
                <div class="form-grid" style="margin-bottom:16px">
                    <div><div class="stat-label">Tables</div><div>CREG: ${esc(summary.cregTable)} | STUD: ${esc(summary.studTable)} | Detail: ${summary.detailTable ? esc(summary.detailTable) : '(not used)'}</div></div>
                    <div><div class="stat-label">Columns</div><div>CREG No: ${esc(summary.cregStudentNoCol || '_007')} | CREG Qual: ${esc(summary.cregQualCol || '_001')} | CREG E051: ${esc(summary.cregE051Col || '_051')} | STUD No: ${esc(summary.studStudentNoCol || '_007')} | STUD Qual: ${esc(summary.studQualCol || '_001')}</div></div>
                    <div><div class="stat-label">E051 Filter</div><div>${esc(summary.e051FilterValues) || '(all - no filter applied)'}</div></div>
                    <div><div class="stat-label">Timestamp</div><div>${esc(summary.timestamp)}</div></div>
                </div>
                ${summary.warning ? `<div class="alert alert--warning">${esc(summary.warning)}</div>` : ''}
                ${summary.isPreviewOnly ? `<div class="alert alert--warning">Browser preview is limited to ${fmt(summary.previewLimit)} rows. Download the result files for the full tested population.</div>` : ''}
            </div>`;
    }

    function renderFlagged(summary) {
        if (!summary) {
            els.flaggedPane.innerHTML = '<div class="empty-card"><p>No Rule 67 results loaded.</p></div>';
            return;
        }
        const rows = (summary.reviewRows || []).filter(r => String(r.validationResult || '').toUpperCase() === 'FAIL');
        els.flaggedPane.innerHTML = `
            <div class="card" style="padding:16px;margin-bottom:12px">
                <strong>FLAGGED Rows</strong> - ${fmt(summary.failCount)} CREG pair(s) missing from STUD or failing the E051 filter (exception 00708).
                ${summary.isPreviewOnly ? `<span class="badge badge--neutral">Preview limited to ${fmt(summary.previewLimit)} rows</span>` : ''}
            </div>
            ${reviewTableHtml(rows, 'No flagged rows were returned for this run.')}`;
    }

    function renderClear(summary) {
        if (!summary) {
            els.clearPane.innerHTML = '<div class="empty-card"><p>No Rule 67 results loaded.</p></div>';
            return;
        }
        const rows = (summary.reviewRows || []).filter(r => String(r.validationResult || '').toUpperCase() === 'PASS');
        els.clearPane.innerHTML = `
            <div class="card" style="padding:16px;margin-bottom:12px">
                <strong>CLEAR Rows</strong> - ${fmt(summary.passCount)} CREG pair(s) found in STUD with a valid E051 code.
                ${summary.isPreviewOnly ? `<span class="badge badge--neutral">Preview limited to ${fmt(summary.previewLimit)} rows</span>` : ''}
            </div>
            ${reviewTableHtml(rows, 'No clear rows were returned for this run.')}`;
    }

    function renderReconciliation(summary) {
        if (!summary) {
            els.reconciliationPane.innerHTML = '<div class="empty-card"><p>No Rule 67 results loaded.</p></div>';
            return;
        }
        if (!summary.detailTable) {
            els.reconciliationPane.innerHTML = '<div class="empty-card"><p>No Rule 29 detail table was configured for this run - reconciliation was skipped.</p></div>';
            return;
        }
        const rows = summary.rule29OnlyRows || [];
        const rowsHtml = rows.length
            ? `<div style="overflow-x:auto"><table class="data-table" style="font-size:12px">
                <thead><tr><th>#</th><th>Student No</th><th>Qualification</th><th>Confirmed by Rule 67?</th></tr></thead>
                <tbody>${rows.map(r => `<tr>
                    <td>${esc(r.rowNumber)}</td>
                    <td>${esc(r.studentNo)}</td>
                    <td>${esc(r.qualCode)}</td>
                    <td>${esc(r.confirmedByR67)}</td>
                </tr>`).join('')}</tbody>
            </table></div>`
            : `<div class="empty-card"><p>No Rule 29 detail rows were returned for this run.</p></div>`;
        els.reconciliationPane.innerHTML = `
            <div class="stats-grid" style="margin-bottom:20px">
                <div class="stat-card"><div class="stat-card__label">Detail Records (${esc(summary.detailErrorCode || '00708')})</div><div class="stat-card__value">${fmt(summary.detailRecordCount)}</div></div>
                <div class="stat-card stat-card--pass"><div class="stat-card__label">Confirmed by Rule 29</div><div class="stat-card__value">${fmt(summary.confirmedByRule29Count)}</div></div>
                <div class="stat-card stat-card--fail"><div class="stat-card__label">Not in Rule 29</div><div class="stat-card__value">${fmt(summary.notInRule29Count)}</div></div>
                <div class="stat-card"><div class="stat-card__label">R29 Only (all)</div><div class="stat-card__value">${fmt(summary.rule29OnlyCount)}</div></div>
                <div class="stat-card stat-card--pass"><div class="stat-card__label">R29: Confirmed by R67</div><div class="stat-card__value">${fmt(summary.rule29ConfirmedByR67Count)}</div></div>
                <div class="stat-card"><div class="stat-card__label">R29: In CREG, R67 PASS</div><div class="stat-card__value">${fmt(summary.rule29InCregPassCount)}</div></div>
                <div class="stat-card stat-card--fail"><div class="stat-card__label">R29: Not in CREG</div><div class="stat-card__value">${fmt(summary.rule29NotInCregCount)}</div></div>
            </div>
            <div class="card" style="padding:16px">
                <strong>Rule 29 Detail Pairs</strong> - all student/qualification pairs from <code>${esc(summary.detailTable)}</code> with error code ${esc(summary.detailErrorCode || '00708')}, showing whether Rule 67 also flagged them.
            </div>
            ${rowsHtml}`;
    }

    function applySummary(summary, options = {}) {
        state.summary = summary;
        if (!options.fromWorkspace) state.currentRunId = summary?.savedRunId || state.currentRunId;
        state.currentStatus = summary?.status || state.currentStatus;
        state.resultsVisible = !!summary || state.resultsVisible;
        if (summary) {
            state.e051FilterValues = summary.e051FilterValues || '';
            if (els.e051FilterValuesInput) els.e051FilterValuesInput.value = state.e051FilterValues;
            if (els.detailErrorCodeInput) els.detailErrorCodeInput.value = summary.detailErrorCode || '00708';
            updateE051Preview();
            els.workspaceRunState.textContent = state.currentRunId ? `Run #${state.currentRunId} | ${state.currentStatus}` : 'No saved run loaded';
            els.workspaceRunLabel.textContent = state.currentRunId ? `Run #${state.currentRunId}` : 'No saved run yet';
            els.workspaceStatusLabel.textContent = state.currentStatus || '-';
        }
        setStatusBadge(summary?.status || '');
        renderAnalysis(summary);
        renderFlagged(summary);
        renderClear(summary);
        renderReconciliation(summary);
        updateWorkspaceButtons();
    }

    function applyWorkspace(workspace, resultsVisible, preserveExisting = false) {
        if (els.datasetsLink) els.datasetsLink.href = state.clientId ? '/EngagementDatasets?clientId=' + state.clientId : '#';

        if (!workspace) {
            state.currentRunId = null;
            state.currentStatus = '';
            state.currentUserEngagementRole = '';
            state.currentUserHasSignedOff = false;
            state.isWorkspaceSaved = false;
            state.hasDataAnalystSignoff = false;
            state.resultsVisible = false;
            setWorkspaceState('No saved Rule 67 workspace exists for this engagement yet.', 'info');
            els.workspaceRunState.textContent = 'No saved run loaded';
            els.workspaceRunLabel.textContent = 'No saved run yet';
            els.workspaceStatusLabel.textContent = '-';
            els.workspaceEditedLabel.textContent = '-';
            applySummary(null);
            updateWorkspaceButtons();
            if (state.clientId) loadTables().catch(() => {});
            return;
        }

        state.clientId = workspace.clientId || state.clientId;
        state.currentRunId = workspace.runId || null;
        state.currentStatus = workspace.currentStatus || '';
        state.e051FilterValues = workspace.e051FilterValues || '';
        state.currentUserEngagementRole = workspace.currentUserEngagementRole || currentSystemRole || '';
        state.currentUserHasSignedOff = !!workspace.currentUserHasSignedOff;
        state.isWorkspaceSaved = !!workspace.isWorkspaceSaved;
        state.hasDataAnalystSignoff = !!workspace.hasDataAnalystSignoff;
        state.resultsVisible = !!resultsVisible;

        if (els.e051FilterValuesInput) els.e051FilterValuesInput.value = state.e051FilterValues;
        if (els.detailErrorCodeInput) els.detailErrorCodeInput.value = workspace.detailErrorCode || '00708';
        updateE051Preview();

        els.workspaceRunState.textContent = workspace.runId ? `Run #${workspace.runId}` : 'No saved run loaded';
        els.workspaceRunLabel.textContent = workspace.runId ? `Rule 67 Run #${workspace.runId}` : 'No saved run yet';
        els.workspaceStatusLabel.textContent = workspace.currentStatus || '-';
        els.workspaceEditedLabel.textContent = workspace.lastEditedAt ? new Date(workspace.lastEditedAt).toLocaleString() : '-';
        els.workspaceRoleLabel.textContent = workspace.currentUserEngagementRole || currentSystemRole || '-';
        els.workspaceSignoffComment.value = workspace.currentUserSignoffComment || '';

        const set = (el, value) => { if (el) el.value = value || ''; };
        set(els.cm_cregStudentNoCol, workspace.cregStudentNoCol);
        set(els.cm_cregQualCol, workspace.cregQualCol);
        set(els.cm_cregE051Col, workspace.cregE051Col);
        set(els.cm_studStudentNoCol, workspace.studStudentNoCol);
        set(els.cm_studQualCol, workspace.studQualCol);

        loadTables({
            preferredCregTable: workspace.cregTable || '',
            preferredStudTable: workspace.studTable || '',
            preferredDetailTable: workspace.detailTable || ''
        }).catch(() => {});

        if (!resultsVisible) {
            setWorkspaceState('Saved Rule 67 results are not available for your engagement role.', 'info');
            if (!preserveExisting) applySummary(null);
            else updateWorkspaceButtons();
            return;
        }

        setWorkspaceState(workspace.summary ? 'Saved Rule 67 workspace loaded.' : 'Rule 67 workspace loaded. Run validation to generate results.', 'success');
        if (workspace.summary) applySummary(workspace.summary, { fromWorkspace: true });
        else if (!preserveExisting) applySummary(null);
        else updateWorkspaceButtons();
    }

    async function downloadBlob(url, payload, fileName) {
        await window.downloadFileWithProgress({
            url,
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(payload),
            defaultFileName: fileName,
            label: 'Downloading result'
        });
    }

    function getSummaryDownloadPayload() {
        if (state.currentRunId) {
            return { savedRunId: state.currentRunId };
        }

        if (state.summary) {
            return {
                ...state.summary,
                savedRunId: state.summary.savedRunId || state.currentRunId || null
            };
        }

        return null;
    }

    async function downloadExcelFile() {
        const payload = getSummaryDownloadPayload();
        if (!payload) throw new Error('Run Rule 67 first before downloading Excel results.');

        const info = await postJson(`${apiBase}/GetExportInfo`, payload);
        if (info?.exceedsExcelLimit) {
            window.showExcelTooLargeModal(
                `This engagement has ${(info.totalRecords || 0).toLocaleString()} records - too many to include in a single Excel file.`,
                downloadCsvFile
            );
            return;
        }

        try {
            await downloadBlob(`${apiBase}/DownloadExcel`, payload, 'Rule67_CREG_STUD_Pair.xlsx');
        } catch (err) {
            window.showExcelTooLargeModal(`This engagement's Excel export failed: ${err.message}`, downloadCsvFile);
        }
    }

    async function downloadCsvFile() {
        const payload = getSummaryDownloadPayload();
        if (!payload) throw new Error('Run Rule 67 first before downloading CSV results.');
        await downloadBlob(`${apiBase}/DownloadCsv`, payload, 'Rule67_CREG_STUD_Pair.csv');
    }

    function showSpinner(message) {
        if (els.spinnerMsg) els.spinnerMsg.textContent = message;
        if (els.spinner) els.spinner.style.display = 'flex';
    }

    function hideSpinner() {
        if (els.spinner) els.spinner.style.display = 'none';
    }

    async function loadWorkspace() {
        state.clientId = Number(els.clientId?.value || 0);
        if (!state.clientId) {
            applyWorkspace(null, false);
            return;
        }
        const data = await window.fetchJsonWithProgress(`${apiBase}/GetWorkspaceState?clientId=${state.clientId}`, { method: 'GET' });
        if (!data.success) throw new Error(data.error || 'Failed to load workspace.');
        applyWorkspace(data.workspace, data.resultsVisible);
    }

    async function loadTables(opts = {}) {
        if (!state.clientId) return;
        showSpinner('Loading tables...');
        try {
            const data = await postJson(`${apiBase}/GetTables`, { clientId: state.clientId });
            if (!data.success) throw new Error(data.error || 'Could not load tables.');
            populateSelect(els.cregTable, data.tables || [], opts.preferredCregTable || data.autoCregTable, false);
            populateSelect(els.studTable, data.tables || [], opts.preferredStudTable || data.autoStudTable, false);
            populateSelect(els.detailTable, data.tables || [], opts.preferredDetailTable || '', true);
            els.connectionOutput.innerHTML = `<div class="alert alert--success">Loaded ${(data.tables || []).length} table(s) from this engagement's dataset.</div>`;
            const loads = [loadCols('creg', els.cregTable?.value), loadCols('stud', els.studTable?.value)];
            if (els.detailTable?.value) loads.push(loadCols('detail', els.detailTable.value));
            await Promise.all(loads);
        } finally { hideSpinner(); }
    }

    async function verifyTables() {
        showSpinner('Verifying tables...');
        try {
            const data = await postJson(`${apiBase}/VerifyTables`, getRequest());
            if (!data.success) throw new Error(data.error || 'Verification failed.');
            els.configOutput.innerHTML = `<div class="alert alert--success">
                CREG rows: <strong>${fmt(data.cregRecordCount)}</strong> |
                STUD rows: <strong>${fmt(data.studRecordCount)}</strong>
            </div>`;
        } finally {
            hideSpinner();
        }
    }

    async function runValidation() {
        const request = getRequest();
        if (!request.clientId) {
            setWorkspaceState('Select the approved engagement assigned to you before running.', 'warning');
            return;
        }
        const missing = findMissingMappedColumns(request);
        if (missing.length) {
            setWorkspaceState(`Select a real column for: ${missing.join(', ')}. Auto-detect could not confidently match these to your uploaded data.`, 'warning');
            return;
        }
        showSpinner('Running Rule 67...');
        try {
            const data = await postJson(`${apiBase}/RunValidation`, request);
            if (!data.success) throw new Error(data.error || 'Rule 67 failed.');
            state.currentUserHasSignedOff = false;
            state.isWorkspaceSaved = false;
            state.hasDataAnalystSignoff = false;
            state.resultsVisible = true;
            state.currentUserEngagementRole = state.currentUserEngagementRole || currentSystemRole || 'DataAnalyst';
            applySummary(data);
            setWorkspaceState(`Rule 67 completed. PASS: ${fmt(data.passCount)} | FAIL: ${fmt(data.failCount)}. Overall ${data.status}.`, 'success');
        } finally {
            hideSpinner();
        }
    }

    async function generateSql() {
        showSpinner('Generating SQL...');
        try {
            const data = await postJson(`${apiBase}/GenerateSql`, getRequest());
            if (!data.success) throw new Error(data.error || 'SQL generation failed.');
            state.sql = data.sql || '';
            els.sqlText.value = state.sql;
            setActiveTab('sql');
        } finally {
            hideSpinner();
        }
    }

    async function saveWorkspace() {
        showSpinner('Saving workspace...');
        try {
            const data = await postJson(`${apiBase}/SaveWorkspace`, getRequest());
            if (!data.success) throw new Error(data.error || 'Workspace save failed.');
            applyWorkspace(data.workspace, data.workspace?.resultsVisible ?? false, true);
            setWorkspaceState(data.message || 'Workspace saved.', data.signoffsCleared ? 'warning' : 'success');
        } finally {
            hideSpinner();
        }
    }

    async function beginEdit() {
        showSpinner('Preparing workspace edit...');
        try {
            const data = await postJson(`${apiBase}/BeginWorkspaceEdit`, getRequest());
            if (!data.success) throw new Error(data.error || 'Could not begin edit.');
            applyWorkspace(data.workspace, data.workspace?.resultsVisible ?? false, true);
            setWorkspaceState(data.message || 'Workspace ready for editing.', 'warning');
        } finally {
            hideSpinner();
        }
    }

    async function signoffWorkspace() {
        showSpinner('Saving signoff...');
        try {
            const data = await postJson(`${apiBase}/SignOffWorkspace`, {
                clientId: state.clientId,
                runId: state.currentRunId,
                comment: els.workspaceSignoffComment.value || ''
            });
            if (!data.success) throw new Error(data.error || 'Signoff failed.');
            state.currentUserHasSignedOff = true;
            applyWorkspace(data.workspace, data.resultsVisible ?? false, true);
            setWorkspaceState(data.message || 'Signoff saved.', 'success');
        } finally {
            hideSpinner();
        }
    }

    async function removeSignoff() {
        showSpinner('Removing signoff...');
        try {
            const data = await postJson(`${apiBase}/RemoveWorkspaceSignoff`, {
                clientId: state.clientId,
                runId: state.currentRunId,
                comment: ''
            });
            if (!data.success) throw new Error(data.error || 'Signoff removal failed.');
            state.currentUserHasSignedOff = false;
            state.isWorkspaceSaved = false;
            applyWorkspace(data.workspace, data.resultsVisible ?? false, false);
            setWorkspaceState(data.message || 'Signoff removed.', 'warning');
        } finally {
            hideSpinner();
        }
    }

    document.getElementById('refreshTablesBtn')?.addEventListener('click', () => loadTables().catch(error => {
        hideSpinner();
        els.connectionOutput.innerHTML = `<div class="alert alert--error">${esc(error.message)}</div>`;
    }));
    document.getElementById('verifyBtn')?.addEventListener('click', () => verifyTables().catch(error => {
        hideSpinner();
        els.configOutput.innerHTML = `<div class="alert alert--error">${esc(error.message)}</div>`;
    }));
    document.getElementById('runBtn')?.addEventListener('click', () => runValidation().catch(error => {
        hideSpinner();
        setWorkspaceState(error.message, 'error');
    }));
    document.getElementById('sqlBtn')?.addEventListener('click', () => generateSql().catch(error => {
        hideSpinner();
        els.sqlText.value = error.message;
    }));
    document.getElementById('saveWorkspaceBtn')?.addEventListener('click', () => saveWorkspace().catch(error => {
        hideSpinner();
        setWorkspaceState(error.message, 'error');
    }));
    document.getElementById('beginEditBtn')?.addEventListener('click', () => beginEdit().catch(error => {
        hideSpinner();
        setWorkspaceState(error.message, 'error');
    }));
    document.getElementById('signoffBtn')?.addEventListener('click', () => signoffWorkspace().catch(error => {
        hideSpinner();
        setWorkspaceState(error.message, 'error');
    }));
    document.getElementById('removeSignoffBtn')?.addEventListener('click', () => removeSignoff().catch(error => {
        hideSpinner();
        setWorkspaceState(error.message, 'error');
    }));

    document.getElementById('downloadExcelBtn')?.addEventListener('click', () =>
        downloadExcelFile().catch(error => setWorkspaceState(error.message, 'error')));
    document.getElementById('downloadCsvBtn')?.addEventListener('click', () =>
        downloadCsvFile().catch(error => setWorkspaceState(error.message, 'error')));
    document.getElementById('downloadSqlBtn')?.addEventListener('click', () =>
        downloadBlob(`${apiBase}/DownloadSql`, getRequest(), 'Rule67_CREG_STUD_Pair.sql').catch(error => setWorkspaceState(error.message, 'error')));
    document.getElementById('downloadAllBtn')?.addEventListener('click', async () => {
        if (!state.currentRunId) { setWorkspaceState('Save the workspace before downloading.', 'warning'); return; }
        const id = state.currentRunId;
        const dl = (url, filename) => window.downloadFileWithProgress({ url, method: 'GET', defaultFileName: filename, label: 'Downloading result' });
        await dl(`${apiBase}/DownloadSavedExcel?runId=${id}`, `Rule67_Run_${id}.xlsx`);
        await dl(`${apiBase}/DownloadSavedCsv?runId=${id}`, `Rule67_Run_${id}.csv`);
        await dl(`${apiBase}/DownloadSavedSql?runId=${id}`, `Rule67_Run_${id}.sql`);
    });

    els.clientId?.addEventListener('change', () => loadWorkspace().catch(error => setWorkspaceState(error.message, 'error')));

    renderAnalysis(null);
    renderFlagged(null);
    renderClear(null);
    renderReconciliation(null);
    updateWorkspaceButtons();

    if (state.clientId) loadWorkspace().catch(error => setWorkspaceState(error.message, 'error'));
    else if (isResultsOnlyRole) setWorkspaceState('Select an engagement to load the saved Rule 67 results.', 'info');
})();
</script>

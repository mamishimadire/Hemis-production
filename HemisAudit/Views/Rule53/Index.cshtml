@using HemisAudit.Models
@{
    ViewData["Title"] = "Rule 53 - dbo_CRSE Subject Code in MT-audit-prod-CRSE";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var clients = ViewBag.Clients as List<Client> ?? new();
    var selectedClientId = ViewBag.ClientId is int cid ? cid : 0;
    var currentSystemRole = ViewBag.CurrentSystemRole as string ?? "";
    var isResultsOnlyRole =
        string.Equals(currentSystemRole, "Manager", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentSystemRole, "Director", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentSystemRole, "Trainee", StringComparison.OrdinalIgnoreCase);
    var moduleNavigation = ViewBag.ModuleNavigation as HemisAudit.ViewModels.ModuleSequenceNavigationViewModel;
}

<style>
.r53-tbl { border-collapse: collapse; width: 100%; font-size: .82rem; }
.r53-tbl th { background: #1B5E20; color: #fff; padding: 5px 8px; border: 1px solid #bbb; white-space: nowrap; text-align: center; }
.r53-tbl td { padding: 4px 7px; border: 1px solid #ddd; vertical-align: middle; }
.r53-tbl tr.pass-row { background: #F1F8E9; }
.r53-tbl tr.fail-row { background: #FFEBEE; }
.r53-pass { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: .74rem; font-weight: 700; background: #E8F5E9; color: #1E8449; }
.r53-fail { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: .74rem; font-weight: 700; background: #FFEBEE; color: #C0392B; }
.workspace-signoff-actions { display: flex; gap: 10px; flex-wrap: wrap; padding-top: 4px; }
.col-mapping-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
</style>

<div id="app" class="rule-page-shell">
    @if (moduleNavigation != null)
    {
        @await Html.PartialAsync("_ModuleSequenceNav", moduleNavigation)
    }

    <div class="engagement-selector">
        <label for="r53ClientId">Engagement</label>
        <select id="r53ClientId" onchange="r53OnClientChange(this.value)">
            <option value="">Select engagement</option>
            @foreach (var client in clients)
            {
                <option value="@client.Id" selected="@(client.Id == selectedClientId ? "selected" : null)">
                    @client.Name (@client.FiscalYear)
                </option>
            }
        </select>
    </div>

    <div class="rule-header">
        <div class="rule-header__icon">R53</div>
        <div>
            <h1 class="rule-header__title">HEMIS RULE 53: dbo_CRSE Subject Code in MT-audit-prod-CRSE</h1>
            <p class="rule-header__sub">
                Rule 53 checks that every distinct subject code in <code>dbo_CRSE</code>
                exists as a matching code in <code>MT-audit-prod-CRSE</code>.
            </p>
        </div>
        <div class="rule-header__badge" id="r53StatusBadge" style="display:none"></div>
    </div>

    @if (!isResultsOnlyRole)
    {
        <div class="accordion-stack">
            <div class="accordion-item">
                <button class="accordion-toggle" type="button" onclick="toggleAccordion('r53-conn')">
                    <span class="acc-icon">DB</span><span>Engagement Dataset</span><span class="acc-chevron">v</span>
                </button>
                <div class="accordion-body" id="body-r53-conn">
                    <div class="alert alert--info" id="r53DatasetStatusAlert">
                        Select an engagement above to load its uploaded tables.
                    </div>
                    <div class="action-bar" style="justify-content:flex-start;margin:10px 0 0">
                        <a class="btn btn-secondary" id="r53DatasetsLink" href="#">Manage Datasets</a>
                        <button type="button" class="btn btn-primary" onclick="r53LoadTables()">Refresh Tables</button>
                    </div>
                    <div id="r53ConnOut" class="status-output"></div>
                </div>
            </div>

            <div class="accordion-item">
                <button class="accordion-toggle" type="button" onclick="toggleAccordion('r53-cfg')">
                    <span class="acc-icon">CF</span><span>Table &amp; Column Configuration</span><span class="acc-chevron">v</span>
                </button>
                <div class="accordion-body" id="body-r53-cfg" style="display:none">
                    <div class="info-box info-box--red" style="margin-bottom:14px">
                        <strong>Rule 53 Logic:</strong><br />
                        Select all distinct subject codes from <code>dbo_CRSE</code>.<br />
                        Each code must exist as a matching code in <code>MT-audit-prod-CRSE</code>.<br />
                        PASS when a match is found; FAIL when no match is found. All columns and tables are configurable.
                    </div>

                    <h4 style="margin:0 0 10px;font-size:.9rem;color:#555">dbo_CRSE Table</h4>
                    <div class="col-mapping-grid" style="margin-bottom:16px">
                        <div class="field-group">
                            <label for="r53ValpacTable">dbo_CRSE Table</label>
                            <select id="r53ValpacTable" onchange="r53LoadCols('valpac',this.value)"></select>
                        </div>
                        <div class="field-group">
                            <label for="r53ValpacSubjCol">Subject Code Column <small>(_030)</small></label>
                            <select id="r53ValpacSubjCol"></select>
                        </div>
                    </div>

                    <h4 style="margin:0 0 10px;font-size:.9rem;color:#555">MT-audit-prod-CRSE Table</h4>
                    <div class="col-mapping-grid" style="margin-bottom:16px">
                        <div class="field-group">
                            <label for="r53ProdTable">MT-audit-prod-CRSE Table</label>
                            <select id="r53ProdTable" onchange="r53LoadCols('prod',this.value)"></select>
                        </div>
                        <div class="field-group">
                            <label for="r53ProdSubjCol">Subject Code Column <small>(IALSUBJ)</small></label>
                            <select id="r53ProdSubjCol"></select>
                        </div>
                    </div>

                    <div class="action-bar" style="justify-content:flex-start;margin:4px 0">
                        <button type="button" class="btn btn-info" onclick="r53Verify()">Verify Tables</button>
                    </div>
                    <div id="r53CfgOut" class="status-output"></div>
                </div>
            </div>
        </div>
    }

    <div class="workspace-signoff-card">
        <div class="workspace-signoff-card__header">
            <div>
                <div class="workspace-signoff-card__title">Saved Workspace</div>
                <div class="workspace-signoff-card__subtitle">The last saved Rule 53 configuration, results, and signoffs reload here automatically.</div>
            </div>
            <div id="r53RunState" class="badge badge--neutral badge--sm">No saved run loaded</div>
        </div>
        <div id="workspaceInfo" class="alert alert--info">Select an engagement to load the saved Rule 53 workspace.</div>
        <div class="workspace-signoff-grid">
            <div><div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Current Run</div><div id="r53RunLabel">No saved run yet</div></div>
            <div><div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Status</div><div id="r53StatusLabel">-</div></div>
            <div><div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Last Edited</div><div id="r53EditedLabel">-</div></div>
            <div><div style="color:#757575;font-size:12px;text-transform:uppercase;font-weight:700">Your Role</div><div id="r53RoleLabel">@(string.IsNullOrWhiteSpace(currentSystemRole) ? "-" : currentSystemRole)</div></div>
            <div class="field-group" style="grid-column:1/-1">
                <label for="r53SignoffComment">Signoff Comment</label>
                <textarea id="r53SignoffComment" rows="2" placeholder="Add the final review note confirming this validation is complete."></textarea>
            </div>
        </div>
        <div class="workspace-signoff-actions">
            @if (!isResultsOnlyRole)
            {
                <button class="btn btn-success" id="r53SaveBtn" onclick="r53SaveWorkspace()">Save Workspace</button>
            }
            <button class="btn btn-primary" id="r53SignoffBtn" onclick="r53SignOff()">Sign Off</button>
            <button class="btn btn-warning" id="r53RemoveSignoffBtn" onclick="r53RemoveSignoff()" style="display:none">Remove Signoff</button>
        </div>
    </div>

    <div class="action-bar">
        @if (!isResultsOnlyRole)
        {
            <button class="btn btn-success" onclick="r53Run()">&#9654; Run Rule 53</button>
            <button class="btn btn-primary" onclick="r53GenSql()">Generate SQL</button>
        }
        <button class="btn btn-success" id="r53DlExcelBtn" onclick="r53DlExcel()" disabled>Download Excel</button>
        <button class="btn btn-warning" id="r53DlCsvBtn" onclick="r53DlCsv()" disabled>Download CSV</button>
        <button class="btn btn-secondary" id="r53DlSqlBtn" onclick="r53DlSql()" disabled>Download SQL</button>
    </div>

    <div class="results-panel">
        <div class="results-tabs">
            <button class="tab-btn active" type="button" data-tab="r53-analysis" onclick="r53Tab('r53-analysis')">Analysis</button>
            <button class="tab-btn" type="button" data-tab="r53-results" onclick="r53Tab('r53-results')">Results</button>
            <button class="tab-btn" type="button" data-tab="r53-sql" onclick="r53Tab('r53-sql')">SQL Code</button>
        </div>
        <div class="tab-pane active" data-tab-panel="r53-analysis">
            <div id="r53AnalysisPane"><div class="empty-state"><p>Run Rule 53 to see results here.</p></div></div>
        </div>
        <div class="tab-pane" data-tab-panel="r53-results">
            <div class="results-filter-bar" style="padding:10px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <label style="font-size:.85rem">Filter:</label>
                <button class="btn btn-sm btn-secondary r53-filter-btn active" data-filter="ALL" onclick="r53SetFilter(this)">All</button>
                <button class="btn btn-sm btn-secondary r53-filter-btn" data-filter="PASS" onclick="r53SetFilter(this)">PASS only</button>
                <button class="btn btn-sm btn-secondary r53-filter-btn" data-filter="FAIL" onclick="r53SetFilter(this)">FAIL only</button>
            </div>
            <div id="r53ResultsPane"><div class="empty-state"><p>Run validation first.</p></div></div>
        </div>
        <div class="tab-pane" data-tab-panel="r53-sql">
            <textarea id="r53SqlText" rows="22" readonly style="width:100%;font-family:monospace;font-size:12px"></textarea>
        </div>
    </div>

    <div id="r53Spinner" class="spinner-overlay" style="display:none">
        <div class="spinner-box"><div class="spinner-ring"></div><p id="r53SpinMsg">Processing...</p></div>
    </div>
</div>

<form id="r53AntiForgery" method="post" style="display:none">@Html.AntiForgeryToken()</form>

<script>
window.toggleAccordion = window.toggleAccordion || function(section) {
    var body = document.getElementById('body-' + section);
    if (body) body.style.display = body.style.display === 'none' ? '' : 'none';
};

window.r53Tab = function(tab) {
    document.querySelectorAll('#app .results-panel .tab-btn').forEach(function(btn) {
        btn.classList.toggle('active', btn.dataset.tab === tab);
    });
    document.querySelectorAll('#app .results-panel .tab-pane').forEach(function(panel) {
        panel.classList.toggle('active', panel.dataset.tabPanel === tab);
    });
    if (tab === 'r53-results') renderRule53Results();
};

(function() {
    var API = '/Rule53';
    var ROLE = '@currentSystemRole';
    var IS_RESULTS_ONLY = @(isResultsOnlyRole.ToString().ToLowerInvariant());
    var TOKEN = (document.querySelector('#r53AntiForgery input[name="__RequestVerificationToken"]') || {}).value || '';

    var st = {
        clientId: @(selectedClientId > 0 ? selectedClientId : 0),
        runId: null,
        summary: null,
        isWorkspaceSaved: false,
        currentUserHasSignedOff: false,
        resultsVisible: false,
        currentUserEngagementRole: '',
        filterResult: 'ALL'
    };

    function g(id) { return document.getElementById(id); }
    function gv(id) { var el = g(id); return el ? el.value : ''; }
    function show(id, visible) { var el = g(id); if (el) el.style.display = visible ? '' : 'none'; }
    function fmt(n) { return Number(n || 0).toLocaleString(); }
    function esc(v) {
        return String(v == null ? '' : v)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function setWorkspaceMessage(message, type) {
        var el = g('workspaceInfo');
        if (!el) return;
        el.className = 'alert alert--' + (type || 'info');
        el.textContent = message;
    }

    function setStatusOutput(id, message, type) {
        var el = g(id);
        if (!el) return;
        el.className = 'alert alert--' + (type || 'info');
        el.textContent = message;
    }

    function spin(message) {
        var label = g('r53SpinMsg');
        if (label) label.textContent = message || 'Processing...';
        show('r53Spinner', true);
    }

    function unspin() {
        show('r53Spinner', false);
    }

    function fillSelect(idOrElement, items, selected) {
        var select = typeof idOrElement === 'string' ? g(idOrElement) : idOrElement;
        if (!select) return;
        select.innerHTML = '';
        (items || []).forEach(function(item) {
            var option = document.createElement('option');
            option.value = item;
            option.textContent = item;
            if (selected && selected === item) option.selected = true;
            select.appendChild(option);
        });
    }

    // Only ever selects a column that actually exists in the uploaded table. Never fabricates
    // an option for a hardcoded default that isn't really there.
    function fillColumnSelect(id, columns, preferred, autoSelected) {
        var select = g(id);
        if (!select) return;
        var cols = columns || [];
        var val = (preferred && cols.includes(preferred)) ? preferred
                : (autoSelected && cols.includes(autoSelected)) ? autoSelected
                : '';
        select.innerHTML = '<option value="">Select column</option>';
        cols.forEach(function(c) {
            var o = document.createElement('option');
            o.value = c; o.textContent = c;
            if (c === val) o.selected = true;
            select.appendChild(o);
        });
    }

    async function post(url, body) {
        return await window.fetchJsonWithProgress(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': TOKEN
            },
            body: JSON.stringify(body)
        });
    }

    function setStatusBadge(status) {
        var badge = g('r53StatusBadge');
        if (!badge) return;
        if (!status) {
            badge.style.display = 'none';
            return;
        }
        badge.style.display = '';
        badge.textContent = status;
        badge.className = 'rule-header__badge ' + (String(status).toUpperCase() === 'PASS' ? 'badge--pass' : 'badge--fail');
    }

    function buildReq() {
        return {
            clientId: st.clientId,
            runId: st.runId,
            valpacTable: gv('r53ValpacTable') || 'dbo_CRSE',
            valpacSubjCol: gv('r53ValpacSubjCol') || '_030',
            prodTable: gv('r53ProdTable') || 'MT-audit-prod-CRSE',
            prodSubjCol: gv('r53ProdSubjCol') || 'IALSUBJ'
        };
    }

    function updateButtons() {
        var engRole = (st.currentUserEngagementRole || ROLE || '').toLowerCase();
        var systemRole = (ROLE || '').toLowerCase();
        var canEdit = !IS_RESULTS_ONLY && (systemRole === 'dataanalyst' || engRole === 'dataanalyst');
        var canSign = !!st.runId && !!st.isWorkspaceSaved &&
            (engRole === 'dataanalyst' || (st.resultsVisible && (engRole === 'manager' || engRole === 'director')));
        var signed = !!st.currentUserHasSignedOff;

        var saveBtn = g('r53SaveBtn');
        if (saveBtn) saveBtn.disabled = signed || !canEdit || !st.runId;

        var signBtn = g('r53SignoffBtn');
        if (signBtn) {
            signBtn.disabled = signed || !canSign;
            signBtn.textContent = signed ? 'Signed Off' : 'Sign Off';
        }

        show('r53RemoveSignoffBtn', signed);

        var excelBtn = g('r53DlExcelBtn');
        if (excelBtn) excelBtn.disabled = !st.runId;

        var csvBtn = g('r53DlCsvBtn');
        if (csvBtn) csvBtn.disabled = !st.runId;

        var sqlBtn = g('r53DlSqlBtn');
        if (sqlBtn) sqlBtn.disabled = !st.runId;
        window.ruleWorkspaceUi?.setReadonlyShell('app', signed);
        window.ruleWorkspaceUi?.setFormSectionReadonly('.accordion-stack', signed);
        window.ruleWorkspaceUi?.setButtonGroupReadonly(['.workspace-signoff-actions', '.action-bar'], signed, {
            allow: ['#r53RemoveSignoffBtn', '#r53DlExcelBtn', '#r53DlCsvBtn', '#r53DlSqlBtn']
        });
    }

    function applyWsMeta(ws) {
        st.isWorkspaceSaved = !!ws.isWorkspaceSaved;
        st.currentUserHasSignedOff = !!ws.currentUserHasSignedOff;
        st.currentUserEngagementRole = ws.currentUserEngagementRole || st.currentUserEngagementRole;

        var runState = g('r53RunState');
        if (runState) runState.textContent = ws.runId ? 'Run #' + ws.runId : 'No saved run loaded';

        var runLabel = g('r53RunLabel');
        if (runLabel) runLabel.textContent = ws.runId ? 'Rule 53 Run #' + ws.runId : 'No saved run yet';

        var statusLabel = g('r53StatusLabel');
        if (statusLabel) statusLabel.textContent = ws.currentStatus || '-';

        var editedLabel = g('r53EditedLabel');
        if (editedLabel) editedLabel.textContent = ws.lastEditedAt ? new Date(ws.lastEditedAt).toLocaleString() : '-';

        var roleLabel = g('r53RoleLabel');
        if (roleLabel) roleLabel.textContent = ws.currentUserEngagementRole || ROLE || '-';

        var comment = g('r53SignoffComment');
        if (comment) comment.value = ws.currentUserSignoffComment || '';

        updateButtons();
    }

    function renderRule53Analysis(summary) {
        var pane = g('r53AnalysisPane');
        if (!pane) return;
        if (!summary) {
            pane.innerHTML = '<div class="empty-state"><p>Run Rule 53 to see results here.</p></div>';
            return;
        }

        var statusClass = String(summary.status || '').toUpperCase() === 'PASS' ? 'badge--pass' : 'badge--fail';
        var previewHtml = summary.warning
            ? '<div class="alert alert--warning" style="margin-bottom:12px">' + esc(summary.warning) + '</div>'
            : '';
        var controlSummary = (summary.controlSummaries || [])[0] || null;
        var controlHtml = controlSummary
            ? '<div class="card" style="padding:14px;margin-bottom:10px">' +
                '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">' +
                '<strong style="font-size:.88rem">' + esc(controlSummary.controlLabel) + '</strong>' +
                '<span class="badge ' + (String(controlSummary.status || '').toUpperCase() === 'PASS' ? 'badge--pass' : 'badge--fail') + '">' + esc(controlSummary.status) + '</span>' +
                '</div>' +
                '<div style="font-size:.8rem;color:#666;margin-bottom:4px">' + esc(controlSummary.criteriaText) + '</div>' +
                '<div style="display:flex;gap:16px;font-size:.82rem;flex-wrap:wrap">' +
                '<span>Total: <strong>' + fmt(controlSummary.totalCount) + '</strong></span>' +
                '<span style="color:#1E8449">Pass: <strong>' + fmt(controlSummary.passCount) + '</strong></span>' +
                '<span style="color:#C0392B">Fail: <strong>' + fmt(controlSummary.failCount) + '</strong></span>' +
                '<span>Exception Rate: <strong>' + Number(controlSummary.exceptionRate || 0).toFixed(2) + '%</strong></span>' +
                '</div>' +
              '</div>'
            : '';

        pane.innerHTML =
            previewHtml +
            '<div class="stats-grid" style="margin-bottom:16px">' +
                statCard('VALPAC Population', fmt(summary.valpacRecordCount || 0), '') +
                statCard('PROD Population', fmt(summary.prodRecordCount || 0), '') +
                statCard('Total Tested', fmt(summary.totalValidated || 0), '') +
                statCard('Pass', fmt(summary.passCount || 0), 'pass') +
                statCard('Fail', fmt(summary.failCount || 0), (summary.failCount || 0) > 0 ? 'fail' : '') +
                statCard('Exception Rate', Number(summary.exceptionRate || 0).toFixed(2) + '%', (summary.exceptionRate || 0) > 0 ? 'fail' : 'pass') +
                statCard('Overall', '<span class="badge ' + statusClass + '">' + esc(summary.status) + '</span>', '') +
            '</div>' +
            '<div class="card" style="padding:12px;margin-bottom:16px">' +
                '<div class="form-grid">' +
                    '<div><div class="stat-label">dbo_CRSE Table</div><div>' + esc(summary.valpacTable || '') + '</div></div>' +
                    '<div><div class="stat-label">Subject Code Column</div><div>' + esc(summary.valpacTable || '') + '.' + esc(summary.valpacSubjCol || '_030') + '</div></div>' +
                    '<div><div class="stat-label">MT-audit-prod-CRSE Table</div><div>' + esc(summary.prodTable || '') + ' (' + esc(summary.prodSubjCol || 'IALSUBJ') + ')</div></div>' +
                    '<div><div class="stat-label">Timestamp</div><div>' + esc(summary.timestamp || '') + '</div></div>' +
                '</div>' +
            '</div>' +
            controlHtml;
    }

    function renderRule53Results() {
        var pane = g('r53ResultsPane');
        if (!pane) return;
        if (!st.summary) {
            pane.innerHTML = '<div class="empty-state"><p>Run validation first.</p></div>';
            return;
        }

        var rows = st.summary.validationRows || [];
        var filtered = st.filterResult === 'ALL'
            ? rows
            : rows.filter(function(row) { return String(row.validationResult || '').toUpperCase() === st.filterResult; });

        if (!filtered.length) {
            pane.innerHTML = '<div class="empty-state"><p>No rows match the selected filter.</p></div>';
            return;
        }

        var body = filtered.map(function(row) {
            var isPass = String(row.validationResult || '').toUpperCase() === 'PASS';
            var rowClass = isPass ? 'pass-row' : 'fail-row';
            var badge = isPass
                ? '<span class="r53-pass">&#10003; PASS</span>'
                : '<span class="r53-fail">&#10007; FAIL</span>';
            return '<tr class="' + rowClass + '">' +
                '<td>' + esc(row.valpacSubj) + '</td>' +
                '<td>' + esc(row.prodSubj) + '</td>' +
                '<td>' + badge + '</td>' +
                '<td style="font-size:.75rem">' + esc(row.resultDetail) + '</td>' +
            '</tr>';
        }).join('');

        pane.innerHTML =
            '<div style="overflow-x:auto">' +
                '<table class="r53-tbl">' +
                    '<thead><tr>' +
                        '<th>dbo_CRSE Code</th>' +
                        '<th>MT-audit-prod-CRSE Code</th>' +
                        '<th>Result</th>' +
                        '<th>Detail</th>' +
                    '</tr></thead>' +
                    '<tbody>' + body + '</tbody>' +
                '</table>' +
                '<p style="font-size:.78rem;color:#777;padding:4px 0">Showing ' + fmt(filtered.length) + ' row(s) from ' + fmt(st.summary.totalValidated || rows.length) + ' total validated row(s).</p>' +
            '</div>';
    }

    function statCard(label, value, modifier) {
        var className = modifier === 'pass'
            ? ' stat-card--pass'
            : modifier === 'fail'
                ? ' stat-card--fail'
                : '';
        return '<div class="stat-card' + className + '"><div class="stat-card__label">' + label + '</div><div class="stat-card__value">' + value + '</div></div>';
    }

    function applySummary(summary, options) {
        options = options || {};
        st.summary = summary || null;
        if (summary && !options.fromWorkspace) {
            st.runId = summary.savedRunId || st.runId;
        }

        setStatusBadge(summary ? summary.status : '');
        renderRule53Analysis(summary);
        renderRule53Results();

        if (summary) {
            st.resultsVisible = true;
            var runState = g('r53RunState');
            if (runState) runState.textContent = st.runId ? 'Run #' + st.runId : 'No saved run loaded';
        }

        updateButtons();
    }

    async function loadTables(options) {
        options = options || {};
        if (!st.clientId) return;
        var data = await post(API + '/GetTables', { clientId: st.clientId });
        if (!data.success) {
            var alertEl = g('r53DatasetStatusAlert');
            if (alertEl) { alertEl.className = 'alert alert--error'; alertEl.textContent = data.error || 'Failed to load tables.'; }
            setStatusOutput('r53CfgOut', data.error || 'Failed to load tables.', 'error');
            return;
        }
        var tables = data.tables || [];
        fillSelect('r53ValpacTable', tables, options.preferredValpacTable || data.autoValpacTable);
        fillSelect('r53ProdTable', tables, options.preferredProdTable || data.autoProdTable);
        show('body-r53-cfg', true);
        var alertEl2 = g('r53DatasetStatusAlert');
        if (alertEl2) { alertEl2.className = 'alert alert--success'; alertEl2.textContent = 'Loaded ' + tables.length + " table(s) from this engagement's dataset."; }
        setStatusOutput('r53CfgOut', 'Loaded ' + tables.length + ' table(s). Detecting columns...', 'success');
        await Promise.all([
            loadColumnsForTable(gv('r53ValpacTable'), [
                { selectEl: 'r53ValpacSubjCol', role: 'valpac_subj', preferred: options.preferredValpacSubjCol }
            ]),
            loadColumnsForTable(gv('r53ProdTable'), [
                { selectEl: 'r53ProdSubjCol', role: 'prod_subj', preferred: options.preferredProdSubjCol }
            ])
        ]);
        if (!options.silent) setStatusOutput('r53CfgOut', 'Column mapping detected from selected tables.', 'success');
    }

    async function loadColumnsForTable(tableName, groups) {
        if (!tableName || !st.clientId) return;
        for (var i = 0; i < groups.length; i++) {
            var group = groups[i];
            try {
                var data = await post(API + '/GetColumns', { clientId: st.clientId, tableName: tableName, tableRole: group.role });
                if (!data.success || !Array.isArray(data.columns)) continue;
                fillColumnSelect(group.selectEl, data.columns, group.preferred, data.autoSelected);
            } catch (e) {}
        }
    }

    window.r53LoadTables = function() { loadTables().catch(function(e) { setStatusOutput('r53CfgOut', e.message, 'error'); }); };

    window.r53LoadCols = function(role, tableName) {
        var map = {
            valpac: [
                { selectEl: 'r53ValpacSubjCol', role: 'valpac_subj' }
            ],
            prod: [
                { selectEl: 'r53ProdSubjCol', role: 'prod_subj' }
            ]
        };
        loadColumnsForTable(tableName, map[role] || []);
    };

    window.r53Verify = function() {
        spin('Verifying tables...');
        post(API + '/VerifyTables', buildReq())
            .then(function(data) {
                unspin();
                if (!data.success) {
                    setStatusOutput('r53CfgOut', data.error || 'Verification failed.', 'error');
                    return;
                }
                setStatusOutput(
                    'r53CfgOut',
                    'dbo_CRSE: ' + fmt(data.valpacRecordCount) + ' rows | MT-audit-prod-CRSE: ' + fmt(data.prodRecordCount) + ' rows',
                    'success');
            })
            .catch(function(error) {
                unspin();
                setStatusOutput('r53CfgOut', error.message, 'error');
            });
    };

    window.r53Run = async function() {
        if (!st.clientId) {
            setWorkspaceMessage('Select an engagement before running Rule 53.', 'warning');
            return;
        }

        try {
            spin('Running Rule 53...');
            var data = await post(API + '/RunValidation', buildReq());
            unspin();
            if (!data.success) {
                setWorkspaceMessage(data.error || 'Rule 53 failed.', 'error');
                return;
            }
            st.runId = data.savedRunId || st.runId;
            st.currentUserHasSignedOff = false;
            st.isWorkspaceSaved = false;
            st.resultsVisible = true;
            applySummary(data);
            setWorkspaceMessage(
                'Rule 53 complete. Total: ' + fmt(data.totalValidated) + ' | Pass: ' + fmt(data.passCount) + ' | Fail: ' + fmt(data.failCount) + ' | Status: ' + data.status,
                String(data.status || '').toUpperCase() === 'PASS' ? 'success' : 'warning');
        } catch(error) {
            unspin();
            setWorkspaceMessage(error.message, 'error');
        }
    };

    window.r53GenSql = function() {
        spin('Generating SQL...');
        post(API + '/GenerateSql', buildReq())
            .then(function(data) {
                unspin();
                if (!data.success) {
                    setWorkspaceMessage(data.error || 'SQL generation failed.', 'error');
                    return;
                }
                g('r53SqlText').value = data.sql || '';
                r53Tab('r53-sql');
            })
            .catch(function(error) {
                unspin();
                setWorkspaceMessage(error.message, 'error');
            });
    };

    window.r53SaveWorkspace = function() {
        spin('Saving workspace...');
        post(API + '/SaveWorkspace', buildReq())
            .then(function(data) {
                unspin();
                if (!data.success) {
                    setWorkspaceMessage(data.error || 'Workspace save failed.', 'error');
                    return;
                }
                if (data.workspace) applyWsMeta(data.workspace);
                setWorkspaceMessage(data.message || 'Workspace saved.', data.signoffsCleared ? 'warning' : 'success');
            })
            .catch(function(error) {
                unspin();
                setWorkspaceMessage(error.message, 'error');
            });
    };

    window.r53SignOff = function() {
        spin('Saving signoff...');
        post(API + '/SignOffWorkspace', {
            clientId: st.clientId,
            runId: st.runId,
            comment: gv('r53SignoffComment')
        }).then(function(data) {
            unspin();
            if (!data.success) {
                setWorkspaceMessage(data.error || 'Signoff failed.', 'error');
                return;
            }
            st.currentUserHasSignedOff = true;
            if (data.workspace) applyWsMeta(data.workspace);
            setWorkspaceMessage(data.message || 'Signoff saved.', 'success');
            updateButtons();
        }).catch(function(error) {
            unspin();
            setWorkspaceMessage(error.message, 'error');
        });
    };

    window.r53RemoveSignoff = function() {
        spin('Removing signoff...');
        post(API + '/RemoveWorkspaceSignoff', {
            clientId: st.clientId,
            runId: st.runId,
            comment: ''
        }).then(function(data) {
            unspin();
            if (!data.success) {
                setWorkspaceMessage(data.error || 'Signoff removal failed.', 'error');
                return;
            }
            st.currentUserHasSignedOff = false;
            if (data.workspace) applyWsMeta(data.workspace);
            setWorkspaceMessage(data.message || 'Signoff removed.', 'warning');
            updateButtons();
        }).catch(function(error) {
            unspin();
            setWorkspaceMessage(error.message, 'error');
        });
    };

    window.r53SetFilter = function(button) {
        document.querySelectorAll('.r53-filter-btn').forEach(function(item) {
            item.classList.remove('active');
        });
        button.classList.add('active');
        st.filterResult = String(button.dataset.filter || 'ALL').toUpperCase();
        renderRule53Results();
    };

    window.r53DlCsv = async function() {
        if (!st.runId) return;
        await window.downloadFileWithProgress({
            url: API + '/DownloadCsv?runId=' + st.runId,
            method: 'GET',
            defaultFileName: 'Rule53_CRSE_Production_Run_' + st.runId + '.csv',
            label: 'Downloading CSV'
        });
    };

    window.r53DlExcel = async function() {
        if (!st.runId) return;
        await window.downloadFileWithProgress({
            url: API + '/DownloadExcel?runId=' + st.runId,
            method: 'GET',
            defaultFileName: 'Rule53_CRSE_Production_Run_' + st.runId + '.xlsx',
            label: 'Downloading Excel'
        });
    };

    window.r53DlSql = async function() {
        if (!st.runId) return;
        await window.downloadFileWithProgress({
            url: API + '/DownloadSql?runId=' + st.runId,
            method: 'GET',
            defaultFileName: 'Rule53_CRSE_Production_Run_' + st.runId + '.sql',
            label: 'Downloading SQL'
        });
    };

    function applyWorkspace(ws, resultsVisible) {
        var datasetsLinkEl = g('r53DatasetsLink');
        if (datasetsLinkEl) datasetsLinkEl.href = st.clientId ? '/EngagementDatasets?clientId=' + st.clientId : '#';

        if (!ws) {
            st.runId = null;
            st.summary = null;
            st.isWorkspaceSaved = false;
            st.currentUserHasSignedOff = false;
            st.resultsVisible = false;
            st.currentUserEngagementRole = '';
            setWorkspaceMessage('No saved Rule 53 workspace for this engagement yet.', 'info');
            var runState = g('r53RunState');
            if (runState) runState.textContent = 'No saved run loaded';
            var runLabel = g('r53RunLabel');
            if (runLabel) runLabel.textContent = 'No saved run yet';
            var statusLabel = g('r53StatusLabel');
            if (statusLabel) statusLabel.textContent = '-';
            var editedLabel = g('r53EditedLabel');
            if (editedLabel) editedLabel.textContent = '-';
            applySummary(null);
            if (!IS_RESULTS_ONLY) loadTables().catch(function() {});
            return;
        }

        st.runId = ws.runId || null;
        st.resultsVisible = !!resultsVisible;
        st.currentUserEngagementRole = ws.currentUserEngagementRole || '';

        if (!IS_RESULTS_ONLY) {
            loadTables({
                preferredValpacTable: ws.valpacTable,
                preferredProdTable: ws.prodTable,
                preferredValpacSubjCol: ws.valpacSubjCol,
                preferredProdSubjCol: ws.prodSubjCol,
                silent: true
            }).catch(function() {});
        }

        applyWsMeta(ws);

        if (!resultsVisible) {
            setWorkspaceMessage('Saved Rule 53 results are not available for your role.', 'info');
            applySummary(null);
            return;
        }

        setWorkspaceMessage(ws.summary ? 'Saved Rule 53 workspace loaded.' : 'Rule 53 workspace loaded. Run validation to generate results.', 'success');
        applySummary(ws.summary || null, { fromWorkspace: true });
    }

    function loadWorkspace() {
        if (!st.clientId) {
            applyWorkspace(null, false);
            return Promise.resolve();
        }

        setWorkspaceMessage('Loading saved workspace...', 'info');
        var fetcher = window.fetchJsonWithProgress || function(url, options) {
            return fetch(url, options).then(function(response) { return response.json(); });
        };

        return fetcher(API + '/GetWorkspaceState?clientId=' + st.clientId, { method: 'GET' })
            .then(function(data) {
                if (!data.success) throw new Error(data.error || 'Failed to load workspace.');
                applyWorkspace(data.workspace, data.resultsVisible);
            });
    }

    window.r53OnClientChange = function(value) {
        st.clientId = parseInt(value, 10) || 0;
        if (!st.clientId) {
            applyWorkspace(null, false);
            return;
        }
        loadWorkspace().catch(function(error) {
            setWorkspaceMessage(error.message, 'error');
        });
    };

    renderRule53Analysis(null);
    renderRule53Results();
    updateButtons();

    if (st.clientId) {
        loadWorkspace().catch(function(error) {
            setWorkspaceMessage(error.message, 'error');
        });
    }
        const __ruleRApiBase = typeof apiBasePath !== 'undefined'
        ? apiBasePath
        : (typeof apiBase !== 'undefined'
            ? apiBase
            : (typeof API !== 'undefined'
                ? API
                : ((window.location.pathname.match(/^\/Rule\d+/i) || [null])[0])));
    const __ruleRRequestBuilder = typeof getRequest === 'function' ? getRequest : (typeof buildRequest === 'function' ? buildRequest : (typeof buildReq === 'function' ? buildReq : null));
    const __ruleRPost = typeof postJson === 'function' ? postJson : (typeof post === 'function' ? post : null);
    if (__ruleRApiBase && __ruleRRequestBuilder && __ruleRPost && window.ruleRScriptUi) {
        window.ruleRScriptUi.install({
            apiBase: __ruleRApiBase,
            requestBuilder: __ruleRRequestBuilder,
            postJson: __ruleRPost,
            showSpinner: typeof showSpinner === 'function' ? showSpinner : (typeof spin === 'function' ? spin : null),
            hideSpinner: typeof hideSpinner === 'function' ? hideSpinner : (typeof unspin === 'function' ? unspin : null)
        });
    }
})();
</script>

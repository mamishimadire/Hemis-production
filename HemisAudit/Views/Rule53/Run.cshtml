@model HemisAudit.ViewModels.Rule53RunReviewViewModel
@{
    ViewData["Title"] = $"Rule 53 Run {Model.RunId}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canDownload = ViewBag.CanDownloadSavedRun is bool d && d;
    var canOpenWorkspace = ViewBag.CanOpenWorkspace is bool o && o;
    var isArchived = ViewBag.IsArchived is bool a && a;
    var moduleNavigation = ViewBag.ModuleNavigation as HemisAudit.ViewModels.ModuleSequenceNavigationViewModel;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert--success" style="margin-bottom:16px">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert--error" style="margin-bottom:16px">@TempData["Error"]</div>
}

@if (moduleNavigation != null)
{
    @await Html.PartialAsync("_ModuleSequenceNav", moduleNavigation)
}

<div class="page-header">
    <div>
        <h1>Rule 53 — Saved Run #@Model.RunId</h1>
        <p>@Model.EngagementName &nbsp;|&nbsp; @Model.MaconomyNumber</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        @if (canOpenWorkspace)
        {
            <a href="/Rule53?clientId=@Model.ClientId" class="btn btn-secondary">Open Workspace</a>
        }
        @if (canDownload)
        {
            <a href="/Rule53/DownloadSavedExcel?runId=@Model.RunId" class="btn btn-info">Download Excel</a>
            <a href="/Rule53/DownloadSavedCsv?runId=@Model.RunId" class="btn btn-info">Download CSV</a>
            <a href="/Rule53/DownloadSavedSql?runId=@Model.RunId" class="btn btn-secondary">Download SQL</a>
        }
    </div>
</div>

<div class="card" style="padding:20px;margin-bottom:20px">
    <h3 class="section-title" style="margin-top:0">Run Summary</h3>
    <div class="form-grid">
        <div><div style="color:var(--text-muted);font-size:12px;text-transform:uppercase;font-weight:700">Source Table (dbo_CRSE)</div><div>@Model.Summary.ValpacTable</div></div>
        <div><div style="color:var(--text-muted);font-size:12px;text-transform:uppercase;font-weight:700">Target Table (MT-audit-prod-CRSE)</div><div>@Model.Summary.ProdTable</div></div>
        <div><div style="color:var(--text-muted);font-size:12px;text-transform:uppercase;font-weight:700">Column Mapping</div><div style="font-size:12px">@Model.Summary.TableLinkageText</div></div>
        <div><div style="color:var(--text-muted);font-size:12px;text-transform:uppercase;font-weight:700">Timestamp</div><div>@Model.Summary.Timestamp</div></div>
        <div><div style="color:var(--text-muted);font-size:12px;text-transform:uppercase;font-weight:700">Status</div><div><span class="badge @(Model.Summary.Status == "PASS" ? "badge--pass" : "badge--fail")">@Model.Summary.Status</span></div></div>
    </div>
    <div class="stats-grid" style="margin-top:16px">
        <div class="stat-card"><div class="stat-card__label">dbo_CRSE Records</div><div class="stat-card__value">@Model.Summary.ValpacRecordCount.ToString("N0")</div></div>
        <div class="stat-card"><div class="stat-card__label">MT-audit-prod-CRSE Records</div><div class="stat-card__value">@Model.Summary.ProdRecordCount.ToString("N0")</div></div>
        <div class="stat-card"><div class="stat-card__label">Total Tested</div><div class="stat-card__value">@Model.Summary.TotalValidated.ToString("N0")</div></div>
        <div class="stat-card stat-card--pass"><div class="stat-card__label">Found in PRODUCTION (PASS)</div><div class="stat-card__value">@Model.Summary.PassCount.ToString("N0")</div></div>
        <div class="stat-card stat-card--fail"><div class="stat-card__label">Missing from PRODUCTION (FAIL)</div><div class="stat-card__value">@Model.Summary.FailCount.ToString("N0")</div></div>
    </div>
</div>

@if (Model.Signoffs.Any())
{
    <div class="card" style="padding:20px;margin-bottom:20px">
        <h3 class="section-title" style="margin-top:0">Signoffs</h3>
        <table class="data-table">
            <thead><tr><th>Role</th><th>Reviewer</th><th>Signed Off At</th><th>Comment</th></tr></thead>
            <tbody>
                @foreach (var s in Model.Signoffs)
                {
                    <tr>
                        <td>@s.SignoffRole</td>
                        <td>@s.ReviewerName</td>
                        <td>@s.SignedOffAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@s.Comment</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!isArchived && Model.CanCurrentUserSignOff && !Model.CurrentUserHasSignedOff && Model.IsCurrentRun)
        {
            <form method="post" action="/Rule53/AddSignoff" style="margin-top:16px">
                @Html.AntiForgeryToken()
                <input type="hidden" name="runId" value="@Model.RunId" />
                <div class="field-group"><label>Signoff Comment</label><textarea name="comment" rows="3" placeholder="Add review notes"></textarea></div>
                <button type="submit" class="btn btn-primary">Sign Off</button>
            </form>
        }
        @if (!isArchived && Model.CanCurrentUserRemoveSignoff && Model.IsCurrentRun)
        {
            <form method="post" action="/Rule53/RemoveSignoff" style="margin-top:8px">
                @Html.AntiForgeryToken()
                <input type="hidden" name="runId" value="@Model.RunId" />
                <button type="submit" class="btn btn-warning" onclick="return confirm('Remove your signoff?')">Remove Signoff</button>
            </form>
        }
    </div>
}

<div class="card" style="padding:20px">
    <h3 class="section-title" style="margin-top:0">Result Rows</h3>
    @if (Model.Summary.TotalValidated > Model.Summary.ValidationRows.Count)
    {
        <div class="alert alert--warning" style="margin-bottom:12px">@Model.Summary.TotalValidated.ToString("N0") rows were found; only the first @Model.Summary.ValidationRows.Count.ToString("N0") are stored and shown here. All totals above are exact.</div>
    }
    <div class="table-wrapper" style="overflow-x:auto">
        <table class="data-table" style="min-width:500px;font-size:12px;font-family:Consolas,monospace">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@Model.Summary.ValpacSubjCol (dbo_CRSE)</th>
                    <th>@Model.Summary.ProdSubjCol (MT-audit-prod-CRSE)</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Summary.ValidationRows)
                {
                    <tr style="background:@(row.ValidationResult == "FAIL" ? "#FFF3F3" : "#F3FFF3")">
                        <td>@row.RowNumber</td>
                        <td>@row.ValpacSubj</td>
                        <td>@row.ProdSubj</td>
                        <td><span class="badge @(row.ValidationResult == "FAIL" ? "badge--fail" : "badge--pass")">@row.ValidationResult</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.GeneratedSql))
{
    <div class="card" style="padding:20px;margin-top:20px">
        <h3 class="section-title" style="margin-top:0">SQL Script</h3>
        <pre style="overflow-x:auto;font-size:12px;background:var(--code-bg,#1e1e1e);color:var(--code-text,#d4d4d4);padding:16px;border-radius:8px">@Model.GeneratedSql</pre>
    </div>
}
